#!/usr/bin/env bash
# Perl programs are single quoted to keep their sigils from the shell.
# shellcheck disable=SC2016

set -euo pipefail

top=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
release="$top/util/release"
perl=${PERL:?PERL is required}
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT

current=$(
  "$perl" -ne '
    if (/^YSD-VERSION := ([0-9]+\.[0-9]+\.)([0-9]+)$/) {
      print "$1", $2 + 1, "\n";
      exit;
    }
  ' "$top/Makefile"
)
version=$current
repo="$temporary/repo"
origin="$temporary/origin.git"
fake_bin="$temporary/bin"
make_log="$temporary/make.log"
gh_log="$temporary/gh.log"

mkdir -p "$repo/lib/ysd" "$repo/man/man1" "$repo/util" "$fake_bin"
cp "$top/Changes" "$top/Makefile" "$repo/"
cp "$top/lib/ysd/core.ys" "$repo/lib/ysd/"
cp "$release" "$repo/util/"
printf 'stale manual\n' > "$repo/man/man1/ysd.1"
git init --quiet --initial-branch=main "$repo"
git -C "$repo" config user.name 'Release Test'
git -C "$repo" config user.email release-test@example.com
git -C "$repo" add -A
git -C "$repo" commit --quiet \
  -m 'Create release test fixture' \
  -m 'Create the isolated repository used by release workflow tests.'
git init --quiet --bare "$origin"
git -C "$repo" remote add origin "$origin"
git -C "$repo" push --quiet --set-upstream origin main
remote_before=$(git -C "$repo" rev-parse origin/main)

printf 'local main release candidate\n' > "$repo/local-change"
git -C "$repo" add local-change
git -C "$repo" commit --quiet \
  -m 'Add local release candidate' \
  -m 'Exercise release preparation from a local commit ahead of origin.'

printf '%s\n' \
  '#!/usr/bin/env bash' \
  'printf "%s\n" "$*" >> "$MAKE_LOG"' \
  'if [[ ${1-} == update ]]; then' \
  "  printf 'generated manual\\n' > man/man1/ysd.1" \
  '  exit 0' \
  'fi' \
  'exit 1' \
  > "$fake_bin/make"
chmod 0755 "$fake_bin/make"

run_release() {
  (
    cd "$repo"
    PATH="$fake_bin:$PATH" \
      PERL="$perl" \
      MAKE_LOG="$make_log" \
      GH_LOG="$gh_log" \
      GH="$fake_bin/gh" \
      RELEASE_BRANCH="${TEST_RELEASE_BRANCH:-main}" \
      "$release" release "$version"
  )
}

expect_failure() {
  local name=$1
  shift
  if "$@" >/dev/null 2>&1; then
    echo "expected failure: $name" >&2
    exit 1
  fi
}

expect_failure invalid-version \
  env PERL="$perl" "$release" release invalid
expect_failure validation-stop run_release

expected=$(printf '%s\n' update test)
[[ $(< "$make_log") == "$expected" ]]
[[ $(git --git-dir="$origin" rev-parse refs/heads/main) == \
   "$remote_before" ]]
[[ $(git -C "$repo" log -1 --format=%s) == \
   "Prepare release $version" ]]
grep -Fqx "YSD-VERSION := $version" "$repo/Makefile"
grep -Fqx "VERSION =: '$version'" "$repo/lib/ysd/core.ys"
grep -Fqx -- "- version: $version" "$repo/Changes"

changed=$(
  git -C "$repo" diff-tree --no-commit-id --name-only -r HEAD | sort
)
expected=$(printf '%s\n' \
  Changes Makefile lib/ysd/core.ys man/man1/ysd.1 | sort)
[[ $changed == "$expected" ]]
grep -Fqx 'generated manual' "$repo/man/man1/ysd.1"
[[ -z $(git -C "$repo" status --short) ]]
[[ -z $(git -C "$repo" tag -l) ]]

head_before=$(git -C "$repo" rev-parse HEAD)
set +e
resume_output=$(run_release 2>&1)
resume_status=$?
set -e
[[ $resume_status -ne 0 ]]
grep -Fq "Resuming release $version" <<< "$resume_output"
[[ $(git -C "$repo" rev-parse HEAD) == "$head_before" ]]

printf '%s\n' \
  '#!/usr/bin/env bash' \
  'printf "%s\n" "$*" >> "$MAKE_LOG"' \
  '[[ ${1-} != release-smoke ]] || mkdir -p .cache' \
  > "$fake_bin/make"
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'printf "%s\n" "$*" >> "$GH_LOG"' \
  '[[ $1 != release || $2 != view ]]' \
  > "$fake_bin/gh"
chmod 0755 "$fake_bin/gh"
rm -f "$make_log" "$gh_log"
git -C "$repo" branch -m install-issues

expect_failure default-release-branch run_release
TEST_RELEASE_BRANCH=install-issues run_release >/dev/null

expected=$(printf '%s\n' \
  test \
  "release-smoke VERSION=$version" \
  publish)
[[ $(< "$make_log") == "$expected" ]]
grep -Fqx "release view v$version --repo yaml/yamlschema" "$gh_log"
grep -Fq "release create v$version --repo yaml/yamlschema" "$gh_log"
[[ $(git --git-dir="$origin" rev-parse refs/heads/main) == "$head_before" ]]
[[ $(git --git-dir="$origin" rev-parse "refs/tags/v$version^{commit}") == \
   "$head_before" ]]

echo 'Release workflow checks passed'
