#!/usr/bin/env bash

set -euo pipefail

top=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
makes=$top/../makes
install_script=$top/www/docs/install
install_makefile=$top/www/docs/install.mk
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT

source_repo=$temporary/source
fake_ysd=$temporary/fake/ysd
archive=$temporary/ysd-0.1.3-linux_amd64.tar.gz
mkdir -p "$source_repo" "${fake_ysd%/*}"

git -C "$source_repo" init -q
git -C "$source_repo" config user.name 'Installer Test'
git -C "$source_repo" config user.email installer-test@example.com
printf '%s\n' 'YAMLSchema installer fixture' > "$source_repo/ReadMe.md"
git -C "$source_repo" add ReadMe.md
git -C "$source_repo" commit -q -m 'Create installer fixture'
git -C "$source_repo" tag v0.1.3

cat > "$fake_ysd" <<'SCRIPT'
#!/usr/bin/env bash
[[ ${1:-} == --version ]] || exit 1
printf '%s\n' 'ysd 0.1.3'
SCRIPT
chmod 0755 "$fake_ysd"

mkdir -p "$temporary/package/ysd-0.1.3-linux_amd64"
cp "$fake_ysd" "$temporary/package/ysd-0.1.3-linux_amd64/ysd"
tar -czf "$archive" -C "$temporary/package" \
  ysd-0.1.3-linux_amd64

prepare_prefix() {
  local prefix=$1
  mkdir -p "$prefix/share/cache"
  cp "$archive" "$prefix/share/cache/"
}

check_install() {
  local shell=$1 prefix=$temporary/prefix-${1##*/}
  local output expected
  local -a shell_options=()

  if [[ ${shell##*/} == zsh ]]; then
    shell_options=(-o noclobber)
  fi

  prepare_prefix "$prefix"
  export YAMLSCHEMA_TEST_PREFIX=$prefix
  export YAMLSCHEMA_TEST_MAKES=$makes
  export YAMLSCHEMA_TEST_REPO=$source_repo
  export YAMLSCHEMA_INSTALL_MK_URL=file://$install_makefile

  if [[ ${shell##*/} == fish ]]; then
    # shellcheck disable=SC2016
    output=$(
      "$shell" --no-config -c '
        source - \
          PREFIX="$YAMLSCHEMA_TEST_PREFIX" \
          VERSION=0.1.3 \
          MAKES_REPO_DIR="$YAMLSCHEMA_TEST_MAKES" \
          YAMLSCHEMA-REPO="$YAMLSCHEMA_TEST_REPO"
        command -v ysd
        ysd --version
      ' < "$install_script"
    )
  else
    # shellcheck disable=SC2016
    output=$(
      "$shell" "${shell_options[@]}" -c '
        source "$1" \
          PREFIX="$YAMLSCHEMA_TEST_PREFIX" \
          VERSION=0.1.3 \
          MAKES_REPO_DIR="$YAMLSCHEMA_TEST_MAKES" \
          YAMLSCHEMA-REPO="$YAMLSCHEMA_TEST_REPO"
        command -v ysd
        ysd --version
      ' "$shell" "$install_script"
    )
  fi

  expected="Installed YAMLSchema to $prefix/bin/ysd"
  grep -Fxq "$expected" <<< "$output"
  grep -Fxq "$prefix/bin/ysd" <<< "$output"
  grep -Fxq 'ysd 0.1.3' <<< "$output"
  [[ -x $prefix/bin/ysd ]]
  [[ $("$prefix/bin/ysd" --version) == 'ysd 0.1.3' ]]
  [[ -d $prefix/share/yamlschema/.git ]]
  [[ $(git -C "$prefix/share/yamlschema" describe --tags --exact-match) == \
     v0.1.3 ]]
}

check_install bash
if command -v zsh >/dev/null; then
  check_install zsh
fi
if command -v fish >/dev/null; then
  check_install fish
fi

prefix=$temporary/prefix-repeat
prepare_prefix "$prefix"
args=(
  PREFIX="$prefix"
  VERSION=0.1.3
  MAKES_REPO_DIR="$makes"
  YAMLSCHEMA-REPO="$source_repo"
)
make --no-print-directory -f "$install_makefile" install "${args[@]}" \
  >/dev/null
make --no-print-directory -f "$install_makefile" install "${args[@]}" \
  >/dev/null

printf '%s\n' changed >> "$prefix/share/yamlschema/ReadMe.md"
if make --no-print-directory -f "$install_makefile" install \
  "${args[@]}" >"$temporary/dirty.out" 2>&1; then
  echo 'installer accepted a dirty repository checkout' >&2
  exit 1
fi
grep -Fq 'repository checkout has local changes' "$temporary/dirty.out"

git -C "$prefix/share/yamlschema" checkout -q -- ReadMe.md
git -C "$prefix/share/yamlschema" remote set-url origin wrong-origin
if make --no-print-directory -f "$install_makefile" install \
  "${args[@]}" >"$temporary/origin.out" 2>&1; then
  echo 'installer accepted the wrong repository origin' >&2
  exit 1
fi
grep -Fq 'repository origin does not match' "$temporary/origin.out"

echo 'YAMLSchema installer checks passed'
