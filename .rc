# shellcheck shell=bash

# Works for Bash, Fish, and Zsh.

test -n "$BASH_VERSION" && eval '
YAMLSCHEMA_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
_yamlschema_bin_dir=$YAMLSCHEMA_ROOT/bin
_yamlschema_parent=$(dirname "$YAMLSCHEMA_ROOT")

if [[ $(basename "$_yamlschema_parent") == share ]]; then
  _yamlschema_prefix=$(dirname "$_yamlschema_parent")
  if [[ -x $_yamlschema_prefix/bin/ysd ]]; then
    _yamlschema_bin_dir=$_yamlschema_prefix/bin
  fi
fi

_yamlschema_path=$PATH:
PATH=$_yamlschema_bin_dir
while [[ $_yamlschema_path == *:* ]]; do
  _yamlschema_path_dir=${_yamlschema_path%%:*}
  _yamlschema_path=${_yamlschema_path#*:}
  if [[ $_yamlschema_path_dir != "$_yamlschema_bin_dir" ]]; then
    PATH=$PATH:$_yamlschema_path_dir
  fi
done
MANPATH=$YAMLSCHEMA_ROOT/man:$(manpath 2>/dev/null)
export YAMLSCHEMA_ROOT PATH MANPATH

source "$YAMLSCHEMA_ROOT/share/complete.bash"

unset _yamlschema_bin_dir _yamlschema_parent _yamlschema_prefix
unset _yamlschema_path _yamlschema_path_dir
return 0
'

test -n "$FISH_VERSION" && eval '
set -gx YAMLSCHEMA_ROOT (cd (dirname (status filename)); and pwd -P)
set -l yamlschema_bin_dir "$YAMLSCHEMA_ROOT/bin"
set -l yamlschema_parent (path dirname "$YAMLSCHEMA_ROOT")

if test (path basename "$yamlschema_parent") = share
  set -l yamlschema_prefix (path dirname "$yamlschema_parent")
  if test -x "$yamlschema_prefix/bin/ysd"
    set yamlschema_bin_dir "$yamlschema_prefix/bin"
  end
end

set -l yamlschema_path "$yamlschema_bin_dir"
for path_dir in $PATH
  if test "$path_dir" != "$yamlschema_bin_dir"
    set -a yamlschema_path "$path_dir"
  end
end
set -gx PATH $yamlschema_path
set -gx MANPATH "$YAMLSCHEMA_ROOT/man" (manpath 2>/dev/null)

source "$YAMLSCHEMA_ROOT/share/complete.fish"

return 0
'

test -n "$ZSH_VERSION" && eval '
YAMLSCHEMA_ROOT=$(cd "$(dirname "$0")" && pwd -P)
_yamlschema_bin_dir=$YAMLSCHEMA_ROOT/bin
_yamlschema_parent=$(dirname "$YAMLSCHEMA_ROOT")

if [[ $(basename "$_yamlschema_parent") == share ]]; then
  _yamlschema_prefix=$(dirname "$_yamlschema_parent")
  if [[ -x $_yamlschema_prefix/bin/ysd ]]; then
    _yamlschema_bin_dir=$_yamlschema_prefix/bin
  fi
fi

_yamlschema_path=$PATH:
PATH=$_yamlschema_bin_dir
while [[ $_yamlschema_path == *:* ]]; do
  _yamlschema_path_dir=${_yamlschema_path%%:*}
  _yamlschema_path=${_yamlschema_path#*:}
  if [[ $_yamlschema_path_dir != "$_yamlschema_bin_dir" ]]; then
    PATH=$PATH:$_yamlschema_path_dir
  fi
done
MANPATH=$YAMLSCHEMA_ROOT/man:$(manpath 2>/dev/null)
export YAMLSCHEMA_ROOT PATH MANPATH

source "$YAMLSCHEMA_ROOT/share/complete.zsh"

unset _yamlschema_bin_dir _yamlschema_parent _yamlschema_prefix
unset _yamlschema_path _yamlschema_path_dir
return 0
'

echo "YAMLSchema: unsupported shell '$0'" >&2
false
