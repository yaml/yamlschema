#!/usr/bin/env ys-0

# ysc - Convert JSON Schema to YAML Schema (succinct DSL).
#
# Reads a JSON Schema document from an explicit input path. Use "-" to read
# from stdin. Builds the equivalent YAML Schema as a YS data structure, dumps
# it via yaml/dump, and post-processes the result for `# TODO` comments and
# the blank line separator between `$defs` and the document body.
#
# Feature scope (v1): the 15 "direct mapping" features from the plan's
# JSON Schema Mapping table. Features requiring further design (oneOf,
# allOf, not, if/then/else, patternProperties, etc.) are emitted as a
# `# TODO: <keyword>` comment so the user can spot them.

VERSION =: '0.1.0'
JSON-SCHEMA-DIALECT =: 'https://json-schema.org/draft/2020-12/schema'
HELP =: |
  Usage: ysc (-t FORMAT | -o FILE) [INPUT]
         ysc -F, --fmt [INPUT]
         ysc -N, --norm [INPUT]

  Convert between JSON Schema and yamlschema formats.

  Arguments:
    INPUT                 Input schema path. Defaults to stdin.

  Options:
    -t, --to FORMAT       Output format. Short values: ysc, jsc, yscj.
    -o, --output FILE     Write output to FILE. Use "-" for stdout.
    -F, --fmt             Format JSON Schema to stdout.
    -N, --norm            Normalize JSON Schema to draft 2020-12 on stdout.
    -C, --compact         Emit compact JSON for schema.json output.
        --help            Show this help text.
        --version         Show version.

defn main(*args):
  handle-info-options: args
  opts =: parse-args(args)
  path =: opts.input || '-'
  text =: (path == '-').if(IN path):read
  when opts.fmt:
    format-json-schema: text opts
    exit: 0
  when opts.norm:
    normalize-json-schema-output: text opts
    exit: 0
  target =: output-format(opts)
  output =: convert-to(target text opts)
  emit-output: output opts.output

defn convert-to(target text opts):
  case target:
    'ysc.yaml':
      schema =: text:yaml/load
      validate-json-schema-dialect: schema
      convert: schema
    'schema.json':
      data =: text:yaml/load
      schema =: ysc-to-schema(data)
      json-output: schema opts
    else:
      usage: "unsupported output format: $target"

defn parse-args(args):
  state =: reduce(parse-arg-step initial-args-state() args)
  when state.expect:
    usage: "missing value for $(state.expect)"
  inputs-val =: state.inputs
  when inputs-val.# > 1:
    usage: 'expected at most one input'
  opts-val =: state.opts
  when opts-val.to.!:
    when opts-val.output.!:
      when opts-val.fmt.!:
        when opts-val.norm.!:
          usage: 'expected -t/--to, -o/--output, -F/--fmt, or -N/--norm'
  if inputs-val.# == 1:
    opts-val +: +{'input' inputs-val.0}
    else: opts-val

defn initial-args-state()::
  opts: {}
  expect:
  inputs: []

defn parse-arg-step(state arg):
  pending =: state.expect
  if pending:
    state +::
      opts:: state.opts + {pending arg}
      expect:
    handle-arg: state arg

defn handle-arg(state arg):
  cond:
    in?(arg ['-t', '--to']):
      state +:: {expect: to}
    in?(arg ['-o', '--output']):
      state +:: {expect: output}
    in?(arg ['-F', '--fmt']):
      state +: +{'opts' (state.opts + {'fmt' true, 'pretty' true})}
    in?(arg ['-N', '--norm']):
      state +: +{'opts' (state.opts + {'norm' true, 'pretty' true})}
    in?(arg ['-C', '--compact']):
      state +: +{'opts' (state.opts + {'compact' true})}
    arg =~ /^-[FCN][FCN]+$/:
      state +: +{'opts' (state.opts + short-option-bundle(arg))}
    else:
      handle-input: state arg

defn short-option-bundle(arg):
  reduce add-short-option: array-map() rest(arg)

defn add-short-option(opts ch):
  case ch:S:
    'F': opts + {'fmt' true, 'pretty' true}
    'N': opts + {'norm' true, 'pretty' true}
    'C': opts + {'compact' true}
    else: opts

defn handle-input(state arg):
  if arg =~ /^-/:
    if arg == '-':
      state +: +{'inputs' (state.inputs + arg)}
      usage: "unknown option $arg"
    state +: +{'inputs' (state.inputs + arg)}

defn output-format(opts):
  fmt =: normalize-output-format(opts.to) || infer-output-format(opts.output)
  fmt ||: 'ysc.yaml'

defn normalize-output-format(fmt):
  case fmt:
    'ysc': 'ysc.yaml'
    'jsc': 'schema.json'
    'yscj': 'ysc.json'
    else: fmt

defn infer-output-format(output):
  cond:
    output:nil?: nil
    output == '-': nil
    output =~ /\.schema\.json$/: 'schema.json'
    output =~ /\.ysc\.yaml$/: 'ysc.yaml'
    output =~ /\.ysc\.json$/: 'ysc.json'

defn emit-output(text output):
  when output.?:
    when output != '-':
      write: output "$text\n"
  when nil?(output):
    say: text
  when output == '-':
    say: text

defn usage(msg):
  err: "ysc: $msg\n"
  err: HELP
  exit: 2

defn handle-info-options(args):
  when args.# == 0:
    print: HELP
    exit: 0
  when args.# == 1:
    arg =: args.0
    when arg == '--help':
      print: HELP
      exit: 0
    when arg == '--version':
      say: "ysc $VERSION"
      exit: 0

defn json-output(value opts):
  value =: canonical-json-schema(value)
  if opts.compact:
    json/dump(value)
    pretty-json(value)

defn format-json-schema(text opts):
  schema =: text:json/load
  validate-json-schema-dialect: schema
  say: json-output(schema opts)

defn normalize-json-schema-output(text opts):
  schema =: text:json/load
  validate-json-schema-dialect: schema
  schema =: normalize-json-schema(schema true)
  say: json-output(schema opts)

defn normalize-json-schema(value root?):
  cond:
    map?(value):
      normalize-json-map: value root?
    value:vector?:
      vec: map(\(normalize-json-schema(_ false)) value)
    else:
      value

defn normalize-json-map(value root?):
  result =: array-map()
  result =: reduce(\(normalize-json-entry(_1 _2)) result value)
  result =: normalize-definitions(result)
  result =: normalize-ref(result)
  if root?:
    then:
      result +: +{'$schema' JSON-SCHEMA-DIALECT}
    else: result

defn normalize-json-entry(result entry):
  key =: entry.0
  value =: entry.1
  result +: +{key normalize-json-schema(value false)}

defn normalize-definitions(result):
  if contains?(result 'definitions'):
    then:
      defs =: (result.get('$defs') || {}) + result.get('definitions')
      result =: dissoc(result 'definitions')
      result +: +{'$defs' defs}
    else: result

defn normalize-ref(result):
  if contains?(result '$ref'):
    then:
      ref =: result.get('$ref')
      ref =: normalize-ref-value(ref)
      result +: +{'$ref' ref}
    else: result

defn normalize-ref-value(ref):
  if string?(ref):
    then: ref.replace(/^#\/definitions\// '#/\$defs/')
    else: ref

defn canonical-json-schema(value):
  cond:
    map?(value):
      canonical-json-map: value
    value:vector?:
      vec: map(canonical-json-schema value)
    else:
      value

defn canonical-json-map(value):
  result =: array-map()
  result =: reduce(\(add-canonical-key(_1 _2 value))
                   result preferred-json-schema-keys())
  extra-keys =: sort(remove(\(preferred-json-schema-key?(_)) value:keys))
  reduce \(add-canonical-key(_1 _2 value)): result extra-keys

defn add-canonical-key(result key value):
  if contains?(value key):
    result +: +{key canonical-json-schema(value.get(key))}
    else: result

defn preferred-json-schema-key?(key):
  preferred-json-schema-keys().has?(key)

defn preferred-json-schema-keys():
  keys =: '$id $schema title description type enum const default $ref'
  keys +=: ' properties required additionalProperties'
  keys +=: ' items uniqueItems minItems maxItems'
  keys +=: ' minimum maximum minLength maxLength'
  keys +=: ' minProperties maxProperties $defs'
  keys: .split(' ')

defn pretty-json(value):
  pretty-value(value 0)

defn pretty-value(value level):
  cond:
    map?(value): pretty-map(value level)
    value:vector?: pretty-array(value level)
    else: pretty-scalar(value)

defn pretty-scalar(value):
  json/dump(value).replace(/\\\// '/')

defn pretty-map(value level):
  if empty?(value):
    then: '{}'
    else:
      child =: level + 2
      entries =:
        map(\(pretty-map-entry(_ child)) value)
      body =: join(",\n" entries)
      =>: "{\n$body\n$(indent(level))}"

defn pretty-map-entry(entry level):
  key =: entry.0
  val =: entry.1
  =>: "$(indent(level))$(json/dump(key)): $(pretty-value(val level))"

defn pretty-array(value level):
  if empty?(value):
    then: '[]'
    else:
      child =: level + 2
      entries =:
        map(\("$(indent(child))$(pretty-value(_ child))") value)
      body =: join(",\n" entries)
      =>: "[\n$body\n$(indent(level))]"

defn indent(width):
  join '': repeat(width ' ')

# --------------------------------------------------------------------
# Convert yamlschema DSL data back to JSON Schema.
# --------------------------------------------------------------------

defn ysc-to-schema(doc):
  state =: reduce(ysc-doc-step initial-ysc-doc-state(doc) doc)
  result =: state.result
  defs-val =: state.defs
  reqs =: state.required
  result +=:: {type: object}
  result :if state.props:empty?.! +=: +{'properties' state.props}
  result :if reqs:empty?.! +=: +{'required' reqs}
  result :if defs-val:empty?.! +=: +{'$defs' defs-val}
  =>: result

defn initial-ysc-doc-state(doc):
  result =: add-json-meta(array-map() doc.'-json')
  =>::
    result:: result + {'$schema' JSON-SCHEMA-DIALECT}
    defs: {}
    props: {}
    required: []

defn ysc-doc-step(state entry):
  key =: entry.0:S
  value =: entry.1
  cond:
    key =~ /^\+/:
      name =: key.replace(/^\+/)
      update-state: state 'defs' name ysc-value-to-schema(value)
    key =~ /^-/:
      result =: add-schema-meta(state.result key value)
      state +: +{'result' result}
    else:
      add-property-schema: state key value

defn update-state(state slot key value):
  state +: +{slot (state.$slot + {key value})}

defn add-property-schema(state key value):
  info =: parse-property-key(key)
  schema =: ysc-value-to-schema(value)
  schema =: info.array.if(wrap-array-schema(schema info.suffix) schema)
  state =: update-state(state 'props' info.name schema)
  if info.required:
    state +: +{'required' (state.required + info.name)}
    else: state

defn add-schema-meta(result key value):
  case key:
    '-json': result.add-json-meta(value)
    '-Name': result + {'title' value}
    '-desc': result + {'description' value}
    '-additionalProperties':
      result + {'additionalProperties' additional-properties-schema(value)}
    else: result

defn add-json-meta(result value):
  if map?(value) && value.'$id':
    result +: +{'$id' value.'$id'}
    else: result

defn parse-property-key(key):
  optional-before-list =: key =~ /\?\[/
  k =: key.replace(/\?\[/ '[')
  optional-after-name =: k =~ /\?$/
  k =: k.replace(/\?$/)
  has-suffix =: k =~ /\[[^\]]*\]$/
  suffix =: has-suffix.if(k.replace(/^.*(\[[^\]]*\])$/ '$1'))
  k =: has-suffix.if(k.replace(/\[[^\]]*\]$/) k)
  required =: not(optional-before-list || optional-after-name)
  =>::
    name:: k
    required:: required
    array:: suffix.?
    suffix:: suffix

defn ysc-value-to-schema(value):
  if map?(value):
    ysc-map-to-schema: value
    ysc-scalar-to-schema: value

defn ysc-map-to-schema(value):
  explicit =: some(\(_:S =~ /^-/) value:keys)
  explicit =: value:keys.some(\(/^-/))
  if explicit:
    ysc-block-to-schema: value
    ysc-object-to-schema: value

defn ysc-object-to-schema(value):
  state =: reduce(ysc-object-step initial-object-state() value)
  reqs =: state.required
  result =: +{'type' 'object'}
  result :if reqs:empty?.! +=: +{'required' reqs}
  result +: +{'properties' state.props}

defn initial-object-state()::
  props: {}
  required: []

defn ysc-object-step(state entry):
  add-property-schema: state entry.0:S entry.1

defn ysc-block-to-schema(value):
  state =: value.reduce(ysc-block-step initial-block-state())
  result =: state.result
  has-items =: (result.type == 'array') && state.item.?
  result :if has-items +=: +{'items' state.item}
  =>: result

defn initial-block-state()::
  result: {}
  item:

defn ysc-block-step(state entry):
  result =: state.result
  key =: entry.0:S
  val =: entry.1
  case key:
    '-type':
      state +: +{'result' merge(result ysc-scalar-to-schema(val))}
    '-like':
      result +=: +{'type' 'string'}
      result +=: +{'pattern' regex-pattern(val)}
      state +: +{'result' result}
    '-enum':
      state +: +{'result' (result + {'enum' val})}
    '-init':
      state +: +{'result' (result + {'default' val})}
    '-list':
      state +: +{'result' (result + {'type' 'array'})}
    '-uniq':
      state +: +{'result' (result + {'uniqueItems' val})}
    '-Name':
      state +: +{'result' (result + {'title' val})}
    '-desc':
      state +: +{'result' (result + {'description' val})}
    '-item':
      state +: +{'item' ysc-value-to-schema(val)}
    '-size':
      state +: +{'result' add-size(result val)}
    '-additionalProperties':
      state +:
        +{'result' (result + {'additionalProperties'
                              additional-properties-schema(val)})}
    else:
      state

defn add-size(result val):
  lo =: val.0
  hi =: val.1
  t =: result.type
  case t:
    'string':
      add-bounds: result lo hi 'minLength' 'maxLength'
    'array':
      add-bounds: result lo hi 'minItems' 'maxItems'
    'object':
      add-bounds: result lo hi 'minProperties' 'maxProperties'
    else:
      add-bounds: result lo hi 'minimum' 'maximum'

defn add-bounds(result lo hi min-key max-key):
  result :if (lo != '*') +=: +{min-key lo}
  result :if (hi != '*') +=: +{max-key hi}
  =>: result

defn ysc-scalar-to-schema(value):
  s =: value:S
  cond:
    s == '+Str': +{'type' 'string'}
    s == '+Int': +{'type' 'integer'}
    s == '+Float': +{'type' 'number'}
    s == '+Bool': +{'type' 'boolean'}
    s == '+Null': +{'type' 'null'}
    s == '+Map': +{'type' 'object'}
    s == '+Any': +{}
    s =~ /^\+[A-Za-z_][A-Za-z0-9_-]*$/:
      ref-schema(s)
    s =~ /^\/.*\/$/:
      +{'type' 'string', 'pattern' regex-pattern(s)}
    s =~ /^[^|]+\|[^|]+/:
      +{'type' 'string', 'enum' split(s /\|/)}
    s =~ /^([0-9.]+|\*)-([0-9.]+|\*)$/:
      range-to-schema(s)
    else:
      +{'const' value}

defn regex-pattern(value):
  value:S
    .replace(/^\//)
    .replace(/\/$/)
    .replace(/\\\// '/')

defn ref-schema(s):
  name =: s.replace(/^\+/)
  +{} +: +{'$ref' str('#/$defs/' name)}

defn range-to-schema(s):
  lo hi =: s.split('-')
  t =: range-type(lo hi)
  result =:: {type:: t}
  result :if (lo != '*') +=: +{'minimum' scalar-number(lo)}
  result :if (hi != '*') +=: +{'maximum' scalar-number(hi)}
  =>: result

defn range-type(lo hi):
  has-dot =: (lo =~ /\./).or(hi =~ /\./)
  if has-dot: +
    'number'
    'integer'

defn scalar-number(s):
  json/load: s

defn wrap-array-schema(item suffix):
  base =::
    type: array
    items:: item
  body =: suffix.replace(/^\[/)
  body .=: replace(/\]$/)
  uniq =: body =~ /!/
  body .=: replace(/!/)
  base :if uniq +=: +{'uniqueItems' true}
  cond:
    body == '+':
      base + {'minItems' 1}
    body =~ /^[0-9]+$/:
      n =: scalar-number(body)
      base +: +{'minItems' n, 'maxItems' n}
    body =~ /^[0-9]+-$/:
      n =: scalar-number(body.replace('-'))
      base +: +{'minItems' n}
    body =~ /^[0-9]+-[0-9]+$/:
      lo hi =: body.split('-')
      base +::
        minItems:: scalar-number(lo)
        maxItems:: scalar-number(hi)
    else: base

defn convert(schema):
  doc =: build-doc(schema)
  text =: yaml/dump(doc)
  post-process: text

defn validate-json-schema-dialect(schema):
  when+ schema.'$schema':
    dialect =: _
    when supported-json-schema-dialect?(dialect).!:
      usage: "unsupported JSON Schema dialect: $dialect"

defn supported-json-schema-dialect?(dialect):
  case dialect:
    'https://json-schema.org/draft/2020-12/schema': true
    'https://json-schema.org/draft/2019-09/schema': true
    'http://json-schema.org/draft-07/schema#': true
    'https://json-schema.org/draft-07/schema': true
    'http://json-schema.org/draft-06/schema#': true
    'https://json-schema.org/draft-06/schema': true
    'http://json-schema.org/draft-04/schema#': true
    'https://json-schema.org/draft-04/schema': true
    else: false

# Build the top-level data structure for the whole document.
defn build-doc(schema):
  defs =: schema.'$defs' ||
          schema.definitions ||
          {}
  result =: omap()
    .add-root-annotations(schema)
    .add-defs(defs)
    .add-body(schema)
  add-json-schema-meta: result schema

defn add-root-annotations(result schema):
  result :if schema.title.? +=: +{'-Name' schema.title}
  result :if schema.description.? +=: +{'-desc' schema.description}
  =>: result

defn add-json-schema-meta(result schema):
  if schema.'$id':
    result +: +{'-json' json-id-meta(schema.'$id')}
    else: result

defn json-id-meta(id)::
  $id:: id

defn add-defs(result defs):
  reduce add-def-step: result defs

defn add-def-step(result entry):
  name sub =: entry
  result +: +{"+$name" build-value(sub)}

defn add-body(result schema):
  if object-with-props?(schema):
    add-properties: result schema
    add-block: result schema

defn add-properties(result schema):
  props =: schema.properties
  required =: set(schema.required)
  reduce \(add-property(_1 _2 required)): result props

defn add-property(result entry required):
  name sub =: entry
  is-req =: required.has?(name)
  array? =: json-type(sub).eq('array') && array-as-suffix?(sub)
  value-sub =: array?.if(array-item-schema(sub) sub)
  key =: key-for(name sub is-req array?)
  result +: +{key build-value(value-sub)}

# Return the value side of a property (or def) — either a scalar in
# succinct form, or a nested map (object with properties / expanded
# directive block).
defn build-value(schema):
  scalar =: succinct-scalar(schema)
  cond:
    scalar && not(schema-annotations?(schema)): scalar
    object-with-props?(schema): build-properties-map(schema)
    else: build-block-map(schema)

defn build-properties-map(schema):
  add-properties(omap() schema)

defn build-block-map(schema):
  add-block(omap() schema)

# Add the directive entries for an expanded schema-block (-type, -size,
# -enum, -init, etc.) into the result map. Also walks nested items /
# properties when present.
defn add-block(result schema):
  result .=: add-todos(schema)
  t =: json-type(schema)
  ts =: type-sym(t)
  has-type =: t.? && (t != 'array') && (t != 'object')
  is-array =: t.eq('array')
  result :if schema.'$ref'.? +=:
    +{'-type' ref-sym(schema.'$ref')}
  result :if has-type +=:
    +{'-type' ts}
  result :if is-array +=:
    +{'-list' true}
  result :if schema.pattern.? +=:
    +{'-like' regex-literal(schema.pattern)}
  result :if schema.enum.? +=:
    +{'-enum' enum-block-list(schema.enum)}
  result :if schema.const.? +=:
    +{'-type' literal-value(schema.const)}
  result :if schema.uniqueItems +=:
    +{'-uniq' true}
  result :if schema.default.? +=:
    +{'-init' literal-value(schema.default)}
  result :if schema.title.? +=:
    +{'-Name' schema.title}
  result :if schema.description.? +=:
    +{'-desc' schema.description}
  result :if contains?(schema 'additionalProperties') +=:
    +{'-additionalProperties' additional-properties-value(schema)}
  result .=: add-size-directive(schema.minimum schema.maximum)
  result .=: add-size-directive(schema.minLength schema.maxLength)
  result .=: add-size-directive(schema.minItems schema.maxItems)
  result .=:
    add-size-directive: schema.minProperties schema.maxProperties
  result .=: add-array-items(is-array schema)
  result :if ((t == 'object') && object-with-props?(schema)) =:
    result.add-properties(schema)
  =>: result

defn add-size-directive(result lo hi):
  if lo.? || hi.?:
    result +: +{'-size' size-pair(lo hi)}
    =>: result

defn add-array-items(result is-array schema):
  if is-array && schema.items.?:
    then:
      items =: schema.items
      item-scalar =: succinct-scalar(items)
      result +:
        if item-scalar: +
          {'-type' item-scalar}
          {'-item' build-block-map(items)}
    else: result

defn additional-properties-value(schema):
  value =: schema.get('additionalProperties')
  if boolean?(value):
    value
    build-value(value)

defn additional-properties-schema(value):
  if boolean?(value):
    value
    ysc-value-to-schema(value)

# Insert sentinel keys for unsupported keywords. Post-processing turns
# them into `# TODO: <keyword>` comments.
defn add-todos(result schema):
  todos =: qw(allOf anyOf oneOf not if then else dependentRequired
              dependentSchemas patternProperties propertyNames
              prefixItems contains unevaluatedItems unevaluatedProperties
              exclusiveMinimum exclusiveMaximum format)
  reduce \(add-todo(_1 _2 schema)): result todos

defn add-todo(result k schema):
  if schema.has?(k):
    (result + {"__TODO_$k" ''})
    result

# --------------------------------------------------------------------
# Succinct-form helpers (unchanged from the original by-hand emitter).
# --------------------------------------------------------------------

defn succinct-scalar(schema):
  cond:
    map?(schema).!!: nil
    schema.has?('$ref'):
      only-ref?(schema).when(ref-sym(schema.'$ref'))
    schema.has?('const'):
      only-const?(schema).when(literal-value(schema.const))
    schema.has?('enum'):
      only-enum?(schema).when(enum-pipe(schema.enum))
    schema.has?('pattern'):
      pattern-only?(schema).when(regex-literal(schema.pattern))
    numeric-range-only?(schema):
      range-scalar(schema)
    type-only?(schema):
      type-sym(schema.type)

defn key-set(schema):
  schema:keys:set

defn only-ref?(schema):
  key-set(schema) ==: \{'$ref'}

defn only-const?(schema):
  key-set(schema) ==: \{'const'}

defn only-enum?(schema):
  ks =: key-set(schema)
  just-enum =:
    ks == \{'enum'}
  enum-and-str =:
    (ks == \{'enum' 'type'}) &&
    (schema.type == 'string')
  just-enum ||: enum-and-str

defn pattern-only?(schema):
  ks =: key-set(schema)
  just-pat =:
    ks == \{'pattern'}
  pat-and-str =:
    (ks == \{'pattern' 'type'}) &&
    (schema.type == 'string')
  just-pat ||: pat-and-str

defn type-only?(schema):
  type-ks =: +['type']:set
  eq: key-set(schema) type-ks

defn numeric-range-only?(schema):
  ks =: key-set(schema)
  t =: schema.type
  allowed =: set(qw(type minimum maximum))
  has-any-bound =: ks.has?('minimum') || ks.has?('maximum')
  is-num =: t.eq('integer') || t.eq('number')
  all-allowed =: ks.every?(\(allowed.has?(_)))
  all-allowed &&: is-num && has-any-bound

defn object-with-props?(schema):
  map?(schema) &&
  schema.has?('properties')

defn schema-annotations?(schema):
  schema.has?('description') ||
  schema.has?('title')

# True when an array schema's only keys are {type, items, minItems,
# maxItems, uniqueItems} — i.e. the whole thing can be expressed as
# a `[]` key suffix plus the inner item value.
defn array-as-suffix?(schema):
  every? _ key-set(schema):
    \(_.in?(qw(type items minItems maxItems uniqueItems)))

defn array-item-schema(schema):
  schema.items || {}

defn key-for(name sub is-required array?):
  suffix =: array?.if(list-suffix(sub) '')
  opt =: is-required.if('' '?')
  str: name opt suffix

defn list-suffix(sub):
  mn =: sub.minItems
  mx =: sub.maxItems
  uq =: sub.uniqueItems.if('!' '')
  cond:
    mn:nil? && mx:nil?: "[${uq}]"
    mn == mx: "[${uq}$mn]"
    mn:nil? && mx.?: "[${uq}0-$mx]"
    mn.? && mx:nil?:
      if mn == 1: +
        "[${uq}+]"
        "[${uq}${mn}+]"
    else: "[${uq}${mn}-$mx]"

defn json-type(schema):
  t =: schema.type
  if vector?(t): t.0 t

defn type-sym(t):
  if t.?:
    case t:
      'string': '+Str'
      'integer': '+Int'
      'number': '+Float'
      'boolean': '+Bool'
      'null': '+Null'
      'object': '+Map'
      'array': '+Any'
      else: '+Any'
    else: '+Any'

defn ref-sym(ref):
  str '+': ref.split('/').$

defn range-scalar(schema):
  lo =: schema.minimum
  hi =: schema.maximum
  lo-s =: lo:nil?.if('*' lo)
  hi-s =: hi:nil?.if('*' hi)
  =>: "${lo-s}-${hi-s}"

# Return a 2-vector for the value of a `-size` directive. Unbounded
# sides become the literal string "*"; yaml/dump quotes it as needed.
defn size-pair(lo hi):
  lo-v =: lo:nil?.if('*' lo)
  hi-v =: hi:nil?.if('*' hi)
  vector: lo-v hi-v

defn regex-literal(pattern):
  esc =: pattern.replace('/' '\\/')
  =>: "/$esc/"

defn safe-pipe-token?(v):
  v =~ /^[A-Za-z0-9_][A-Za-z0-9_.-]*$/

defn enum-pipe(values):
  when values.every?(safe-pipe-token?):
    values.join('|')

defn enum-block-list(values):
  vec: values

defn literal-value(v): v

# --------------------------------------------------------------------
# Post-processing the dumped YAML.
# --------------------------------------------------------------------

defn post-process(text):
  join "\n":
    text:lines.map(replace-todo):insert-blank-after-defs

defn replace-todo(line):
  pat =: /^(\s*)__TODO_(\S+):\ ''$/
  rep =: '$1# TODO: $2'
  replace line: pat rep

# Insert one blank line between the trailing `+...` $defs entries and
# the first body entry, if any $defs were emitted.
defn insert-blank-after-defs(lines):
  first: reduce(insert-blank-step initial-insert-state() lines)

defn initial-insert-state()::
- []
- false
- false

defn insert-blank-step(state line):
  result saw-plus inserted =: state
  saw-plus ||=: line =~ /^\+/
  is-body =: line =~ /^[A-Za-z]/
  should-insert =: saw-plus && not(inserted) && is-body
  result :if should-insert =: result + ''
  result =: result + line
  inserted =: inserted || should-insert
  vector: result saw-plus inserted
