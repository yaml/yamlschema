#!/usr/bin/env ys-0

# ysc - Convert JSON Schema to YAML Schema (succinct DSL).
#
# Reads a JSON Schema document from an explicit input path. Use "-" to read
# from stdin. Builds the equivalent YAML Schema as a YS data structure, dumps
# it via yaml/dump, and post-processes the result for `# TODO` comments and
# the blank line separator between `$defs` and the document body.
#
# Feature scope (v1): the 15 "direct mapping" features from the plan's
# JSON Schema Mapping table. Features requiring further design (oneOf,
# allOf, not, if/then/else, patternProperties, etc.) are emitted as a
# `# TODO: <keyword>` comment so the user can spot them.

VERSION =: '0.1.0'
JSON-SCHEMA-DIALECT =: 'https://json-schema.org/draft/2020-12/schema'
HELP =: |
  Usage: ysc (-t FORMAT | -o FILE) INPUT

  Convert between JSON Schema and yamlschema formats.

  Arguments:
    INPUT                 Input schema path. Use "-" for stdin.

  Options:
    -t, --to FORMAT       Output format. Supports "ysc.yaml", "schema.json".
    -o, --output FILE     Write output to FILE. Use "-" for stdout.
    -P, --pretty          Pretty-print JSON output with 2-space indentation.
        --help            Show this help text.
        --version         Show version.

defn main(*args):
  handle-info-options: args
  opts =: parse-args(args)
  target =: output-format(opts)
  path =: opts.get('input')
  text =: (path == '-').if(IN path):read
  output =: convert-to(target text opts)
  emit-output: output opts.get('output')

defn convert-to(target text opts):
  cond:
    target == 'ysc.yaml':
      schema =: text:json/load
      validate-json-schema-dialect: schema
      convert: schema
    target == 'schema.json':
      data =: text:yaml/load
      schema =: ysc-to-schema(data)
      json-output: schema opts
    else:
      usage: "unsupported output format: $target"

defn parse-args(args):
  state =: reduce(parse-arg-step initial-args-state() args)
  when state.expect:
    usage: "missing value for $(state.expect)"
  inputs-val =: state.inputs
  when inputs-val.# != 1:
    usage: 'expected exactly one input'
  opts-val =: state.opts
  when nil?(opts-val.get('to')):
    when nil?(opts-val.get('output')):
      usage: 'expected -t/--to or -o/--output'
  opts-val: .assoc('input' inputs-val.0)

defn initial-args-state():
  =>: +{'opts' {}, 'expect' nil, 'inputs' []}

defn parse-arg-step(state arg):
  pending =: state.expect
  if pending:
    state: .assoc('opts' state.opts.assoc(pending arg)).assoc('expect' nil)
    handle-arg: state arg

defn handle-arg(state arg):
  cond:
    in?(arg ['-t', '--to']):
      state: .assoc('expect' 'to')
    in?(arg ['-o', '--output']):
      state: .assoc('expect' 'output')
    in?(arg ['-P', '--pretty']):
      state: .assoc('opts' state.opts.assoc('pretty' true))
    else:
      handle-input: state arg

defn handle-input(state arg):
  if arg =~ /^-/:
    if arg == '-':
      state: .assoc('inputs' add+(state.inputs arg))
      usage: "unknown option $arg"
    state: .assoc('inputs' add+(state.inputs arg))

defn output-format(opts):
  fmt =: opts.get('to') || infer-output-format(opts.get('output'))
  fmt ||: 'ysc.yaml'

defn infer-output-format(output):
  cond:
    output:nil?: nil
    output == '-': nil
    output =~ /\.schema\.json$/: 'schema.json'
    output =~ /\.ysc\.yaml$/: 'ysc.yaml'
    output =~ /\.ysc\.json$/: 'ysc.json'

defn emit-output(text output):
  when output.?:
    when output != '-':
      write: output "$text\n"
  when nil?(output):
    say: text
  when output == '-':
    say: text

defn usage(msg):
  err: "ysc: $msg\n"
  err: HELP
  exit: 2

defn handle-info-options(args):
  when args.# == 0:
    print: HELP
    exit: 0
  when args.# == 1:
    arg =: args.0
    when arg == '--help':
      print: HELP
      exit: 0
    when arg == '--version':
      say: "ysc $VERSION"
      exit: 0

defn json-output(value opts):
  if opts.get('pretty'):
    pretty-json(value)
    json/dump(value)

defn pretty-json(value):
  pretty-value(value 0)

defn pretty-value(value level):
  cond:
    map?(value): pretty-map(value level)
    value:vector?: pretty-array(value level)
    else: pretty-scalar(value)

defn pretty-scalar(value):
  replace(json/dump(value) /\\\// '/')

defn pretty-map(value level):
  if empty?(value):
    then: '{}'
    else:
      child =: level + 2
      entries =:
        map(\(pretty-map-entry(_ child)) value)
      body =: join(",\n" entries)
      =>: "{\n$body\n$(indent(level))}"

defn pretty-map-entry(entry level):
  key =: entry.0
  val =: entry.1
  =>: "$(indent(level))$(json/dump(key)): $(pretty-value(val level))"

defn pretty-array(value level):
  if empty?(value):
    then: '[]'
    else:
      child =: level + 2
      entries =:
        map(\("$(indent(child))$(pretty-value(_ child))") value)
      body =: join(",\n" entries)
      =>: "[\n$body\n$(indent(level))]"

defn indent(width):
  join '': repeat(width ' ')

# --------------------------------------------------------------------
# Convert yamlschema DSL data back to JSON Schema.
# --------------------------------------------------------------------

defn ysc-to-schema(doc):
  state =: reduce(ysc-doc-step initial-ysc-doc-state(doc) doc)
  result =: state.result
  defs-val =: state.defs
  reqs =: state.required
  result =: result.assoc('type' 'object')
  result =: result.assoc('properties' state.props)
  result =: reqs:empty?.if(result result.assoc('required' reqs))
  result =: defs-val:empty?.if(result result.assoc('$defs' defs-val))
  =>: result

defn initial-ysc-doc-state(doc):
  result =: add-json-meta(array-map() doc.'-json')
  result =: result.assoc('$schema' JSON-SCHEMA-DIALECT)
  =>: +{'result' result, 'defs' {}, 'props' {}, 'required' []}

defn ysc-doc-step(state entry):
  key =: entry.0:S
  value =: entry.1
  cond:
    key =~ /^\+/:
      name =: replace(key /^\+/ '')
      update-state: state 'defs' name ysc-value-to-schema(value)
    key =~ /^-/:
      result =: add-schema-meta(state.result key value)
      state: .assoc('result' result)
    else:
      add-property-schema: state key value

defn update-state(state slot key value):
  state: .assoc(slot state.get(slot).assoc(key value))

defn add-property-schema(state key value):
  info =: parse-property-key(key)
  schema =: ysc-value-to-schema(value)
  schema =: info.array.if(wrap-array-schema(schema info.suffix) schema)
  state =: update-state(state 'props' info.name schema)
  if info.required:
    then:
      state: .assoc('required' add+(state.required info.name))
    else:
      =>: state

defn add-schema-meta(result key value):
  cond:
    key == '-json':
      add-json-meta(result value)
    key == '-Name':
      result: .assoc('title' value)
    key == '-desc':
      result: .assoc('description' value)
    else:
      result

defn add-json-meta(result value):
  if map?(value) && value.'$id':
    then:
      result: .assoc('$id' value.'$id')
    else:
      =>: result

defn parse-property-key(key):
  optional-before-list =: key =~ /\?\[/
  k =: replace(key /\?\[/ '[')
  optional-after-name =: k =~ /\?$/
  k =: replace(k /\?$/ '')
  has-suffix =: k =~ /\[[^\]]*\]$/
  suffix =: has-suffix.if(replace(k /^.*(\[[^\]]*\])$/ '$1') nil)
  k =: has-suffix.if(replace(k /\[[^\]]*\]$/ '') k)
  required =: not(optional-before-list || optional-after-name)
  =>: +{'name' k, 'required' required, 'array' suffix.?, 'suffix' suffix}

defn ysc-value-to-schema(value):
  cond:
    map?(value): ysc-map-to-schema(value)
    else: ysc-scalar-to-schema(value)

defn ysc-map-to-schema(value):
  explicit =: some(\(_:S =~ /^-/) value:keys)
  if explicit:
    ysc-block-to-schema(value)
    ysc-object-to-schema(value)

defn ysc-object-to-schema(value):
  state =: reduce(ysc-object-step initial-object-state() value)
  reqs =: state.required
  result =: +{'type' 'object'}
  result =: reqs:empty?.if(result result.assoc('required' reqs))
  result: .assoc('properties' state.props)

defn initial-object-state():
  =>: +{'props' {}, 'required' []}

defn ysc-object-step(state entry):
  add-property-schema: state entry.0:S entry.1

defn ysc-block-to-schema(value):
  state =: reduce(ysc-block-step initial-block-state() value)
  result =: state.result
  has-items =: (result.type == 'array').and(state.item.?)
  if has-items:
    result.assoc('items' state.item)
    result

defn initial-block-state():
  result =: array-map()
  result =: result.assoc('result' array-map())
  result: .assoc('item' nil)

defn ysc-block-step(state entry):
  result =: state.result
  key =: entry.0:S
  val =: entry.1
  cond:
    key == '-type':
      state: .assoc('result' merge(result ysc-scalar-to-schema(val)))
    key == '-like':
      result =: result.assoc('type' 'string')
      state: .assoc('result' result.assoc('pattern' regex-pattern(val)))
    key == '-enum':
      state: .assoc('result' result.assoc('enum' val))
    key == '-init':
      state: .assoc('result' result.assoc('default' val))
    key == '-list':
      state: .assoc('result' result.assoc('type' 'array'))
    key == '-uniq':
      state: .assoc('result' result.assoc('uniqueItems' val))
    key == '-Name':
      state: .assoc('result' result.assoc('title' val))
    key == '-desc':
      state: .assoc('result' result.assoc('description' val))
    key == '-item':
      state: .assoc('item' ysc-value-to-schema(val))
    key == '-size':
      state: .assoc('result' add-size(result val))
    else:
      state

defn add-size(result val):
  lo =: val.0
  hi =: val.1
  t =: result.type
  cond:
    t == 'string':
      add-bounds: result lo hi 'minLength' 'maxLength'
    t == 'array':
      add-bounds: result lo hi 'minItems' 'maxItems'
    t == 'object':
      add-bounds: result lo hi 'minProperties' 'maxProperties'
    else:
      add-bounds: result lo hi 'minimum' 'maximum'

defn add-bounds(result lo hi min-key max-key):
  result =: (lo != '*').if(result.assoc(min-key lo) result)
  result =: (hi != '*').if(result.assoc(max-key hi) result)
  =>: result

defn ysc-scalar-to-schema(value):
  s =: value:S
  cond:
    s == '+Str': +{'type' 'string'}
    s == '+Int': +{'type' 'integer'}
    s == '+Float': +{'type' 'number'}
    s == '+Bool': +{'type' 'boolean'}
    s == '+Null': +{'type' 'null'}
    s == '+Map': +{'type' 'object'}
    s == '+Any': +{}
    s =~ /^\+[A-Za-z_][A-Za-z0-9_-]*$/:
      ref-schema(s)
    s =~ /^\/.*\/$/:
      +{'type' 'string', 'pattern' regex-pattern(s)}
    s =~ /^[^|]+\|[^|]+/:
      +{'enum' split(s /\|/)}
    s =~ /^([0-9.]+|\*)-([0-9.]+|\*)$/:
      range-to-schema(s)
    else:
      +{'const' value}

defn regex-pattern(value):
  s =: value:S
  s =: replace(s /^\// '')
  s =: replace(s /\/$/ '')
  replace s: /\\\// '/'

defn ref-schema(s):
  name =: replace(s /^\+/ '')
  assoc: array-map() '$ref' str('#/$defs/' name)

defn range-to-schema(s):
  parts =: s.split('-')
  lo =: parts.0
  hi =: parts.1
  t =: range-type(lo hi)
  result =: +{'type' t}
  result =: (lo != '*').if(result.assoc('minimum' scalar-number(lo)) result)
  result =: (hi != '*').if(result.assoc('maximum' scalar-number(hi)) result)
  =>: result

defn range-type(lo hi):
  has-dot =: (lo =~ /\./).or(hi =~ /\./)
  if has-dot:
    then: 'number'
    else: 'integer'

defn scalar-number(s):
  json/load: s

defn wrap-array-schema(item suffix):
  base =: +{'type' 'array', 'items' item}
  body =: replace(suffix /^\[/ '')
  body =: replace(body /\]$/ '')
  uniq =: body =~ /!/
  body =: replace(body /!/ '')
  base =: uniq.if(base.assoc('uniqueItems' true) base)
  cond:
    body == '+':
      base: .assoc('minItems' 1)
    body =~ /^[0-9]+$/:
      n =: scalar-number(body)
      base: .assoc('minItems' n).assoc('maxItems' n)
    body =~ /^[0-9]+-$/:
      n =: scalar-number(replace(body '-' ''))
      base: .assoc('minItems' n)
    body =~ /^[0-9]+-[0-9]+$/:
      parts =: body.split('-')
      base: .assoc('minItems' scalar-number(parts.0))
          .assoc('maxItems' scalar-number(parts.1))
    else:
      base

defn convert(schema):
  doc =: build-doc(schema)
  text =: yaml/dump(doc)
  post-process: text

defn validate-json-schema-dialect(schema):
  when+ schema.'$schema':
    dialect =: _
    when dialect != JSON-SCHEMA-DIALECT:
      usage: "unsupported JSON Schema dialect: $dialect"

# Build the top-level data structure for the whole document.
defn build-doc(schema):
  defs =: schema.'$defs' ||
          schema.definitions ||
          {}
  result =: array-map()
  result =: add-root-annotations(result schema)
  result =: add-defs(result defs)
  result =: add-body(result schema)
  add-json-schema-meta: result schema

defn add-root-annotations(result schema):
  result =: schema.title.?.if(result.assoc('-Name' schema.title) result)
  result =: schema.description.?.if(
    result.assoc('-desc' schema.description) result)
  =>: result

defn add-json-schema-meta(result schema):
  if schema.'$id':
    result.assoc('-json' json-id-meta(schema.'$id'))
    result

defn json-id-meta(id):
  assoc(array-map() '$id' id)

defn add-defs(result defs):
  reduce add-def-step: result defs

defn add-def-step(result entry):
  name =: entry.0
  sub =: entry.1
  result: .assoc("+$name" build-value(sub))

defn add-body(result schema):
  if object-with-props?(schema):
    add-properties(result schema)
    add-block(result schema)

defn add-properties(result schema):
  props =: schema.properties
  required =: set(schema.required)
  reduce \(add-property(_1 _2 required)): result props

defn add-property(result entry required):
  name =: entry.0
  sub =: entry.1
  is-req =: required.has?(name)
  array? =: json-type(sub).eq('array') && array-as-suffix?(sub)
  value-sub =: array?.if(array-item-schema(sub) sub)
  key =: key-for(name sub is-req array?)
  result: .assoc(key build-value(value-sub))

# Return the value side of a property (or def) — either a scalar in
# succinct form, or a nested map (object with properties / expanded
# directive block).
defn build-value(schema):
  scalar =: succinct-scalar(schema)
  cond:
    scalar && not(schema-annotations?(schema)): scalar
    object-with-props?(schema): build-properties-map(schema)
    else: build-block-map(schema)

defn build-properties-map(schema):
  add-properties(array-map() schema)

defn build-block-map(schema):
  add-block(array-map() schema)

# Add the directive entries for an expanded schema-block (-type, -size,
# -enum, -init, etc.) into the result map. Also walks nested items /
# properties when present.
defn add-block(result schema):
  result =: add-todos(result schema)
  t =: json-type(schema)
  ts =: type-sym(t)
  has-type =: t.? && (t != 'array') && (t != 'object')
  is-array =: t.eq('array')
  result =: schema.'$ref'.?.if(
    result.assoc('-type' ref-sym(schema.'$ref')) result)
  result =: has-type.if(result.assoc('-type' ts) result)
  result =: is-array.if(result.assoc('-list' true) result)
  result =: schema.pattern.?.if(
    result.assoc('-like' regex-literal(schema.pattern)) result)
  result =: schema.enum.?.if(
    result.assoc('-enum' enum-block-list(schema.enum)) result)
  result =: schema.const.?.if(
    result.assoc('-type' literal-value(schema.const)) result)
  result =: schema.uniqueItems.if(result.assoc('-uniq' true) result)
  result =: schema.default.?.if(
    result.assoc('-init' literal-value(schema.default)) result)
  result =: schema.title.?.if(result.assoc('-Name' schema.title) result)
  result =: schema.description.?.if(
    result.assoc('-desc' schema.description) result)
  result =: add-size-directive(result schema.minimum schema.maximum)
  result =: add-size-directive(result schema.minLength schema.maxLength)
  result =: add-size-directive(result schema.minItems schema.maxItems)
  result =: add-size-directive(
    result schema.minProperties schema.maxProperties)
  result =: add-array-items(result is-array schema)
  result =: ((t == 'object') && object-with-props?(schema)).if(
    add-properties(result schema) result)
  =>: result

defn add-size-directive(result lo hi):
  if lo.? || hi.?:
    result: .assoc('-size' size-pair(lo hi))
    =>: result

defn add-array-items(result is-array schema):
  if is-array && schema.items.?:
    then:
      items =: schema.items
      item-scalar =: succinct-scalar(items)
      if item-scalar:
        result: .assoc('-type' item-scalar)
        result: .assoc('-item' build-block-map(items))
    else:
      =>: result

# Insert sentinel keys for unsupported keywords. Post-processing turns
# them into `# TODO: <keyword>` comments.
defn add-todos(result schema):
  todos =: qw(allOf anyOf oneOf not if then else dependentRequired
              dependentSchemas patternProperties propertyNames
              prefixItems contains additionalProperties
              unevaluatedItems unevaluatedProperties
              exclusiveMinimum exclusiveMaximum format)
  reduce \(add-todo(_1 _2 schema)): result todos

defn add-todo(result k schema):
  if schema.has?(k):
    result.assoc("__TODO_$k" '')
    result

# --------------------------------------------------------------------
# Succinct-form helpers (unchanged from the original by-hand emitter).
# --------------------------------------------------------------------

defn succinct-scalar(schema):
  cond:
    map?(schema).!!: nil
    schema.has?('$ref'):
      only-ref?(schema).when(ref-sym(schema.'$ref'))
    schema.has?('const'):
      only-const?(schema).when(literal-value(schema.const))
    schema.has?('enum'):
      only-enum?(schema).when(enum-pipe(schema.enum))
    schema.has?('pattern'):
      pattern-only?(schema).when(regex-literal(schema.pattern))
    numeric-range-only?(schema):
      range-scalar(schema)
    type-only?(schema):
      type-sym(schema.type)

defn key-set(schema):
  schema:keys:vec:set

defn only-ref?(schema):
  ref-ks =: set(['$ref'])
  key-set(schema) ==: ref-ks

defn only-const?(schema):
  const-ks =: +['const']:set
  key-set(schema) ==: const-ks

defn only-enum?(schema):
  enum-ks =: +['enum']:set
  key-set(schema) ==: enum-ks

defn pattern-only?(schema):
  ks =: key-set(schema)
  pat-ks =: set(qw(pattern))
  pat-type-ks =: set(qw(pattern type))
  just-pat =: ks == pat-ks
  pat-and-str =:
    and:
      ks.eq(pat-type-ks)
      schema.type.eq('string')
  just-pat ||: pat-and-str

defn type-only?(schema):
  type-ks =: +['type']:set
  eq: key-set(schema) type-ks

defn numeric-range-only?(schema):
  ks =: key-set(schema)
  t =: schema.type
  allowed =: set(qw(type minimum maximum))
  has-any-bound =: ks.has?('minimum') || ks.has?('maximum')
  is-num =: t.eq('integer') || t.eq('number')
  all-allowed =: ks.every?(\(allowed.has?(_)))
  and: all-allowed is-num has-any-bound

defn object-with-props?(schema):
  map?(schema).and(schema.has?('properties'))

defn schema-annotations?(schema):
  schema.has?('description') ||
  schema.has?('title')

# True when an array schema's only keys are {type, items, minItems,
# maxItems, uniqueItems} — i.e. the whole thing can be expressed as
# a `[]` key suffix plus the inner item value.
defn array-as-suffix?(schema):
  every? \(_.in?(qw(type items minItems maxItems uniqueItems))):
    key-set(schema)

defn array-item-schema(schema):
  schema.items || {}

defn key-for(name sub is-required array?):
  suffix =: array?.if(list-suffix(sub) '')
  opt =: is-required.if('' '?')
  str: name opt suffix

defn list-suffix(sub):
  mn =: sub.minItems
  mx =: sub.maxItems
  uq =: sub.uniqueItems.if('!' '')
  cond:
    mn:nil? && mx:nil?:
      "[${uq}]"
    mn == mx: "[${uq}$mn]"
    mn:nil? && mx.?: "[${uq}0-$mx]"
    mn.? && mx:nil?:
      if mn == 1:
        then: "[${uq}+]"
        else: "[${uq}${mn}+]"
    else: "[${uq}${mn}-$mx]"

defn json-type(schema):
  t =: schema.type
  if vector?(t): first(t) t

defn type-sym(t):
  cond:
    t:nil?: '+Any'
    t == 'string': '+Str'
    t == 'integer': '+Int'
    t == 'number': '+Float'
    t == 'boolean': '+Bool'
    t == 'null': '+Null'
    t == 'object': '+Map'
    t == 'array': '+Any'
    else: '+Any'

defn ref-sym(ref):
  last-seg =: ref.split('/'):last
  =>: "+$last-seg"

defn range-scalar(schema):
  lo =: schema.minimum
  hi =: schema.maximum
  lo-s =: lo:nil?.if('*' lo)
  hi-s =: hi:nil?.if('*' hi)
  =>: "${lo-s}-${hi-s}"

# Return a 2-vector for the value of a `-size` directive. Unbounded
# sides become the literal string "*"; yaml/dump quotes it as needed.
defn size-pair(lo hi):
  lo-v =: lo:nil?.if('*' lo)
  hi-v =: hi:nil?.if('*' hi)
  =>: +[lo-v hi-v]

defn regex-literal(pattern):
  esc =: pattern.replace('/' '\\/')
  =>: "/$esc/"

defn safe-pipe-token?(v):
  v =~ /^[A-Za-z0-9_][A-Za-z0-9_-]*$/

defn enum-pipe(values):
  when values.every?(safe-pipe-token?):
    values.join('|')

defn enum-block-list(values):
  values:vec

defn literal-value(v): v

# --------------------------------------------------------------------
# Post-processing the dumped YAML.
# --------------------------------------------------------------------

defn post-process(text):
  lines =: text:lines
  lines =: lines.map(replace-todo)
  lines =: insert-blank-after-defs(lines)
  join "\n": lines

defn replace-todo(line):
  pat =: /^(\s*)__TODO_(\S+):\ ''$/
  rep =: '$1# TODO: $2'
  replace line: pat rep

# Insert one blank line between the trailing `+...` $defs entries and
# the first body entry, if any $defs were emitted.
defn insert-blank-after-defs(lines):
  state =: reduce(insert-blank-step initial-insert-state() lines)
  =>: state.0

defn initial-insert-state():
  =>: +[[] false false]

defn insert-blank-step(state line):
  result =: state.0
  saw-plus =: state.1 || (line =~ /^\+/)
  inserted =: state.2
  is-body =: line =~ /^[A-Za-z]/
  should-insert =: saw-plus && not(inserted) && is-body
  result =:
    if should-insert:
      add+(result '')
      result
  result =: add+(result line)
  inserted =: inserted || should-insert
  =>: +[result saw-plus inserted]
