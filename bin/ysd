#!/usr/bin/env bash

set -euo pipefail

top=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P)
source_file="$top/.cache/ysd-cli.ys"
if [[ ! -f $source_file ||
      $top/lib/ysd/core.ys -nt $source_file ||
      $top/lib/ysd/cli.ys -nt $source_file ||
      $top/util/compose-ysd -nt $source_file ]]; then
  make -C "$top" --no-print-directory -s .cache/ysd-cli.ys
fi
exec ys-0 -f "$source_file" -- "$@"
