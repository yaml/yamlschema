#!/usr/bin/env ys-0

# ysd - Convert JSON Schema to YAML Schema (succinct DSL).
#
# Reads a JSON Schema document from an explicit input path. Use "-" to read
# from stdin. Builds the equivalent YAML Schema as a YS data structure, dumps
# it via yaml/dump, and post-processes the result for canonical layout.
# Unsupported JSON Schema keywords are preserved as dotted passthrough
# directives and reported as warnings.

VERSION =: '0.1.7'
JSON-SCHEMA-DIALECT =: 'https://json-schema.org/draft/2020-12/schema'
WILDCARD-KEY =: '+Str'
BUILT-IN-TYPE-NAMES =:
  set: +[
    'Any', 'Str', 'Int', 'Float', 'Num', 'Bool',
    'Null', 'Map', 'One', 'All', 'Not']
JSON-SCHEMA-FORMATS =:
  set: qw(
    date-time date time duration email idn-email hostname idn-hostname
    ipv4 ipv6 uri uri-reference iri iri-reference uuid uri-template
    json-pointer relative-json-pointer regex)
CLI-FORMATS =:
  set: qw(ysd ysdc jsc)
HELP =: |
  Usage: ysd [INPUT]
         ysd (-t FORMAT | -o FILE) [INPUT]
         ysd -N, --norm [INPUT]
         ysd -R, --roundtrip [-q, --quiet] [INPUT]

  Convert between JSON Schema and yamlschema formats.

  Arguments:
    INPUT                 Input schema path. Defaults to stdin.

  Options:
    -t, --to FORMAT       Output format: ysd, ysdc, or jsc.
                          Defaults based on input.
    -f, --from FORMAT     Input format: ysd, ysdc, or jsc.
    -Y, --yaml            Emit YAML output.
    -J, --json            Emit JSON output.
    -o, --output FILE     Write output to FILE. Use "-" for stdout.
    -N, --norm            Normalize input to draft 2020-12 JSON Schema.
    -R, --roundtrip       Check JSON Schema or .ysd roundtrip.
    -q, --quiet           Suppress roundtrip output.
    -C, --compact         Emit compact JSON output.
        --upgrade         Upgrade from the repository's default branch.
        --help            Show this help text.
        --version         Show version.

defn main(*args):
  try:
    run-main: args*
    catch Exception error:
      data =: ex-data(error)
      if data.type == 'yamlschema/usage':
        handle-usage-error: error
        throw: error

EXPORT =::
  json-schema-normalize: [str, str]
  json-schema-to-ysd: [str, str]
  json-schema-to-ysd-strict: [str, str]
  json-schema-to-ysdc-json: [str, str]
  json-schema-to-ysdc-json-strict: [str, str]
  json-schema-to-ysdc: [str, str]
  json-schema-to-ysdc-strict: [str, str]
  json-schema-roundtrip-report: [str, str]
  json-schema-roundtrip-works: [str, bool]
  ysd-roundtrip-report: [str, str]
  ysd-roundtrip-works: [str, bool]
  ysd-to-json-schema: [str, str]

defn run-main(*args):
  handle-info-options: args
  opts =: parse-args(args)
  validate-format-options: opts
  try:
    run-schema-command: opts
    catch Exception error:
      if ex-data(error).type == 'yamlschema/usage':
        handle-schema-error: error
        throw: error

defn run-schema-command(opts):
  path =: opts.input || '-'
  text =: (path == '-').if(IN path):read
  when opts.roundtrip:
    exit: roundtrip-schema(text opts)
  target =: opts.norm.if('schema.json' output-format(opts))
  encoding =: output-encoding(opts target)
  when opts.norm:
    output =: normalize-json-schema-output(text opts encoding)
    emit-output: output opts.output
    exit: 0
  output =: convert-to(target encoding text opts)
  emit-output: output opts.output

defn json-schema-normalize(text):
  schema =: load-json-schema(text false)
  normalized-json-schema-text: schema {}

defn json-schema-to-ysd(text):
  convert: load-json-schema(text false)

defn json-schema-to-ysd-strict(text):
  convert: load-json-schema(text false) true

defn json-schema-to-ysdc-json(text):
  schema =: load-json-schema(text false)
  data =: canonical-ysdc-data(build-doc(schema) 'ysdc')
  canonical-json-output: data {}

defn json-schema-to-ysdc-json-strict(text):
  schema =: load-json-schema(text false)
  data =: canonical-ysdc-data(build-doc(schema true) 'ysdc')
  canonical-json-output: data {}

defn json-schema-to-ysdc(text):
  json-schema-to-ysdc-text: text

defn json-schema-to-ysdc-strict(text):
  schema =: load-json-schema(text false)
  canonical-ysdc-text: build-doc(schema true) 'ysdc'

defn json-schema-roundtrip-works(text):
  boolean: json-schema-roundtrip-result(text false).works

defn json-schema-roundtrip-report(text):
  ys::json/dump: json-schema-roundtrip-result(text false)

defn ysd-roundtrip-works(text):
  boolean: ysd-roundtrip-result(text false).works

defn ysd-roundtrip-report(text):
  ys::json/dump: ysd-roundtrip-result(text false)

defn ysd-to-json-schema(text):
  schema =: yamlschema-input-schema(text 'ysd.yaml' false)
  opts =: +{'compact' false}
  json-output: schema opts

defn convert-to(target encoding text opts):
  case target:
    'ysd.yaml':
      schema =: load-json-schema(text)
      serialize-ysd: convert(schema) encoding opts
    'schema.json':
      schema =: schema-input(text opts)
      schema =: add-generated-comment(schema opts)
      schema-output: schema encoding opts
    'ysdc.yaml':
      data =: canonical-input(text opts)
      warn-canonical-input-passthrough: data opts
      expanded =: expand-ysdc(data expansion-source(opts))
      expanded =: canonicalize-document-ysid(expanded)
      serialize-ysdc: collapse-direct-types(expanded) encoding opts
    else:
      usage: "unsupported output format: $target"

defn serialize-ysd(text encoding opts):
  if encoding == 'yaml':
    then: text
    else: canonical-json-output(ys::yaml/load(text) opts)

defn schema-output(schema encoding opts):
  schema =: canonical-json-schema(schema)
  if encoding == 'json':
    canonical-json-output: schema opts
    else:
      text =: ys::yaml/dump(schema)
      text: .replace(/\n$/ '')

defn serialize-ysdc(data encoding opts):
  if encoding == 'json':
    canonical-json-output: data opts
    post-process ys::yaml/dump(data): true

defn parse-args(args):
  state =: reduce(parse-arg-step initial-args-state() args)
  when state.expect:
    usage: "missing value for $(state.expect)"
  inputs-val =: state.inputs
  when inputs-val.# > 1:
    usage: 'expected at most one input'
  opts-val =: state.opts
  when opts-val.quiet && opts-val.roundtrip.!:
    usage: '-q/--quiet requires -R/--roundtrip'
  if inputs-val.# == 1:
    opts-val +: +{'input' inputs-val.0}
    else: opts-val

defn initial-args-state()::
  opts: {}
  expect:
  inputs: []

defn parse-arg-step(state arg):
  pending =: state.expect
  if pending:
    state +::
      opts:: state.opts + {pending arg}
      expect:
    handle-arg: state arg

defn handle-arg(state arg):
  cond:
    arg.in?(['-t', '--to', '-f', '--from']):
      name =: arg.in?(['-f', '--from']).if('from' 'to')
      state +: +{'expect' name}
    arg.in?(['-o', '--output']):
      state + {'expect' 'output'}
    arg.in?(['-Y', '--yaml']):
      state + {'opts' (state.opts + {'yaml' true})}
    arg.in?(['-J', '--json']):
      state + {'opts' (state.opts + {'json' true})}
    arg.in?(['-N', '--norm']):
      state + {'opts' (state.opts + {'norm' true})}
    arg.in?(['-R', '--roundtrip']):
      state + {'opts' (state.opts + {'roundtrip' true})}
    arg.in?(['-q', '--quiet']):
      state + {'opts' (state.opts + {'quiet' true})}
    arg.in?(['-C', '--compact']):
      state + {'opts' (state.opts + {'compact' true})}
    arg =~ /^-[CJNRqY][CJNRqY]+$/:
      state + {'opts' (state.opts + short-option-bundle(arg))}
    else:
      handle-input: state arg

defn short-option-bundle(arg):
  reduce add-short-option: array-map() rest(arg)

defn add-short-option(opts ch):
  case ch:S:
    'N': opts + {'norm' true}
    'R': opts + {'roundtrip' true}
    'q': opts + {'quiet' true}
    'C': opts + {'compact' true}
    'Y': opts + {'yaml' true}
    'J': opts + {'json' true}
    else: opts

defn handle-input(state arg):
  if arg =~ /^-/:
    if arg == '-':
      state +: +{'inputs' (state.inputs + arg)}
      usage: "unknown option $arg"
    state +: +{'inputs' (state.inputs + arg)}

defn output-format(opts):
  explicit =: normalize-format(opts.to)
  inferred =: infer-output-format(opts.output)
  when explicit && inferred && (explicit != inferred):
    usage: "output format conflicts with file extension: $(opts.output)"
  explicit ||: inferred || default-output-format(opts)

defn output-encoding(opts target):
  explicit =: explicit-output-encoding(opts)
  inferred =: infer-output-encoding(opts.output)
  when explicit && inferred && (explicit != inferred):
    usage: "output encoding conflicts with file extension: $(opts.output)"
  explicit ||: inferred || default-output-encoding(target)

defn explicit-output-encoding(opts):
  cond:
    opts.yaml: 'yaml'
    opts.json: 'json'

defn default-output-encoding(target):
  if target == 'schema.json': +'json' 'yaml'

defn default-output-format(opts):
  source =: input-format(opts)
  source: .in?(['ysd.yaml', 'ysdc.yaml'])
    .if('schema.json' 'ysd.yaml')

defn normalize-format(fmt):
  case fmt:
    'ysd': 'ysd.yaml'
    'ysdc': 'ysdc.yaml'
    'jsc': 'schema.json'
    'yscy': unsupported-format(fmt)
    'yscj': unsupported-format(fmt)
    'ysc': unsupported-format(fmt)
    'ysc.yaml': unsupported-format(fmt)
    'ysc.json': unsupported-format(fmt)
    'ysxy': unsupported-format(fmt)
    'ysxj': unsupported-format(fmt)
    'ysx.yaml': unsupported-format(fmt)
    'ysx.json': unsupported-format(fmt)
    else: fmt

defn unsupported-format(format):
  usage: "unsupported format: $format"

defn validate-format-options(opts):
  validate-format-option: opts.to 'output'
  validate-format-option: opts.from 'input'
  reject-old-file-extension: opts.input
  reject-old-file-extension: opts.output
  validate-roundtrip-options: opts
  validate-encoding-options: opts

defn validate-format-option(format direction):
  when format:
    normalize-format: format
    when-not CLI-FORMATS.has?(format):
      usage: "unsupported $direction format: $format"

defn validate-encoding-options(opts):
  when opts.yaml && opts.json:
    usage: '-Y/--yaml cannot be combined with -J/--json'
  when opts.norm:
    inferred =: infer-output-format(opts.output)
    when inferred && (inferred != 'schema.json'):
      usage: "output format conflicts with file extension: $(opts.output)"
  target =: opts.norm.if('schema.json' output-format(opts))
  encoding =: output-encoding(opts target)
  when opts.compact && (encoding != 'json'):
    usage: '-C/--compact requires JSON output'

defn validate-roundtrip-options(opts):
  when opts.roundtrip:
    when opts.norm:
      usage: '-R/--roundtrip cannot be combined with -N/--norm'
    when opts.compact:
      usage: '-R/--roundtrip cannot be combined with -C/--compact'
    when opts.to:
      usage: '-R/--roundtrip cannot be combined with -t/--to'
    when opts.output:
      usage: '-R/--roundtrip cannot be combined with -o/--output'
    when opts.yaml || opts.json:
      usage: '-R/--roundtrip cannot use -Y/--yaml or -J/--json'
    source =: normalize-format(opts.from)
    when source.? && source.in?(['schema.json', 'ysd.yaml']).!:
      usage: '-R/--roundtrip requires JSON Schema or .ysd input'

defn reject-old-file-extension(path):
  when path.? && path.ends?('.ysc.yaml'):
    usage: 'unsupported file extension: .ysc.yaml'
  when path.? && path.ends?('.ysc.json'):
    usage: 'unsupported file extension: .ysc.json'
  when path.? && path.ends?('.ysx.yaml'):
    usage: 'unsupported file extension: .ysx.yaml'
  when path.? && path.ends?('.ysx.json'):
    usage: 'unsupported file extension: .ysx.json'

defn canonical-input(text opts):
  source =: input-format(opts)
  if source == 'schema.json':
    then:
      schema =: load-json-schema(text)
      build-doc: schema
    else: ys::yaml/load(text)

defn schema-input(text opts default-source=nil report=true):
  source =: input-format(opts) || default-source
  if source == 'schema.json':
    load-json-schema: text report
    yamlschema-input-schema: text source report

defn yamlschema-input-schema(text source report=true):
  data =: ys::yaml/load(text)
  when report:
    warn-yamlschema-passthrough: data
  format =: expansion-source-format(source)
  expanded =: data.expand-ysdc(format)
  when report:
    warn-yamlschema-float-export: expanded
  root-before =:
    if format == 'ysd':
      ysd-text-root-before-named-types?: text
      ysd-root-before-named-types?: expanded
  ysdc-to-schema: expanded root-before

defn ysd-text-root-before-named-types?(text):
  lines =: filter(ysd-top-level-order-line? text:lines)
  first =: first(remove(ysd-order-ignored-line? lines))
  and:
    first.?
    named-type-line?(first).!

defn ysd-top-level-order-line?(line):
  top =: line =~ /^\S/
  marker =: line =~ /^(?:#|---(?:\s|$)|\.\.\.(?:\s|$))/
  top &&: marker.!

defn ysd-order-ignored-line?(line):
  line.starts?('.') &&: line !~ /^\.root\s*:/

defn named-type-line?(line):
  line.starts?('+') &&: line !~ /^\+Str\s*:/

defn input-format(opts):
  normalize-format(opts.from) ||
  infer-input-format(opts.input)

defn warn-canonical-input-passthrough(data opts):
  when input-format(opts) != 'schema.json':
    warn-yamlschema-passthrough: data

defn expansion-source(opts):
  source =:
    normalize-format(opts.from) ||
    infer-input-format(opts.input)
  expansion-source-format: source

defn expansion-source-format(source):
  if source == 'ysdc.yaml':
    then: 'ysdc'
    else: 'ysd'

defn collapse-direct-types(value):
  cond:
    map?(value):
      if (value.# == 1) && value.has?('.type'):
        then: value.'.type'
        else:
          reduce collapse-direct-type-entry: omap() value
    sequential?(value):
      collapsed =: value.map(collapse-direct-types)
      if collapsed == value: value vec(collapsed)
    else: value

defn collapse-direct-type-entry(result entry):
  key =: entry.0:S
  value =:
    if passthrough-directive?(key):
      then: entry.1
      else: collapse-direct-types(entry.1)
  ordered-put: result entry.0 value

defn infer-input-format(path):
  infer-file-format: path

defn infer-output-format(path):
  infer-file-format: path

defn infer-file-format(path):
  cond:
    path:nil?: nil
    path == '-': nil
    path =~ /\.schema\.json\.yaml$/: 'schema.json'
    path =~ /\.schema\.ya?ml$/: 'schema.json'
    path =~ /\.schema\.json$/: 'schema.json'
    path =~ /\.ysdc\.(?:yaml|json)$/: 'ysdc.yaml'
    path =~ /\.ysd\.(?:yaml|json)$/: 'ysd.yaml'

defn infer-output-encoding(path):
  cond:
    path:nil?: nil
    path == '-': nil
    path =~ /\.schema\.json\.yaml$/: 'yaml'
    path =~ /\.schema\.ya?ml$/: 'yaml'
    path =~ /\.ysdc?\.yaml$/: 'yaml'
    path =~ /\.(?:ysdc?|schema)\.json$/: 'json'

defn canonical-json-output(value opts):
  if opts.compact:
    ys::json/dump(value)
    pretty-json(value)

defn emit-output(text output):
  when output.?:
    when output != '-':
      write: output "$text\n"
  when nil?(output):
    say: text
  when output == '-':
    say: text

defn usage(msg):
  data =: +{'type' 'yamlschema/usage'}
  throw: ex-info(msg data)

defn handle-usage-error(error):
  err: "ysd: $(ex-message(error))\n"
  err: HELP
  exit: 2

defn handle-schema-error(error):
  err: "ysd: $(ex-message(error))\n"
  exit: 1

defn handle-info-options(args):
  when args.# == 0:
    print: HELP
    exit: 0
  when args.# == 1:
    arg =: args.0
    when arg == '--help':
      print: HELP
      exit: 0
    when arg == '--version':
      say: "ysd $VERSION"
      exit: 0
    when arg == '--upgrade':
      upgrade:
      exit: 0

defn upgrade():
  binary =: ys::fs/which('ysd')
  when binary.!:
    upgrade-error: 'cannot locate ysd on PATH'
  prefix =: ys::fs/dirname(ys::fs/dirname(binary))
  repo =: "$prefix/share/yamlschema"
  when-not ys::fs/d("$repo/.git"):
    upgrade-error: "installed repository not found: $repo"
  dirty =: upgrade-command-output(
    'git' '-C' repo 'status' '--porcelain')
  when dirty.?:
    upgrade-error: 'installed repository has local changes'
  upgrade-command: +'git' '-C' repo 'fetch' '-q' 'origin'
  branch =: upgrade-command-output(
    'git' '-C' repo 'symbolic-ref' '--short'
    'refs/remotes/origin/HEAD')
  upgrade-command: +'git' '-C' repo 'checkout' '-q' '--detach' branch
  upgrade-command:
    +'make' '--no-print-directory' '-C' repo 'install' "PREFIX=$prefix"
  say: "Upgraded YAMLSchema from $branch"

defn upgrade-command(*args):
  result =: sh(args*)
  status =: process-result-value(result :exit)
  output =: process-result-value(result :out)
  error =: process-result-value(result :err)
  when status != 0:
    when error.?:
      err: error
    message =: "command failed: $(args:joins)"
    upgrade-error: message status
  when output.?:
    print: output
  when error.?:
    err: error

defn upgrade-command-output(*args):
  result =: sh(args*)
  status =: process-result-value(result :exit)
  error =: process-result-value(result :err)
  when status != 0:
    when error.?:
      err: error
    message =: "command failed: $(args:joins)"
    upgrade-error: message status
  when error.?:
    err: error
  trim: process-result-value(result :out)

defn process-result-value(result key):
  key: result

defn upgrade-error(message status=1):
  err: "ysd: $message\n"
  exit: status

defn add-generated-comment(schema opts):
  path =: opts.input
  source =: input-format(opts)
  if path.? && (path != '-') && (source != 'schema.json'):
    then:
      note =: "DO NOT EDIT. THIS FILE GENERATED BY YAMLSCHEMA v$VERSION"
      schema +: +{'$comment' note}
    else: schema

defn discard-generated-comment(schema):
  comment =: schema.'$comment'
  if generated-comment?(comment):
    then: dissoc(schema '$comment')
    else: schema

defn generated-comment?(value):
  string?(value) &&
    value.starts?('DO NOT EDIT. THIS FILE GENERATED BY YAMLSCHEMA v')

defn json-output(value opts):
  value =: canonical-json-schema(value)
  if opts.compact:
    ys::json/dump: value
    pretty-json: value

defn map-put-if(result test key value):
  if test:
    then: ordered-put(result key value)
    else: result

defn ordered-put(result key value):
  merge-ordered-maps: result {key value}

defn merge-ordered-maps(*maps):
  args =: maps.mapcat(\(_.mapcat(a)))
  array-map: args*

defn normalize-json-schema-output(text opts encoding):
  schema =: schema-input(text opts 'schema.json')
  schema =: normalize-json-schema(schema true)
  schema-output: schema encoding opts

defn normalized-json-schema-text(schema opts):
  schema =: normalize-json-schema(schema true)
  json-output: schema opts

defn roundtrip-schema(text opts):
  try:
    run-schema-roundtrip: text opts
    catch Exception error:
      roundtrip-error: error opts

defn run-schema-roundtrip(text opts):
  report =: opts.quiet.!
  source =: roundtrip-input-format(text opts)
  result =: roundtrip-result(text source report)
  if result.works:
    roundtrip-match: opts
    roundtrip-mismatch: result.original result.roundtripped opts

defn roundtrip-input-format(text opts):
  source =: normalize-format(opts.from)
  if source:
    then: source
    else: (text =~ /^\s*\{/).if('schema.json' 'ysd.yaml')

defn roundtrip-result(text source report):
  case source:
    'schema.json': json-schema-roundtrip-result(text report)
    'ysd.yaml': ysd-roundtrip-result(text report)
    else: usage('-R/--roundtrip requires JSON Schema or .ysd input')

defn json-schema-roundtrip-result(text report):
  schema =: load-json-schema(text report)
  schema =: normalize-json-schema(schema true)
  original =: json-output(schema {})
  ysd =: convert(schema)
  roundtripped =:
    yamlschema-input-schema(ysd 'ysd.yaml' false)
      .normalized-json-schema-text({})
  identity: +{'works' (original == roundtripped)
              'original' original
              'roundtripped' roundtripped}

defn ysd-roundtrip-result(text report):
  schema =: yamlschema-input-schema(text 'ysd.yaml' report)
  original =: ysd-to-ysdc-text(text)
  json-schema =: json-output(schema {})
  roundtripped =: json-schema-to-ysdc-text(json-schema)
  identity: +{'works' (original == roundtripped)
              'original' original
              'roundtripped' roundtripped}

defn ysd-to-ysdc-text(text):
  data =: ys::yaml/load(text)
  canonical-ysdc-text: data 'ysd'

defn json-schema-to-ysdc-text(text):
  schema =: load-json-schema(text false)
  canonical-ysdc-text: build-doc(schema) 'ysdc'

defn canonical-ysdc-text(data source):
  data =: canonical-ysdc-data(data source)
  post-process ys::yaml/dump(data): true

defn canonical-ysdc-data(data source):
  expanded =: expand-ysdc(data source)
  expanded =: canonicalize-document-ysid(expanded)
  collapse-direct-types: expanded

defn roundtrip-match(opts):
  when-not opts.quiet:
    say: 'OK'
  =>: 0

defn roundtrip-mismatch(original roundtripped opts):
  when-not opts.quiet:
    present-diff: unified-diff(original roundtripped)
  =>: 1

defn present-diff(text):
  pager =: ys::fs/which('less')
  if pager:
    page-diff: text pager
    say: text

defn page-diff(text pager):
  options =: +{:in "$text\n", :out :inherit, :err :inherit}
  deref: process(options pager '-FRX')

defn roundtrip-error(error opts):
  when-not opts.quiet:
    err: "ysd: $(ex-message(error))\n"
  =>: 2

defn unified-diff(original roundtripped):
  dir =: bash-out('mktemp -d'):trim
  before =: "$dir/original.json"
  after =: "$dir/roundtrip.json"
  write before: "$original\n"
  write after: "$roundtripped\n"
  command =:
    "diff -u --label original --label roundtrip \
     '$before' '$after' || test $? -eq 1"
  output =: bash-out(command)
  ys::fs/rm-r: dir
  =>: output

defn normalize-json-schema(value root?):
  if map?(value):
    then: normalize-json-map(value root?)
    else: value

defn normalize-json-map(value root?):
  when root?:
    value =: discard-generated-comment(value)
  result =: omap()
  result =: reduce(\(normalize-json-entry(_1 _2 value)) result value)
  result =: normalize-definitions(result)
  result =: normalize-ref(result)
  result =: normalize-single-ref-allof(result)
  result =: normalize-single-anyof-allof(result)
  result =: canonicalize-single-required-oneof(result)
  result =: normalize-solo-list-anyof(result)
  result =: normalize-inferred-json-type(result)
  if root?:
    then:
      result =: normalize-root-json-id(result)
      ordered-put: result '$schema' JSON-SCHEMA-DIALECT
    else: result

defn normalize-inferred-json-type(result):
  if result.has?('type'):
    then: result
    else:
      candidates =:
        set:
          remove nil?:
            +[
              inferred-object-json-type(result)
              inferred-enum-json-type(result)]
      if candidates.# == 1:
        then: ordered-put(result 'type' candidates:first)
        else: result

defn inferred-object-json-type(schema):
  when map?(schema.properties) || map?(schema.patternProperties):
    =>: 'object'

defn inferred-enum-json-type(schema):
  values =: schema.enum
  when sequential?(values) && values:seq:
    types =::
      +Str: string
      +Int: integer
      +Num: number
      +Bool: boolean
      +Null: 'null'
      +Map: object
    base =: json-infer-base(values)
    type =: types.$base
    =>: type

defn normalize-root-json-id(result):
  modern =: result.has?('$id')
  legacy =: draft4-json-schema?(result) && result.has?('id')
  if modern || legacy:
    then:
      value =: modern.if(result.'$id' result.id)
      id =: canonical-document-id(value 'jsc' 'JSON Schema $id')
      result :if legacy =: result.del('id')
      result: .put('$id' id)
    else: result

defn canonicalize-document-ysid(doc):
  if doc.has?('.ysid'):
    then:
      id =: canonical-document-id(doc.'.ysid' 'ysd' '.ysid')
      first =: +{'.ysid' id}
      rest =:
        reduce remove-document-ysid: omap() doc
      merge-ordered-maps: first rest
    else: doc

defn remove-document-ysid(result entry):
  if entry.0:S == '.ysid':
    then: result
    else: ordered-put(result entry.0 entry.1)

defn canonical-document-id(value target label):
  when string?(value).! || (value == ''):
    usage: "$label must be a non-empty string"
  path =: value.replace(/[?#].*$/ '')
  suffix =: value.replace(/^[^?#]*/ '')
  base =: path.replace(/\.(?:ysdc?|schema)\.json$/ '')
  base =: base.replace(/\.(?:ysdc?|schema(?:\.json)?)\.yaml$/ '')
  base =: base.replace(/\.schema\.yml$/ '')
  =>: "$base.$(document-id-extension(target))$suffix"

defn document-id-extension(target):
  case target:
    'ysd': 'ysd.yaml'
    'jsc': 'schema.json'
    else:
      usage: "unsupported document ID target: $target"

defn normalize-json-entry(result entry schema):
  key =: entry.0
  value =: entry.1
  unconstrained-additional =:
    value.eq(true) || (map?(value) && empty?(value))
  drop =:
    (key.eq('additionalProperties') && unconstrained-additional) ||
    (key.eq('dependentRequired') && map?(value) && empty?(value)) ||
    (key.eq('minProperties') && value.eq(0)) ||
    (key.eq('patternProperties') && map?(value) && empty?(value)) ||
    (key.eq('items') && map?(value) && empty?(value) &&
      contains?(schema 'unevaluatedItems').!) ||
    (key.eq('uniqueItems') && value.eq(false))
  if drop:
    then: result
    else: ordered-put(result key normalize-json-keyword-value(key value))

defn normalize-json-keyword-value(key value):
  cond:
    key.eq('required') && sequential?(value):
      vec: value
    key.eq('dependentRequired') && map?(value):
      normalize-dependent-required: value
    single-schema-json-keyword?(key):
      normalize-json-schema: value false
    sequence-schema-json-keyword?(key) && sequential?(value):
      vec: value.map(\(normalize-json-schema(_ false)))
    mapping-schema-json-keyword?(key) && map?(value):
      normalize-json-schema-mapping: value
    else: value

defn normalize-dependent-required(value):
  reduce normalize-dependent-required-entry: omap() value

defn normalize-dependent-required-entry(result entry):
  key required =: entry
  required =: sequential?(required).if(vec(required) required)
  ordered-put: result key required

defn normalize-json-schema-mapping(value):
  reduce normalize-json-schema-mapping-entry: omap() value

defn normalize-json-schema-mapping-entry(result entry):
  ordered-put: result entry.0 normalize-json-schema(entry.1 false)

defn normalize-definitions(result):
  if contains?(result 'definitions'):
    then:
      old-defs =: result.get('$defs') || omap()
      defs =: merge-ordered-maps(
        old-defs
        result.get('definitions'))
      target =: result.has?('$defs').if('$defs' 'definitions')
      reduce \(normalize-definition-entry(_1 _2 target defs)):
        omap() result
    else: result

defn normalize-definition-entry(result entry target defs):
  key =: entry.0:S
  cond:
    key == target: ordered-put(result '$defs' defs)
    key.in?(['$defs' 'definitions']): result
    else: ordered-put(result entry.0 entry.1)

defn normalize-ref(result):
  if contains?(result '$ref'):
    then:
      ref =: result.get('$ref')
      ref =: normalize-ref-value(ref)
      ordered-put: result '$ref' ref
    else: result

defn normalize-ref-value(ref):
  if string?(ref):
    then: ref.replace(/^#\/definitions\// '#/\$defs/')
    else: ref

defn normalize-single-ref-allof(result):
  if result.has?('$ref') || singleton-ref-allof?(result).!:
    then: result
    else:
      reference =: result.allOf.0.'$ref'
      normalized =: dissoc(result 'allOf')
      ordered-put: normalized '$ref' reference

defn normalize-single-anyof-allof(result):
  if result.has?('anyOf') || singleton-anyof-allof?(result).!:
    then: result
    else:
      alternatives =: result.allOf.0.anyOf
      normalized =: dissoc(result 'allOf')
      ordered-put: normalized 'anyOf' alternatives

defn canonicalize-single-required-oneof(schema):
  required =: singleton-required-oneof(schema)
  if required:
    then:
      keys =: schema:keys.remove(\(_:S == 'oneOf'))
      result =: select-keys(schema keys)
      existing =: schema.required || []
      required =: vec(distinct(existing + required))
      ordered-put: result 'required' required
    else: schema

defn singleton-required-oneof(schema):
  branches =: schema.oneOf
  existing =: schema.required
  valid-existing =: existing:nil? || sequential?(existing)
  when sequential?(branches) && (branches.# == 1) && valid-existing:
    branch =: branches.0
    required =: branch.required
    valid =:
      and:
        map?(branch)
        branch.#.eq(1)
        sequential?(required)
        required:seq
        required.every?(string?)
    when valid:
      =>: required

defn normalize-solo-list-anyof(result):
  info =: solo-list-info(result)
  if info && info.array-first:
    then: result.put('anyOf' [info.item info.array])
    else: result

defn solo-list-info(schema):
  when map?(schema):
    branches =: schema.anyOf
    when sequential?(branches) && (branches.# == 2):
      left right =: branches
      left-solo =: solo-list-array?(left) &&
        normalized-schema-equal?(right left.items)
      right-solo =: solo-list-array?(right) &&
        normalized-schema-equal?(left right.items)
      cond:
        left-solo:
          +{'item' right, 'array' left, 'array-first' true}
        right-solo:
          +{'item' left, 'array' right, 'array-first' false}

defn solo-list-array?(schema):
  allowed =: set(qw(type items minItems maxItems uniqueItems))
  and:
    map?(schema)
    schema.type == 'array'
    contains?(schema 'items')
    map?(schema.items)
    schema:keys.every?(\(allowed.has?(_)))

defn normalized-schema-equal?(left right):
  left =: normalize-json-schema(left false):canonical-json-schema
  right =: normalize-json-schema(right false):canonical-json-schema
  left ==: right

defn importable-solo-list-info(schema):
  allowed =: set(qw(anyOf $anchor title description default))
  info =: solo-list-info(schema)
  when info && schema:keys.every?(\(allowed.has?(_))):
    =>: info

defn canonical-json-schema(value):
  cond:
    map?(value):
      canonical-json-map: value
    sequential?(value):
      vec: map(canonical-json-schema value)
    else:
      value

defn canonical-json-map(value):
  result =: omap()
  preferred =: ordered-preferred-json-schema-keys(value)
  result =: reduce(\(add-canonical-key(_1 _2 value))
                   result preferred)
  extra-keys =:
    sort(remove(\(preferred-json-schema-key?(_)) value:keys))
  reduce \(add-canonical-key(_1 _2 value)): result extra-keys

defn ordered-preferred-json-schema-keys(value):
  keys =: preferred-json-schema-keys()
  if json-defs-follow-root?(value):
    then:
      ordered =: vec(keys.remove(\(_ == '$defs')))
      ordered: .conj('$defs')
    else: keys

defn json-defs-follow-root?(value):
  when contains?(value '$defs'):
    root-keys =: set(drop(7 preferred-json-schema-keys()))
    keys =: value:keys
    keys:
      .take-while(\(_ != '$defs'))
      .some(\(root-keys.has?(_)))

defn add-canonical-key(result key value):
  if contains?(value key):
    then:
      child =: canonical-json-keyword-value(key value.$key)
      ordered-put: result key child
    else: result

defn canonical-json-keyword-value(key value):
  cond:
    single-schema-json-keyword?(key):
      canonical-json-schema: value
    sequence-schema-json-keyword?(key) && sequential?(value):
      vec: value.map(canonical-json-schema)
    mapping-schema-json-keyword?(key) && map?(value):
      canonical-json-schema-mapping: value
    else:
      preserve-json-value: value

defn canonical-json-schema-mapping(value):
  reduce canonical-json-schema-mapping-entry: omap() value

defn canonical-json-schema-mapping-entry(result entry):
  ordered-put: result entry.0 canonical-json-schema(entry.1)

defn preserve-json-value(value):
  cond:
    map?(value):
      reduce preserve-json-entry: omap() value
    sequential?(value):
      vec: value.map(preserve-json-value)
    else: value

defn preserve-json-entry(result entry):
  ordered-put: result entry.0 preserve-json-value(entry.1)

defn preferred-json-schema-key?(key):
  preferred-json-schema-keys().has?(key)

defn preferred-json-schema-keys():
  split _ ' ':
    '$comment $id $schema $anchor title description
    $defs type format enum const default $ref
    properties required dependentRequired additionalProperties
    items uniqueItems minItems maxItems
    minimum maximum minLength maxLength
    minProperties maxProperties'

defn pretty-json(value):
  pretty-value: value 0

defn pretty-value(value level):
  cond:
    map?(value): pretty-map(value level)
    value:vector?: pretty-array(value level)
    else: pretty-scalar(value)

defn pretty-scalar(value):
  ys::json/dump(value).replace(/\\\// '/')

defn pretty-map(value level):
  if empty?(value):
    then: '{}'
    else:
      child =: level + 2
      entries =: map(\(pretty-map-entry(_ child)) value)
      body =: join(",\n" entries)
      =>: "{\n$body\n$(indent(level))}"

defn pretty-map-entry(entry level):
  pretty-map-key: entry.0 entry.1 level

defn pretty-map-key(key value level):
  rendered =: pretty-value(value level)
  =>: "$(indent(level))$(ys::json/dump(key)): $rendered"

defn pretty-array(value level):
  if empty?(value):
    then: '[]'
    else:
      child =: level + 2
      entries =:
        map(\("$(indent(child))$(pretty-value(_ child))")
            value)
      body =: join(",\n" entries)
      =>: "[\n$body\n$(indent(level))]"

defn indent(width):
  join '': repeat(width ' ')

# --------------------------------------------------------------------
# Expand succinct yamlschema into canonical explicit yamlschema.
# --------------------------------------------------------------------

defn expand-ysdc(doc source='ysd'):
  when-not map?(doc):
    usage: 'expected yamlschema mapping'
  validate-regex-directives: doc source
  validate-pattern-property-forms: doc
  expanded =: reduce(expand-doc-entry omap() doc)
  expanded =: canonicalize-document-ysid(expanded)
  validate-schema-names: expanded
  resolve-open-doc: expanded

defn validate-regex-directives(value source):
  cond:
    map?(value):
      each entry value:
        key =: entry.0:S
        when (source == 'ysd') && (key == '.like'):
          usage: 'unsupported .ysd directive: .like; use .match or .find'
        when (source == 'ysdc') && key.in?(['.match', '.find']):
          usage: "unsupported .ysdc directive: $key; use .like"
        when passthrough-directive?(key).!:
          validate-regex-directives: entry.1 source
    sequential?(value):
      each item value:
        validate-regex-directives: item source

defn validate-pattern-property-forms(value):
  native =:
    map?(value) && value:keys.some(\(pattern-property-key?(_)))
  legacy =: map?(value) && contains?(value '.patternProperties')
  when native && legacy:
    usage:
      'yamlschema cannot mix regex keys with .patternProperties'

defn expand-doc-entry(result entry):
  key value =: entry
  key =: key:S
  cond:
    key == '.need': reject-misplaced-need-directive()
    key == '.Name': reject-title-directive(key)
    key == '.json': reject-json-meta()
    renamed-directive?(key): reject-renamed-directive(key)
    key == '.additionalProperties': reject-additional-properties(key)
    legacy-directive?(key): reject-legacy-directive(key)
    passthrough-directive?(key):
      ordered-put: result key value
    key =~ /^\./:
      expand-top-directive: result key value
    key == WILDCARD-KEY:
      ordered-put: result key expand-type(value)
    pattern-property-key?(key):
      add-expanded-pattern-property: result key value
    key =~ /^\+/:
      ordered-put: result key expand-type(value)
    else:
      add-expanded-field: result key value

defn top-directive?(key):
  key.in?([
    '.ysid', '.from', '.name', '.root', '.title',
    '.desc', '.open', '.one', '.keys', '.size'])

defn expand-top-directive(result key value):
  when-not top-directive?(key):
    reject-unknown-directive: key
  normalized =:
    case key:
      '.ysid': canonical-document-id(value 'ysd' '.ysid')
      '.name': validate-schema-name(value)
      '.root': expand-type(value)
      '.open': validate-open-value(value)
      '.one': expand-combinator-sequence(key value)
      '.keys': expand-key-rules(value)
      '.size': normalize-size(value)
      else: value
  ordered-put: result key normalized

defn expand-key-rules(value):
  when-not sequential?(value):
    usage: 'yamlschema .keys requires a non-empty sequence of rules'
  rules =: vec(value)
  when rules:empty?:
    usage: 'yamlschema .keys requires a non-empty sequence of rules'
  vec: rules.map(expand-key-rule)

defn expand-key-rule(value):
  valid =: map?(value) && key-set(value).eq(\{'.any'})
  when-not valid:
    usage: 'yamlschema .keys rules currently require exactly one .any entry'
  branches =: value.'.any'
  when-not sequential?(branches):
    usage: 'yamlschema .keys .any requires at least two branches'
  when count(branches) < 2:
    usage: 'yamlschema .keys .any requires at least two branches'
  expanded =: vec(branches.map(expand-key-rule-branch))
  =>: +{'.any' expanded}

defn expand-key-rule-branch(value):
  when-not map?(value):
    usage:
      'yamlschema .keys .any branches require property-to-type mappings'
  when empty?(value):
    usage:
      'yamlschema .keys .any branches require property-to-type mappings'
  reduce expand-key-rule-branch-entry: omap() value

defn expand-key-rule-branch-entry(result entry):
  key =: entry.0:S
  reserved =:
    key.starts?('.') ||
    key.starts?('+') ||
    pattern-property-key?(key)
  when reserved:
    usage: 'yamlschema .keys .any branch keys must be property names'
  add-expanded-field: result key entry.1

defn add-expanded-field(result key value):
  info =: parse-expanded-key(key)
  block =: expand-type(value)
  block =: canonicalize-type-reference(block)
  ordered-put: result info.key block

defn add-expanded-pattern-property(result key value):
  block =: expand-type(value)
  when contains?(block '.need'):
    usage: 'yamlschema regex keys cannot use .need'
  ordered-put: result key canonicalize-type-reference(block)

defn parse-expanded-key(key):
  when key-list-suffix?(key):
    reject-key-list-suffix: key
  =>: +{'key' key}

defn key-list-suffix?(key):
  key =~ /\[[^\]]*\]\??$/

defn reject-key-list-suffix(key):
  usage: "unsupported list syntax on key $key; put it on the value type"

defn expand-type(value):
  block =:
    if map?(value):
      expand-type-map: value
      expand-tight: value
  block =: canonicalize-type-reference(block)
  validate-complete-map-type: block
  =>: block

defn validate-complete-map-type(value):
  reference =: value.'.type'
  incomplete =: reference.in?(['+Map', '+Map[]'])
  shaped =: value:keys.some(\(_ !~ /^\./)) || contains?(value '.open')
  when incomplete && shaped.!:
    usage: 'incomplete +Map type requires key/value pairs'

defn expand-type-map(value):
  validate-pattern-property-forms: value
  explicit =: value:keys.some(\(_:S =~ /^\./))
  if explicit:
    expand-explicit-type: value
    expand-shape-type: value

defn expand-shape-type(value):
  reduce expand-shape-entry: omap() value

defn expand-shape-entry(result entry):
  key =: entry.0:S
  cond:
    key == WILDCARD-KEY: ordered-put(result key expand-type(entry.1))
    pattern-property-key?(key):
      add-expanded-pattern-property: result key entry.1
    else: add-expanded-field(result key entry.1)

defn expand-explicit-type(value):
  shaped =: value:keys.some(\(_ !~ /^\./))
  old-map-marker =: shaped && value.'.type'.eq('+Map')
  reference =: value.'.type'
  base =:
    if value.has?('.type') && old-map-marker.!:
      expand-tight: reference
      omap:
  result =: reduce(expand-explicit-entry base value)
  validate-exclusive-range-directives: result
  ordered-directives: result

defn expand-explicit-entry(result entry):
  key val =: entry
  key =: key:S
  cond:
    key == '.type': result
    key == '.list': reject-list-directive()
    key == '.Name': reject-title-directive(key)
    renamed-directive?(key): reject-renamed-directive(key)
    key == '.additionalProperties': reject-additional-properties(key)
    legacy-directive?(key): reject-legacy-directive(key)
    passthrough-directive?(key):
      ordered-put: result key val
    key =~ /^\./:
      expand-explicit-directive: result key val
    key == WILDCARD-KEY:
      ordered-put: result key expand-type(val)
    pattern-property-key?(key):
      add-expanded-pattern-property: result key val
    else:
      add-expanded-field: result key val

defn type-directive?(key):
  directives =:
    +['.name', '.type', '.xref', '.like', '.match',
      '.find', '.enum', '.const', '.range', '.xmin', '.xmax', '.size',
      '.list', '.item', '.solo', '.uniq', '.null',
      '.init', '.one', '.any', '.all', '.not',
      '.title', '.desc', '.open', '.need', '.also',
      '.with', '.when']
  key: .in?(directives)

defn expand-explicit-directive(result key value):
  when-not type-directive?(key):
    reject-unknown-directive: key
  normalized =:
    cond:
      key == '.range': range-block(value result.'.type')
      result.has?('.type') && key.in?(['.enum', '.const']): +{key value}
      else: normalize-directive(key value)
  normalized =: add-implied-directive-base(normalized key value result)
  merge-directives: result normalized "directive $key"

defn add-implied-directive-base(normalized key value result):
  missing =: result.has?('.type').! && normalized.has?('.type').!
  bases =:
    +{'.like' '+Str', '.match' '+Str', '.find' '+Str', '.list' '+Any'}
  base =: missing.when(bases.$key)
  if base:
    then: normalized + {'.type' base}
    else: normalized

defn normalize-directive(key value):
  case key:
    '.name': +{key validate-schema-name(value)}
    '.xref': +{key validate-external-reference(value)}
    '.like': +{key value:S}
    '.match': +{'.like' anchored-pattern(regex-pattern(value))}
    '.find': +{'.like' regex-pattern(value)}
    '.xmin': +{key validate-exclusive-range-value(key value)}
    '.xmax': +{key validate-exclusive-range-value(key value)}
    '.size': +{key normalize-size(value)}
    '.item': +{key expand-type(value)}
    '.one': +{key expand-combinator-sequence(key value)}
    '.any': +{key expand-combinator-sequence(key value)}
    '.all': +{key expand-combinator-sequence(key value)}
    '.not': +{key expand-type(value)}
    '.enum': inferred-directive(key value)
    '.const': inferred-directive(key value)
    '.open': +{key validate-open-value(value)}
    '.need': +{key validate-need-value(value)}
    else: +{key value}

defn validate-exclusive-range-value(key value):
  when value != true:
    usage: "yamlschema $key must be true"
  =>: value

defn validate-open-value(value):
  when-not boolean?(value):
    usage: 'yamlschema .open must be true or false'
  =>: value

defn validate-external-reference(value):
  when-not string?(value):
    usage: 'yamlschema .xref must be a string'
  =>: value

defn validate-schema-name(value label='yamlschema .name'):
  when-not string?(value):
    usage: "$label must be a non-empty string"
  when value:empty?:
    usage: "$label must be a non-empty string"
  when-not value =~ /^[A-Za-z_][A-Za-z0-9._-]*$/:
    usage: "invalid $label: $value"
  =>: value

defn validate-schema-names(doc):
  seen =: atom(\{})
  validate-schema-name-tree: doc seen
  =>: doc

defn validate-schema-name-tree(value seen):
  when map?(value):
    when contains?(value '.name'):
      name =: validate-schema-name(value.'.name')
      when deref(seen).has?(name):
        usage: "duplicate yamlschema .name: $name"
      swap!: seen conj name
    each entry value:
      validate-schema-name-child: entry seen

defn validate-schema-name-child(entry seen):
  key value =: entry
  key =: key:S
  cond:
    key.in?(['.one', '.any', '.all']) && sequential?(value):
      each child value:
        validate-schema-name-tree: child seen
    key.in?(['.item', '.not']):
      validate-schema-name-tree: value seen
    key =~ /^\./: nil
    else: validate-schema-name-tree(value seen)

# `.open` is a lexical .ysd default for mapping types. Canonical .ysdc keeps
# `.open: true` only at the document top. A local wildcard opens one mapping,
# while `.open: false` closes a mapping and its nested default.
defn resolve-open-doc(doc):
  explicit =: contains?(doc '.open')
  source-open =: doc.get('.open' false)
  validate-open-value: source-open
  wildcard =: contains?(doc WILDCARD-KEY)
  when explicit && source-open.! && wildcard:
    usage: 'yamlschema .open: false conflicts with an explicit +Str wildcard'
  result =: reduce(
    \(resolve-open-doc-entry(_1 _2 source-open source-open))
    omap()
    doc)
  wildcard-last: result

defn resolve-open-doc-entry(result entry source-open output-open):
  key =: entry.0:S
  value =: entry.1
  cond:
    key == '.one':
      ordered-put: result key resolve-open-root-one(value)
    key == '.keys':
      ordered-put:
        result key resolve-open-key-rules(value source-open output-open)
    key == '.open':
      if source-open:
        then: ordered-put(result key true)
        else: result
    (key == WILDCARD-KEY) && source-open && wildcard-any?(value):
      result
    key =~ /^\./: ordered-put(result key value)
    else:
      ordered-put:
        result key resolve-open-type(value source-open output-open)

defn resolve-open-root-one(branches):
  vec: branches.map(\(resolve-open-type(_ true true)))

defn resolve-open-key-rules(rules source-open output-open):
  vec: rules.map(
    \(resolve-open-key-rule(_ source-open output-open)))

defn resolve-open-key-rule(rule source-open output-open):
  branches =: rule.'.any'.map(
    \(resolve-open-key-branch(_ source-open output-open))):vec
  =>: +{'.any' branches}

defn resolve-open-key-branch(branch source-open output-open):
  reduce:
    \(resolve-open-key-branch-entry(
      _1 _2 source-open output-open))
    omap()
    branch

defn resolve-open-key-branch-entry(result entry source-open output-open):
  value =: resolve-open-type(entry.1 source-open output-open)
  ordered-put: result entry.0 value

defn resolve-open-type(value source-open output-open):
  when-not map?(value):
    =>: value
  explicit =: contains?(value '.open')
  local-open =:
    if explicit:
      then: value.'.open'
      else: source-open
  validate-open-value: local-open
  wildcard =: contains?(value WILDCARD-KEY)
  when explicit && open-compatible-type?(value).!:
    usage: 'yamlschema .open requires an anonymous mapping type'
  when explicit && local-open.! && wildcard:
    usage: 'yamlschema .open: false conflicts with an explicit +Str wildcard'
  shape =: open-mapping-shape?(value)
  child-source-open =:
    if shape:
      then: local-open
      else: source-open
  close-output =: shape && local-open.! && output-open
  child-output-open =: close-output.if(false output-open)
  result =: reduce(
    \(resolve-open-entry(
      _1 _2 child-source-open child-output-open))
    omap()
    value)
  result =: dissoc(result '.open')
  result =: canonical-open-shape(
    result shape local-open output-open wildcard)
  ordered-directives: result

defn canonical-open-shape(result shape local-open output-open wildcard):
  if-not shape:
    then: result
    else:
      unconstrained =:
        wildcard && wildcard-any?(result.$WILDCARD-KEY)
      has-fields =: result:keys.some(
        \((_ != WILDCARD-KEY) && (_:S !~ /^\./)))
      result =:
        if unconstrained && output-open && has-fields:
          then: dissoc(result WILDCARD-KEY)
          else: result
      cond:
        local-open && output-open.! && wildcard.!:
          ordered-put: result WILDCARD-KEY {'.type' '+Any'}
        local-open.! && output-open:
          ordered-put: result '.open' false
        else: result

defn wildcard-any?(value):
  (value == '+Any') ||
    (map?(value) && (value.'.type' == '+Any') && (value.# == 1))

defn open-mapping-shape?(value):
  empty?(value) ||
    contains?(value '.open') || value:keys.some(\(_ !~ /^\./))

defn open-compatible-type?(value):
  reference =: value.get('.type')
  shaped =: value:keys.some(\(_ !~ /^\./))
  =>: reference.nil? || shaped || reference.in?(['+Map', '+Map[]'])

defn resolve-open-entry(result entry source-open output-open):
  key =: entry.0:S
  value =: entry.1
  resolved =:
    cond:
      key.in?(['.one', '.any', '.all']):
        vec: value.map(
          \(resolve-open-type(_ source-open output-open)))
      key.in?(['.item', '.not']):
        resolve-open-type: value source-open output-open
      key =~ /^\./: value
      else: resolve-open-type(value source-open output-open)
  ordered-put: result key resolved

defn expand-combinator-sequence(key value):
  when-not sequential?(value):
    usage: "yamlschema $key requires a sequence of type definitions"
  values =: vec(value)
  when values:empty?:
    usage: "yamlschema $key requires at least one type definition"
  vec: values.map(expand-type)

defn inferred-directive(key value):
  result =: +{key value}
  result +: +{'.type' infer-base(key.eq('.enum').if(value [value]))}

defn merge-directives(left right context):
  duplicates =: right:keys.filter(\(left.has?(_)))
  when duplicates:seq:
    key =: sort(duplicates).0
    usage: "duplicate yamlschema directive: $key in $context"
  ordered-directives: merge-ordered-maps(left right)

defn ordered-directives(value):
  order =:
    +['.name', '.type', '.xref', '.open', '.need',
      '.list', '.item', '.one', '.any', '.all',
      '.not', '.like', '.enum', '.const', '.range', '.xmin', '.xmax',
      '.size', '.solo', '.uniq', '.null', '.init',
      '.title', '.desc', '.also', '.with', '.when']
  result =: reduce(\(put-present(_1 _2 value)) omap() order)
  result =: reduce(put-non-directive result value)
  if contains?(value WILDCARD-KEY):
    then: ordered-put(result WILDCARD-KEY value.$WILDCARD-KEY)
    else: result

defn canonicalize-type-reference(value):
  value =: fold-list-type(value)
  value =: canonicalize-solo-list-any(value)
  ordered-directives: value

defn fold-list-type(value):
  if value.'.list':
    then:
      shaped =: value:keys.some(\(_ !~ /^\./))
      inferred =: shaped.if('+Map' '+Any')
      reference =: value.get('.type' inferred)
      reference =: reference.ends?('[]').if(reference "$reference[]")
      result =: dissoc(value '.list')
      result =: dissoc(result '.type')
      ordered-put: result '.type' reference
    else: value

defn canonicalize-solo-list-any(value):
  info =: ysdc-solo-list-info(value)
  if info:
    then:
      keys =: value:keys.remove(\(_:S == '.any'))
      annotations =: select-keys(value keys)
      result =: merge-ordered-maps(info.list annotations)
      ordered-put: result '.solo' true
    else: value

defn ysdc-solo-list-info(value):
  allowed =: set(['.any' '.name' '.init' '.title' '.desc'])
  branches =: value.'.any'
  eligible =:
    and:
      map?(value)
      sequential?(branches)
      branches.#.eq(2)
      value:keys.every?(\(allowed.has?(_:S)))
  when eligible:
    left right =: branches
    left-list =: ysdc-solo-list-branch?(left)
    right-list =: ysdc-solo-list-branch?(right)
    cond:
      (and left-list (ysdc-list-item-equal? left right)):
        +{'list' left}
      (and right-list (ysdc-list-item-equal? right left)):
        +{'list' right}

defn ysdc-solo-list-branch?(value):
  reference =: value.'.type'
  forbidden =:
    set(['.solo' '.null' '.name' '.init' '.title' '.desc'])
  and:
    map?(value)
    string?(reference)
    reference.ends?('[]')
    value:keys.every?(\(forbidden.has?(_:S).!))

defn ysdc-list-item-equal?(list item):
  array =: ysdc-value-to-schema(list false)
  allowed =: set(qw(type items minItems maxItems uniqueItems))
  valid =:
    and:
      array.type == 'array'
      map?(array.items)
      array:keys.every?(\(allowed.has?(_)))
  when valid:
    item-schema =: ysdc-value-to-schema(item false)
    normalized-schema-equal?: array.items item-schema

defn put-present(result key value):
  if contains?(value key):
    then: ordered-put(result key value.$key)
    else: result

defn put-non-directive(result entry):
  key =: entry.0:S
  if key == WILDCARD-KEY:
    then: result
    else:
      if key =~ /^\./:
        then:
          if passthrough-directive?(key):
            then: ordered-put(result key entry.1)
            else: result
        else: ordered-put(result key entry.1)

defn wildcard-last(value):
  result =: reduce(put-non-wildcard omap() value)
  if contains?(value WILDCARD-KEY):
    then: ordered-put(result WILDCARD-KEY value.$WILDCARD-KEY)
    else: result

defn put-non-wildcard(result entry):
  if entry.0:S == WILDCARD-KEY:
    then: result
    else: ordered-put(result entry.0 entry.1)

defn reject-unknown-directive(key):
  usage: "unsupported yamlschema directive: $key"

defn reject-misplaced-need-directive():
  usage: 'yamlschema .need is only valid on a property definition'

defn reject-list-directive():
  usage: 'unsupported yamlschema directive: .list; use [] on the type'

defn reject-list-keyword():
  usage: 'unsupported yamlschema keyword: list; use [] on the type'

defn expand-tight(value):
  if string?(value):
    expand-tight-string: value
    else: literal-block(value)

defn expand-tight-string(value):
  when value =~ /\s+'[^']*'$/:
    usage: 'single-quoted descriptions are unsupported; use "description"'
  when value =~ /^\/.*[ \t].*\/(?:\s|$)/:
    usage: 'regex literals cannot contain whitespace; use find:"..."'
  tokens =: tight-tokens(value)
  when tokens:empty?:
    usage: 'empty yamlschema type expression'
  bases =: tokens.filter(base-primary-token?):vec
  if bases:seq:
    then:
      primary =: bases.0
      result =: expand-primary-token(primary)
      rest =: remove-first-token(tokens primary)
      result =: reduce(expand-tight-token result rest)
      validate-exclusive-range-directives: result
    else:
      result =: expand-primary-token(tokens.0)
      result =: reduce(expand-tight-token result vec(tokens:rest))
      validate-exclusive-range-directives: result

defn remove-first-token(tokens target):
  state =: +{'found' false, 'tokens' []}
  state =: reduce(\(remove-first-token-step(_1 _2 target)) state tokens)
  =>: state.tokens

defn remove-first-token-step(state token target):
  if state.found.! && (token == target):
    then: state + {'found' true}
    else: state + {'tokens' (state.tokens + token)}

defn tight-tokens(value):
  tokens =: tight-token-scan(value)
  bad-quote =: tokens.some(bad-tight-token-quote?)
  when bad-quote:
    usage: 'tight quoted values cannot contain a double quote'
  =>: tokens

defn tight-token-scan(value):
  tight-token-loop: value:seq '' [] false 0 0 0

defn tight-token-loop(chars token tokens quoted parens brackets braces):
  if chars:empty?:
    then: append-tight-token(tokens token)
    else:
      char =: chars.0:S
      rest =: chars:rest
      boundary =: (char =~ /\s/) && quoted.! &&
        parens.! && brackets.! && braces.!
      if boundary:
        then:
          tight-token-loop:
            rest
            ''
            append-tight-token(tokens token)
            quoted
            parens
            brackets
            braces
        else:
          was-quoted =: quoted
          quote =: C(34):S
          quoted =: (char == quote).if(quoted.! quoted)
          tight-token-loop:
            rest
            (token + char)
            tokens
            quoted
            tight-token-depth(parens char '(' ')' was-quoted)
            tight-token-depth(brackets char '[' ']' was-quoted)
            tight-token-depth(braces char '{' '}' was-quoted)

defn append-tight-token(tokens token):
  if token:
    then: tokens + token
    else: tokens

defn tight-token-depth(depth char open close quoted):
  cond:
    quoted: depth
    char == open: depth.++
    char == close: max(0 depth.--)
    else: depth

defn bad-tight-token-quote?(token):
  quote =: C(34):S
  quote.in?(token) &&:
    tight-token-quoted?(token).! &&
    compact-enum-token?(token).!

defn base-primary-token?(token):
  normal =:
    token =~ /^\+[A-Za-z_][A-Za-z0-9_\/-]*(?:\{[^\}]*\})?(?:\[[^\]]*\])?~?$/
  primary =: external-ref-form?(token) ||
    compact-combinator-token?(token) ||
    typed-map-primary-token?(token) || normal
  primary ||: token.starts?('type:')

defn typed-map-primary-token?(token):
  token =~ /^(?:type:)?\+Map\{\+[A-Za-z_][A-Za-z0-9_\/-]*\}(?:\[[^\]]*\])?~?$/

defn expand-primary-token(token):
  when compact-enum-token?(token):
    usage: 'compact enum requires a preceding type reference'
  primary =: parse-primary(token)
  result =: primary.block
  result =:
    if primary.suffix:
      then:
        suffix =: list-directives(primary.suffix)
        merge-directives: result suffix 'value list suffix'
      else: result
  if primary.null:
    then: merge-directives(result {'.null' true} 'nullable suffix')
    else: result

defn parse-yaml-scalar(token):
  ys::yaml/load: token

defn parse-primary(token):
  null =: token.ends?('~')
  token =: null.if(token.replace(/~$/) token)
  pattern =:
    /^(?:type:)?\+Map\{(\+[A-Za-z_][A-Za-z0-9_\/-]*)\}(\[[^\]]*\])?$/
  map-match =: re-matches(pattern token)
  cond:
    external-ref-form?(token): external-ref-primary(token null)
    old-compact-combinator-token?(token):
      reject-old-compact-combinator(token)
    old-map-parameter-token?(token): reject-old-map-parameters(token)
    compact-combinator-token?(token):
      compact-combinator-primary(token null)
    map-match: typed-map-primary(map-match null)
    map-parameter-token?(token): reject-map-parameters(token)
    else: normal-primary(token null)

defn external-ref-form?(token):
  token =~ /^\+Ref\(.*\)(?:\[[^\]]*\])?~?$/

defn external-ref-primary(token null):
  match =: re-matches(/^\+Ref\(([^\)]*)\)(\[[^\]]*\])?$/ token)
  when match.!:
    usage: 'invalid external reference; use +Ref(reference)'
  reference =: match.1
  when reference:empty?:
    usage: 'compact external reference cannot be empty; use .xref'
  when reference =~ /\s/:
    usage: 'compact external reference cannot contain whitespace; use .xref'
  =>: +{'block' {'.xref' reference},
        'suffix' match.2, 'null' null}

defn old-map-parameter-token?(token):
  pattern =:
    re-pattern:
      str: +
        '^(?:type:)?\+Map\[\+'
        '[A-Za-z_][A-Za-z0-9_\/-]*(?:,[^\]]+)?\]'
        '(?:\[[^\]]*\])?$'
  token =~: pattern

defn reject-old-map-parameters(token):
  usage: "unsupported map parameter syntax: $token; use +Map{+Type}"

defn map-parameter-token?(token):
  token =~ /^(?:type:)?\+Map\{[^\}]*\}(?:\[[^\]]*\])?$/

defn reject-map-parameters(token):
  body =: token.replace(/^(?:type:)?\+Map\{/).replace(/\}.*$/)
  if ','.in?(body):
    usage: '+Map{+Key,+Value} is reserved but not supported yet'
    usage: '+Map requires exactly one value type reference'

defn compact-combinator-token?(token):
  pattern =:
    /^\+(One|Any|All|Not)\(([^\)]*)\)(?:\[[^\]]*\])?~?$/
  token =~: pattern

defn old-compact-combinator-token?(token):
  named =:
    token =~ /^\+(?:One|All|Not)\[[^\]]*\](?:\[[^\]]*\])?~?$/
  any =:
    token =~ /^\+Any\[\s*\+[^\]]*\](?:\[[^\]]*\])?~?$/
  named ||: any

defn reject-old-compact-combinator(token):
  replacement =:
    token.replace(/^(\+(?:One|Any|All|Not))\[/ '$1(')
      .replace1(/\]/ ')')
  usage: "unsupported compact combinator syntax: $token; use $replacement"

defn compact-combinator-primary(token null):
  pattern =:
    /^\+(One|Any|All|Not)\(([^\)]*)\)(\[[^\]]*\])?$/
  match =: re-matches(pattern token)
  name =: match.1
  members =: compact-combinator-members(name match.2)
  directive =: +{'One' '.one', 'Any' '.any',
                  'All' '.all', 'Not' '.not'}.$name
  branches =: vec(members.map(expand-type))
  block =:
    if name == 'Not':
      then:
        negated =:
          if members.# == 1:
            then: branches.0
            else: +{'.any' branches}
        =>: +{directive negated}
      else: +{directive branches}
  =>: +{'block' block, 'suffix' match.3, 'null' null}

defn compact-combinator-members(name body):
  members =: body.split(',').map(trim):vec
  minimum =: name.eq('Not').if(1 2)
  too-few =: body:trim:empty? || (members.# < minimum)
  when too-few:
    requirement =:
      minimum.eq(1).if('one type reference' 'two type references')
    usage: "+$name requires at least $requirement"
  when-not members.every?(type-symbol?):
    usage: "+$name accepts only type references"
  =>: members

defn typed-map-primary(match null):
  +{'block' typed-map-block(match.1),
    'suffix' match.2, 'null' null}

defn normal-primary(token null):
  match =: re-matches(/^(.*?)(\[[^\]]*\])$/ token)
  suffix =: match.when(match.2)
  token =: match.if(match.1 token)
  result =:
    +{'block' primary-block(token), 'suffix' suffix, 'null' null}
  =>: result

defn typed-map-block(value-type):
  +{WILDCARD-KEY expand-type(value-type)}

defn primary-block(token):
  cond:
    token.starts?('+Ref'):
      usage: 'invalid external reference; use +Ref(reference) or .xref'
    token.starts?('type:'): labeled-type-block(token)
    token.starts?('=~'):
      +{'.type' '+Str', '.like'
        anchored-pattern(tight-string-value(token.replace(/^=~/)))}
    token.starts?('match:'):
      +{'.type' '+Str', '.like'
        anchored-pattern(tight-label-string(token))}
    token.starts?('find:'):
      +{'.type' '+Str', '.like' tight-label-string(token)}
    token.starts?('range:'):
      range-block(tight-label-raw(token) nil)
    exclusive-range-modifier?(token):
      usage: "$token requires a preceding range"
    token.starts?('const:') || token.starts?('=='):
      usage: 'const requires a preceding type reference'
    old-tight-keyword?(token): reject-old-tight-keyword(token)
    token == '+Map': +{'.type' '+Map'}
    type-symbol?(token): +{'.type' token}
    regex-literal-token?(token):
      +{'.type' '+Str', '.like' regex-pattern(token)}
    slash-delimited-token?(token):
      usage: 'regex literals cannot contain /; use find:"..."'
    compact-enum-token?(token):
      usage: 'compact enum requires a preceding type reference'
    token =~ /\|/:
      usage: 'pipe enums are unsupported; use +Base [a,b]'
    ambiguous-exclusive-range?(token):
      reject-ambiguous-exclusive-range: token
    range-literal?(token): range-block(token nil)
    token.starts?('+Map('):
      usage: "unsupported map parameter syntax: $token; use +Map{+Type}"
    token.starts?('+'):
      usage: "invalid yamlschema type expression: $token"
    else: literal-block(parse-yaml-scalar(token))

defn expand-tight-token(result token):
  cond:
    type-symbol?(token): append-all-reference(result token)
    need-token?(token):
      merge-directives:
        result compact-need-block(token) 'need clause'
    token.starts?(':need'):
      usage: "invalid yamlschema need clause: $token"
    exclusive-range-modifier?(token):
      directive =: token.replace(/^:/ '.')
      merge-directives:
        result {directive true} "range modifier $token"
    token.starts?('=~'):
      merge-directives:
        result
        {'.like' anchored-pattern(
          tight-string-value(token.replace(/^=~/)))}
        'match clause'
    regex-literal-token?(token):
      merge-directives:
        result {'.like' regex-pattern(token)} 'pattern clause'
    slash-delimited-token?(token):
      usage: 'regex literals cannot contain /; use find:"..."'
    ambiguous-exclusive-range?(token):
      reject-ambiguous-exclusive-range: token
    range-literal?(token):
      merge-directives: result range-block(token result.'.type') 'range clause'
    compact-enum-token?(token):
      merge-directives:
        result compact-enum-block(token result.'.type') 'enum clause'
    token.starts?('=='):
      raw =: token.replace(/^=/).replace(/^=/)
      merge-directives:
        result const-block(raw result.'.type') 'const clause'
    token.starts?('='):
      merge-directives:
        result {'.init' tight-data-value(token.replace(/^=/))} 'default clause'
    tight-quoted?(token):
      merge-directives:
        result {'.desc' tight-string-value(token)} 'description clause'
    labeled-tight-token?(token):
      merge-directives:
        result labeled-tight-block(token result) "$(tight-label(token)) clause"
    token =~ /\|/:
      usage: 'pipe enums are unsupported; use +Base [a,b]'
    size-token?(token):
      merge-directives:
        result {'.size' normalize-size(token)} 'size clause'
    else:
      usage: "invalid or out-of-order yamlschema clause: $token"

defn need-token?(token):
  token =~ /^:need\([^\)]*\)$/

defn compact-need-block(token):
  body =: token.replace(/^:need\(/).replace(/\)$/)
  values =: body:empty?.if([] body.split(',').map(trim):vec)
  when values.some(empty?):
    usage: "invalid yamlschema need clause: $token"
  identity: +{'.need' validate-need-value(values)}

defn validate-need-value(value):
  when-not sequential?(value):
    usage: 'yamlschema .need requires a sequence of property names'
  names =: vec(value)
  when-not names.every?(string?):
    usage: 'yamlschema .need property names must be strings'
  when distinct(names):count != names.#:
    usage: 'yamlschema .need property names must be unique'
  =>: names

defn append-all-reference(result token):
  branches =: result.'.all' || []
  ordered-directives:
    result + {'.all' vec(branches + expand-type(token))}

defn regex-literal-token?(token):
  token =~ /^\/[^\/\s]*\/$/

defn slash-delimited-token?(token):
  token.starts?('/') && token.ends?('/')

defn type-symbol?(token):
  valid =: token =~ /^\+[A-Za-z_][A-Za-z0-9_\/-]*$/
  when valid:
    if token.starts?('+JSON-Schema/'):
      then: validate-json-schema-format-type(token)
      else:
        when token =~ /^\+[A-Z]/:
          name =: token.replace(/^\+/)
          when-not BUILT-IN-TYPE-NAMES.has?(name):
            usage: "unknown yamlschema built-in type: $token"
  =>: valid

defn validate-json-schema-format-type(type):
  format =: type.replace(/^\+JSON-Schema\//)
  when-not JSON-SCHEMA-FORMATS.has?(format):
    usage: "unknown JSON Schema format type: $type"
  =>: type

defn json-schema-format-type?(type):
  string?(type) &&
    type.starts?('+JSON-Schema/') &&
    JSON-SCHEMA-FORMATS.has?(type.replace(/^\+JSON-Schema\//))

defn json-schema-format-name(type):
  validate-json-schema-format-type(type).replace(/^\+JSON-Schema\//)

defn direct-type-symbol?(token):
  list-pattern =:
    re-pattern:
      str: +
        '^\+[A-Za-z_][A-Za-z0-9_\/-]*'
        '(?:\{\+[A-Za-z_][A-Za-z0-9_\/-]*\})?\[\]$'
  result =: type-symbol?(token) ||
    (token =~ list-pattern) ||
    (token =~ /^\+Map\{\+[A-Za-z_][A-Za-z0-9_\/-]*\}$/)
  =>: result

defn labeled-type-block(token):
  type =: tight-label-string(token)
  when-not type-symbol?(type):
    usage: "invalid yamlschema type reference: $type"
  =>: +{'.type' type}

defn reject-bare-map():
  usage: 'incomplete +Map type requires key/value pairs'

defn compact-enum-token?(token):
  token =~ /^(?:enum:)?\[[^\]]*\]$/

defn labeled-tight-token?(token):
  token =~ /^[A-Za-z]+:/

defn tight-label(token):
  token.replace(/:.*$/)

defn tight-label-raw(token):
  token.replace(/^[^:]+:/)

defn tight-quoted?(value):
  text =: value:S
  text =~: /^"[^"]*"$/

defn tight-token-quoted?(token):
  raw =:
    cond:
      token.starts?('=~'): token.replace(/^=~/)
      token.starts?('=='): token.replace(/^=/).replace(/^=/)
      token.starts?('='): token.replace(/^=/)
      labeled-tight-token?(token): tight-label-raw(token)
      else: token
  tight-quoted?: raw

defn tight-string-value(raw):
  if tight-quoted?(raw):
    decode-tight-string(raw.replace(/^./).replace(/.$/)) raw

defn tight-data-value(raw):
  if tight-quoted?(raw):
    tight-string-value: raw
    parse-yaml-scalar: raw

defn tight-label-string(token):
  tight-string-value: tight-label-raw(token)

defn old-tight-keyword?(token):
  labeled-tight-token?(token) &&
  tight-label(token).in?(
    qw(base titl just only like mini maxi pick oneof anyof allof))

defn reject-old-tight-keyword(token):
  key =: tight-label(token)
  replacements =: +{'base' 'type', 'titl' 'title', 'just' 'const',
                    'only' 'const', 'like' 'match',
                    'mini' 'range', 'maxi' 'range',
                    'pick' 'one', 'oneof' 'one',
                    'anyof' 'any', 'allof' 'all'}
  usage: "unsupported yamlschema keyword: $key; use $(replacements.$key)"

defn labeled-tight-block(token result):
  when old-tight-keyword?(token):
    reject-old-tight-keyword: token
  name =: tight-label(token)
  raw =: tight-label-raw(token)
  key =: ".$name"
  case name:
    'type': labeled-type-block(token)
    'match': +{'.like' anchored-pattern(tight-string-value(raw))}
    'find': +{'.like' tight-string-value(raw)}
    'const': const-block(raw result.'.type')
    'enum': usage('enum requires a bracketed value list')
    'range': range-block(raw result.'.type')
    'size': +{key normalize-size(tight-string-value(raw))}
    'list': reject-list-keyword()
    'item': +{key expand-type(tight-string-value(raw))}
    'solo': boolean-label-block(key raw)
    'uniq': boolean-label-block(key raw)
    'null': boolean-label-block(key raw)
    'init': +{key tight-data-value(raw)}
    'title': +{key tight-string-value(raw)}
    'desc': +{key tight-string-value(raw)}
    'also': +{key tight-string-value(raw)}
    'one': structural-tight-label-error(name)
    'any': structural-tight-label-error(name)
    'all': structural-tight-label-error(name)
    'not': structural-tight-label-error(name)
    'with': structural-tight-label-error(name)
    'need':
      usage('unsupported yamlschema keyword:\ need; use :need(...)')
    'when': structural-tight-label-error(name)
    else: usage("unsupported yamlschema keyword $name")

defn boolean-label-block(key raw):
  value =: tight-data-value(raw)
  when-not boolean?(value):
    usage: "yamlschema $key requires true or false"
  =>: +{key value}

defn structural-tight-label-error(name):
  usage: "yamlschema $name requires an explicit structural value"

defn const-block(raw base):
  when-not base:
    usage: 'const requires a preceding type reference'
  when raw.empty?:
    usage: 'const requires a value'
  text =: tight-string-value(raw)
  value =:
    if base.eq('+Str') || tight-quoted?(raw):
      text parse-yaml-scalar(text)
  =>: +{'.const' value}

defn literal-block(value):
  +{'.type' infer-base([value]), '.const' value}

defn compact-enum-block(token base):
  when-not base:
    usage: 'compact enum requires a preceding type reference'
  body =: token.replace(/^enum:/).replace(/^\[/).replace(/\]$/)
  when body:trim:empty?:
    usage: 'compact enum must contain at least one value'
  raw =: body.split(',').map(trim):vec
  defaults =: raw.filter(\(_.starts?('=')))
  when defaults.# > 1:
    usage: 'compact enum can mark only one default'
  members =: raw.map(\(_.replace(/^=/):trim)):vec
  when members.some(empty?):
    usage: 'compact enum default must have a value'
  when members.some(\(_.starts?('"'))):
    usage: 'quoted values are not allowed in compact enum; use .enum'
  when-not members.every?(safe-compact-enum-token?):
    prefix =: 'compact enum values allow alphanumerics, whitespace, '
    usage: "$prefix.-_+; use .enum"
  values =:
    if base.eq('+Str'):
      members
      vec(members.map(parse-yaml-scalar))
  result =: +{'.enum' values}
  if defaults:seq:
    then:
      token =: defaults.0.replace(/^=/):trim
      value =: base.eq('+Str').if(token parse-yaml-scalar(token))
      result +: +{'.init' value}
    else: result

defn safe-compact-enum-token?(token):
  token =~ /^[A-Za-z0-9._+\-\s]+$/

defn infer-base(values):
  bases =: values.map(base-for-value):set
  cond:
    bases == \{'+Int' '+Float'}: '+Num'
    bases.# == 1: bases:first
    else:
      usage: 'cannot infer a common enum type; add an explicit type reference'

defn base-for-value(value):
  cond:
    string?(value): '+Str'
    integer?(value): '+Int'
    number?(value): '+Float'
    boolean?(value): '+Bool'
    nil?(value): '+Null'
    map?(value): '+Map'
    else: '+Any'

defn json-infer-base(values):
  bases =: values.map(json-base-for-value):set
  cond:
    bases == \{'+Int' '+Num'}: '+Num'
    bases.# == 1: bases:first
    else: '+Any'

defn json-base-for-value(value):
  cond:
    integer?(value): '+Int'
    number?(value): '+Num'
    else: base-for-value(value)

defn range-block(value base):
  info =: range-info(value)
  range =: info.range
  inferred =:
    base || range-number-type(range).eq('integer').if('+Int' '+Num')
  result =:
    if base:
      then: +{}
      else: +{'.type' inferred}
  result =: result + {'.range' range}
  result =: map-put-if(result info.xmin '.xmin' true)
  map-put-if: result info.xmax '.xmax' true

defn range-info(value):
  if sequential?(value):
    then: +{'range' normalize-range-sequence(value)}
    else: range-expression-info(value)

defn normalize-range(value):
  range-info(value).range

defn normalize-range-sequence(value):
  range =: vec(value)
  when-not range.#.in?([1 2]):
    usage: '.range array must contain one or two bounds'
  when range.every?(nil?):
    usage: '.range must contain at least one bound'
  when range.some(\(nil?(_).! && number?(_).!)):
    usage: '.range bounds must be numbers or null'
  open-upper =: range.#.eq(2) && range.1:nil?
  if open-upper:
    V+: range.0
    identity: range

defn normalize-range-expression(value):
  range-expression-info(value).range

defn range-expression-info(value):
  text =: value:S
  when ambiguous-exclusive-range?(text):
    reject-ambiguous-exclusive-range: text
  when-not range-literal?(text):
    usage: "invalid yamlschema range: $text"
  xmin =: lower-exclusive-range-literal?(text)
  xmax =: upper-exclusive-range-literal?(text)
  text =: xmin.if(text.replace(/\.\.\.$/ '..') text)
  text =: xmax.if(text.replace(/^\.\.\./ '..') text)
  lo-text =: text.replace(/\.\..*$/)
  hi-text =: text.replace(/^.*\.\./)
  lo =:
    when-not lo-text:empty?:
      scalar-number: lo-text
  hi =:
    when-not hi-text:empty?:
      scalar-number: hi-text
  range =:
    normalize-range-sequence: lo:nil?.if([nil hi] hi:nil?.if([lo] [lo hi]))
  result =: +{'range' range}
  result =: map-put-if(result xmin 'xmin' true)
  map-put-if: result xmax 'xmax' true

defn exclusive-range-modifier?(token):
  token.in?([':xmin' ':xmax'])

defn validate-exclusive-range-directives(value):
  validate-exclusive-range-directive: value '.xmin' 0
  validate-exclusive-range-directive: value '.xmax' 1
  =>: value

defn validate-exclusive-range-directive(value key index):
  when value.has?(key):
    validate-exclusive-range-value: key value.$key
    when-not value.has?('.range'):
      usage: "yamlschema $key requires a .range directive"
    range =: normalize-range(value.'.range')
    in-range =: range.# > index
    bound-present =: nil?(range.$index).!
    has-bound =: in-range && bound-present
    when-not has-bound:
      bound =: key.eq('.xmin').if('lower' 'upper')
      article =: key.eq('.xmin').if('a' 'an')
      usage: "yamlschema $key requires $article $bound range bound"

defn range-number-type(range):
  values =: range.remove(nil?)
  if values.every?(integer?): +
    'integer'
    'number'

defn list-directives(suffix):
  props =: parse-list-suffix(suffix)
  result =: +{'.list' true}
  result =: map-put-if(result props.uniq '.uniq' true)
  result =: map-put-if(result props.solo '.solo' true)
  if props.size.?:
    then:
      ordered-directives: result + {'.size' normalize-size(props.size)}
    else: ordered-directives(result)

defn parse-list-suffix(suffix):
  body =: suffix.replace(/^\[/).replace(/\]$/):trim
  when '|'.in?(body):
    usage: 'unsupported | in list suffix; use comma'
  size-pattern =: /[0-9]+(?:-[0-9]+|\+)?|\+/
  sizes =: vec(re-seq(size-pattern body))
  when sizes.# > 1:
    usage: 'list suffix contains multiple size constraints'
  solos =: count(re-seq(/\$/ body))
  uniques =: count(re-seq(/!/ body))
  when solos > 1:
    usage: 'list suffix contains duplicate $ flag'
  when uniques > 1:
    usage: 'list suffix contains duplicate ! flag'
  property-count =: sizes.# + solos + uniques
  when body.? && property-count:zero?:
    usage: "invalid yamlschema list suffix: $suffix"
  extra =: body
    .replace(size-pattern)
    .replace(/[\$!,\s]/)
  when extra:empty?.!:
    usage: "invalid yamlschema list suffix: $suffix"
  size =: sizes.0
  size =: size.eq('+').if('1+' size)
  =>::
    size:: size
    solo:: solos == 1
    uniq:: uniques == 1

defn size-token?(value):
  value:S =~ /^(?:[0-9]+|[0-9]+-[0-9]+|[0-9]+\+)$/

defn normalize-size(value):
  if sequential?(value):
    then:
      value =: vec(value)
      when value.some(\(_ == '*')):
        usage: 'unsupported .size "*" bound; use 1+ or [1]'
      when-not value.#.in?([1 2]):
        usage: '.size array must contain one or two numbers'
      =>: value
    else:
      text =: value:S
      cond:
        text =~ /^[0-9]+$/:
          +[scalar-number(text) scalar-number(text)]
        text =~ /^[0-9]+\+$/: +[scalar-number(text.replace(/\+$/))]
        text =~ /^[0-9]+-[0-9]+$/:
          lo hi =: text.split('-')
          V+: scalar-number(lo) scalar-number(hi)
        else:
          usage: "invalid yamlschema size: $text"

# --------------------------------------------------------------------
# Convert yamlschema DSL data back to JSON Schema.
# --------------------------------------------------------------------

defn ysdc-to-schema(doc root-before):
  state =: reduce(ysdc-doc-step initial-ysdc-doc-state(doc) doc)
  parts =: split-document-schema(state.result)
  metadata =: parts.metadata
  root =: parts.root
  defs-val =: state.defs
  root-fields =:
    state.wildcard ||
    state.props:seq ||
    state.patterns:seq ||
    doc.has?('.keys') ||
    doc.has?('.size')
  when state.explicit-root && root-fields:
    usage: 'yamlschema .root cannot be combined with top-level fields'
  has-root-mapping =:
    state.explicit-root.! && (root-fields || defs-val:empty?)
  defs =: map-put-if(omap() empty?(defs-val).! '$defs' defs-val)
  root =: add-root-schema(root state has-root-mapping)
  if root-before:
    merge-ordered-maps: metadata root defs
    merge-ordered-maps: metadata defs root

defn split-document-schema(result):
  reduce split-document-schema-entry: document-schema-parts() result

defn document-schema-parts()::
  metadata:: omap()
  root:: omap()

defn split-document-schema-entry(parts entry):
  slot =: json-document-metadata-key?(entry.0).if('metadata' 'root')
  value =: ordered-put(parts.$slot entry.0 entry.1)
  parts +: +{slot value}

defn json-document-metadata-key?(key):
  key:S.in?([
    '$comment' '$id' '$schema' '$anchor' 'title' 'description'])

defn add-root-schema(result state has-root-mapping):
  reqs =: state.required
  result :if has-root-mapping +=:: {type: object}
  result =: result
    .map-put-if(empty?(state.props).! 'properties' state.props)
    .map-put-if(empty?(state.patterns).!
                'patternProperties' state.patterns)
    .map-put-if(empty?(reqs).! 'required' reqs)
    .map-put-if(empty?(state.dependent).!
                'dependentRequired' state.dependent)
  if has-root-mapping:
    if state.wildcard:
      then:
        if state.additional == true:
          then: result
          else: result + {'additionalProperties' state.additional}
      else:
        if state.open:
          then: result
          else: result + {'additionalProperties' false}
    else: result

defn ysd-root-before-named-types?(doc):
  keys =: doc:keys.remove(\(ysd-order-ignored-key?(_)))
  first =: keys:first
  and:
    first.?
    named-type-key?(first).!

defn ysd-order-ignored-key?(key):
  text =: key:S
  and:
    text.starts?('.')
    (text != '.root')

defn named-type-key?(key):
  text =: key:S
  and:
    text.starts?('+')
    (text != WILDCARD-KEY)

defn initial-ysdc-doc-state(doc):
  result =: add-ysid-meta(omap() doc.'.ysid')
  =>::
    result:: result + {'$schema' JSON-SCHEMA-DIALECT}
    defs:: omap()
    props:: omap()
    patterns:: omap()
    required: []
    dependent:: omap()
    open:: doc.get('.open' false)
    explicit-root:: false
    wildcard: false
    additional:

defn ysdc-doc-step(state entry):
  key =: entry.0:S
  value =: entry.1
  cond:
    key == '.root':
      schema =: ysdc-value-to-schema(value state.open)
      state +::
        result:: merge-ordered-maps(state.result schema)
        explicit-root:: true
    key == WILDCARD-KEY:
      state +::
        wildcard:: true
        additional:: wildcard-value-to-schema(value)
    pattern-property-key?(key):
      add-pattern-property-schema: state key value
    key =~ /^\+/:
      name =: key.replace(/^\+/)
      schema =: ysdc-value-to-schema(value state.open)
      update-state: state 'defs' name schema
    key =~ /^\./:
      result =: add-schema-meta(state.result key value state.open)
      state +: +{'result' result}
    legacy-directive?(key):
      reject-legacy-directive: key
    else:
      add-property-schema: state key value

defn update-state(state slot key value):
  state +: +{slot ordered-put(state.$slot key value)}

defn add-property-schema(state key value):
  info =: parse-property-key(key)
  has-need =: map?(value) && contains?(value '.need')
  needs =: has-need.when(validate-need-value(value.'.need'))
  schema-value =: has-need.if(without-property-need(value) value)
  schema =: ysdc-value-to-schema(schema-value state.open)
  state =: update-state(state 'props' info.name schema)
  state =:
    if info.required:
      then: state + {'required' (state.required + info.name)}
      else: state
  state =:
    if has-need:
      then: update-state(state 'dependent' info.name needs)
      else: state
  =>: state

defn add-pattern-property-schema(state key value):
  when map?(value) && contains?(value '.need'):
    usage: 'yamlschema regex keys cannot use .need'
  pattern =: pattern-property-name(key)
  schema =: ysdc-value-to-schema(value state.open)
  update-state: state 'patterns' pattern schema

defn without-property-need(value):
  reduce remove-property-need: omap() value

defn remove-property-need(result entry):
  if entry.0:S == '.need':
    then: result
    else: ordered-put(result entry.0 entry.1)

defn add-schema-meta(result key value inherited-open=false):
  case key:
    '.ysid': result
    '.name': result + {'$anchor' validate-schema-name(value)}
    '.title': result + {'title' value}
    '.Name': reject-title-directive(key)
    '.desc': result + {'description' value}
    '.open': result
    '.one': add-root-one-schema(result value)
    '.keys': add-key-rules-schema(result value inherited-open)
    '.size': add-root-size-schema(result value)
    '.additionalProperties':
      reject-additional-properties: key
    else:
      if passthrough-directive?(key):
        then: add-passthrough-schema-keyword(result key value)
        else: result

defn add-root-size-schema(result size):
  lo =: size.0
  hi =: size.#.eq(2).when(size.1)
  add-canonical-bounds:
    result lo hi 'minProperties' 'maxProperties'

defn add-root-one-schema(result branches):
  when result.has?('oneOf'):
    usage: 'duplicate root oneOf from yamlschema .one'
  schemas =: branches.map(root-one-branch-to-schema):vec
  result +: +{'oneOf' schemas}

defn root-one-branch-to-schema(branch):
  when-not map?(branch):
    =>: ysdc-value-to-schema branch true
  parts =: reduce(split-root-one-branch root-one-branch-parts() branch)
  directives =: parts.directives
  result =:
    if empty?(directives):
      then: omap()
      else: ysdc-block-to-schema(directives true)
  partial =: partial-object-schema(parts.fields true)
  merge-ordered-maps: result partial

defn root-one-branch-parts()::
  directives:: omap()
  fields:: omap()

defn split-root-one-branch(parts entry):
  key =: entry.0:S
  slot =: key.starts?('.').if('directives' 'fields')
  parts +: +{slot ordered-put(parts.$slot key entry.1)}

defn partial-object-schema(fields inherited-open=false):
  state =:
    reduce(ysdc-object-step initial-object-state(inherited-open) fields)
  result =: omap()
  result =: result.map-put-if(
    empty?(state.props).! 'properties' state.props)
  result =: result.map-put-if(
    empty?(state.required).! 'required' state.required)
  result =: result.map-put-if(
    empty?(state.dependent).! 'dependentRequired' state.dependent)
  if state.wildcard && (state.additional != true):
    then: result + {'additionalProperties' state.additional}
    else: result

defn add-key-rules-schema(result rules inherited-open=false):
  schemas =: rules.map(
    \(key-rule-to-schema(_ inherited-open))):vec
  if count(schemas).eq(1):
    then:
      when result.has?('anyOf'):
        usage: 'duplicate root anyOf from yamlschema .keys'
      result +: schemas.0
    else:
      when result.has?('allOf'):
        usage: 'duplicate root allOf from yamlschema .keys'
      result +: +{'allOf' schemas}

defn key-rule-to-schema(rule inherited-open=false):
  alternatives =: rule.'.any'.map(
    \(key-rule-branch-to-schema(_ inherited-open))):vec
  =>: +{'anyOf' alternatives}

defn key-rule-branch-to-schema(branch inherited-open=false):
  partial-object-schema: branch inherited-open

defn legacy-directive?(key):
  key =~ /^-/

defn reject-legacy-directive(key):
  when key == '-additionalProperties':
    reject-additional-properties: key
  replacement =:
    if key == '-base':
      then: '.type'
      else: key.replace(/^-/ '.')
  usage: "unsupported yamlschema directive: $key; use $replacement"

defn reject-additional-properties(key):
  usage: "unsupported yamlschema directive: $key; use +Str"

defn reject-title-directive(key):
  usage: "unsupported yamlschema directive: $key; use .title"

defn reject-json-meta():
  usage: 'unsupported yamlschema directive: .json; use .ysid'

defn renamed-directive?(key):
  key.in?(['.base', '.titl', '.just', '.only', '.mini', '.maxi',
           '.pick', '.oneof', '.anyof', '.allof'])

defn reject-renamed-directive(key):
  replacements =:
    +{'.base' '.type', '.titl' '.title', '.just' '.const',
      '.only' '.const',
      '.mini' '.range', '.maxi' '.range', '.pick' '.one',
      '.oneof' '.one', '.anyof' '.any', '.allof' '.all'}
  usage: "unsupported yamlschema directive: $key; use $(replacements.$key)"

defn add-ysid-meta(result value):
  if value:nil?:
    then: result
    else:
      id =: canonical-document-id(value 'jsc' '.ysid')
      result +: +{'$id' id}

defn parse-property-key(key):
  when key-list-suffix?(key):
    reject-key-list-suffix: key
  optional-after-name =: key =~ /\?$/
  k =: key
  k =: k.replace(/\?$/)
  when pattern-property-key?(k):
    usage: "yamlschema exact property name $k conflicts with regex key syntax"
  required =: optional-after-name.!
  =>::
    name:: k
    required:: required

defn pattern-property-key?(key):
  text =: key:S
  and:
    text.# >= 2
    text.starts?('/')
    text.ends?('/')

defn pattern-property-name(key):
  key:S.replace(/^\//).replace(/\/$/)

defn pattern-property-key(pattern):
  "/$pattern/"

defn ysdc-value-to-schema(value inherited-open=false):
  if map?(value):
    ysdc-map-to-schema: value inherited-open
    ysdc-scalar-to-schema: value

defn wildcard-value-to-schema(value inherited-open=false):
  schema =: ysdc-value-to-schema(value inherited-open)
  if empty?(schema):
    then: true
    else: schema

defn ysdc-map-to-schema(value inherited-open=false):
  explicit =: some(\(_:S =~ /^\./) value:keys)
  explicit =: value:keys.some(\(/^\./))
  if explicit:
    ysdc-block-to-schema: value inherited-open
    ysdc-object-to-schema: value inherited-open

defn ysdc-object-to-schema(value inherited-open=false):
  state =:
    reduce(ysdc-object-step initial-object-state(inherited-open) value)
  reqs =: state.required
  result =: +{'type' 'object'}
  result =: map-put-if(result empty?(reqs).! 'required' reqs)
  result =: map-put-if(result empty?(state.props).! 'properties' state.props)
  result =:
    map-put-if(
      result empty?(state.patterns).!
      'patternProperties' state.patterns)
  result =: map-put-if(
    result empty?(state.dependent).!
    'dependentRequired' state.dependent)
  if state.wildcard:
    then:
      if state.additional == true:
        then: result
        else: result + {'additionalProperties' state.additional}
    else:
      if state.open:
        then: result
        else: result + {'additionalProperties' false}

defn initial-object-state(open=false)::
  props:: omap()
  patterns:: omap()
  required: []
  dependent:: omap()
  open:: open
  wildcard: false
  additional:

defn ysdc-object-step(state entry):
  key =: entry.0:S
  cond:
    key == WILDCARD-KEY:
      state +::
        wildcard:: true
        additional:: wildcard-value-to-schema(entry.1 state.open)
    pattern-property-key?(key):
      add-pattern-property-schema: state key entry.1
    legacy-directive?(key):
      reject-legacy-directive: key
    else:
      add-property-schema: state key entry.1

defn ysdc-block-to-schema(value inherited-open=false):
  when contains?(value '.need'):
    reject-misplaced-need-directive()
  reject-unexportable-directives: value
  list =: canonical-list-type?(value)
  local-open =: value.get('.open' inherited-open)
  native-value =: without-passthrough-directives(value)
  item-value =: list.if(canonical-list-item(native-value) native-value)
  item =: canonical-item-schema(item-value local-open)
  shape =: canonical-shape-schema(item-value inherited-open)
  item =: shape.if(merge(item shape) item)
  result =:
    if list:
      then: canonical-list-schema(item value)
      else: canonical-sized-schema(item value.'.size')
  result =: add-passthrough-schema-keywords(result value)
  result =: add-canonical-annotations(result value)
  add-null-schema: result value.'.null'

defn without-passthrough-directives(value):
  reduce remove-passthrough-directive: omap() value

defn remove-passthrough-directive(result entry):
  if passthrough-directive?(entry.0:S):
    then: result
    else: ordered-put(result entry.0 entry.1)

defn canonical-list-type?(value):
  reference =: value.'.type'
  string?(reference) &&: reference.ends?('[]')

defn canonical-list-item(value):
  reference =: value.'.type'.replace(/\[\]$/)
  value +: +{'.type' reference}

defn reject-unexportable-directives(value):
  unsupported =: +['.also', '.with', '.when']
  each key unsupported:
    when contains?(value key):
      usage: "cannot export yamlschema directive to JSON Schema: $key"

defn canonical-item-schema(value inherited-open=false):
  result =:
    if value.has?('.type'):
      ysdc-bare-scalar-to-schema: value.'.type'
      else: +{}
  result =: map-put-if(result contains?(value '.xref')
    '$ref' value.'.xref')
  result =:
    if contains?(value '.item'):
      ysdc-value-to-schema: value.'.item' inherited-open
      else: result
  result =: map-put-if(result contains?(value '.like')
    'pattern' value.'.like')
  result =: map-put-if(result contains?(value '.enum')
    'enum' value.'.enum')
  result =:
    if contains?(value '.const'):
      then: dissoc(result 'type') + {'const' value.'.const'}
      else: result
  result =:
    if contains?(value '.range'):
      then: result + dissoc(range-to-schema(value.'.range') 'type')
      else: result
  result =: add-exclusive-range-schema(result value)
  add-canonical-combinators: result value inherited-open

defn add-exclusive-range-schema(result value):
  validate-exclusive-range-directives: value
  result =: map-put-if(
    result value.has?('.xmin') 'exclusiveMinimum' true)
  map-put-if: result value.has?('.xmax') 'exclusiveMaximum' true

defn add-passthrough-schema-keywords(result value):
  reduce add-passthrough-schema-entry: result value

defn add-passthrough-schema-entry(result entry):
  key =: entry.0:S
  if passthrough-directive?(key):
    then: add-passthrough-schema-keyword(result key entry.1)
    else: result

defn add-passthrough-schema-keyword(result directive value):
  keyword =: passthrough-keyword(directive)
  when contains?(result keyword):
    usage: str(
      'duplicate JSON Schema keyword from yamlschema directive'
      C(58) ' ' directive)
  result +: +{keyword value}

defn add-canonical-combinators(result value inherited-open=false):
  result =: add-canonical-combinator(
    result value '.one' 'oneOf' inherited-open)
  result =: add-canonical-any(result value inherited-open)
  result =: add-canonical-combinator(
    result value '.all' 'allOf' inherited-open)
  if contains?(value '.not'):
    then:
      schema =: ysdc-value-to-schema(value.'.not' inherited-open)
      result +: +{'not' schema}
    else: result

defn add-canonical-any(result value inherited-open=false):
  if contains?(value '.any'):
    then:
      schemas =: value.'.any'.map(
        \(ysdc-value-to-schema(_ inherited-open))):vec
      types =: vec(schemas.map(simple-schema-type))
      type-union =: simple-type-union?(result types)
      if type-union:
        then: result + {'type' types}
        else: result + {'anyOf' schemas}
    else: result

defn simple-type-union?(result types):
  unique =: distinct(types):count
  and:
    result:empty?
    types.every?(some?)
    unique.eq(types.#)

defn simple-schema-type(schema):
  simple =:
    map?(schema) &&
    key-set(schema).eq(\{'type'}) &&
    string?(schema.type)
  when simple:
    =>: schema.type

defn add-canonical-combinator(result value directive keyword open=false):
  if contains?(value directive):
    then:
      schemas =: value.$directive.map(
        \(ysdc-value-to-schema(_ open))):vec
      result +: +{keyword schemas}
    else: result

defn canonical-shape-schema(value inherited-open=false):
  entries =: value.filter(\(_1.0:S !~ /^\./))
  when entries:seq || contains?(value '.open'):
    local-open =: value.get('.open' inherited-open)
    state =:
      reduce(ysdc-object-step initial-object-state(local-open) entries)
    result =: +{'type' 'object'}
    result =: map-put-if(result state.props:seq 'properties' state.props)
    result =:
      map-put-if:
        result state.patterns:seq
        'patternProperties' state.patterns
    result =:
      map-put-if(result state.required:seq 'required' state.required)
    result =:
      map-put-if(result state.dependent:seq
        'dependentRequired' state.dependent)
    cond:
      state.wildcard:
        if state.additional == true:
          then: result
          else: result + {'additionalProperties' state.additional}
      local-open: result
      else: result + {'additionalProperties' false}

defn canonical-list-schema(item value):
  array =: +{'type' 'array'}
  array =: map-put-if(array empty?(item).! 'items' item)
  array =: canonical-sized-schema(array value.'.size')
  array =: map-put-if(array value.'.uniq' 'uniqueItems' true)
  if value.'.solo':
    then: +{'anyOf' [item array]}
    else: array

defn canonical-sized-schema(result size):
  if size:
    then:
      lo =: size.0
      hi =: size.#.eq(2).when(size.1)
      t =: result.type
      cond:
        t == 'string': add-canonical-bounds(result lo hi
          'minLength' 'maxLength')
        t == 'array': add-canonical-bounds(result lo hi
          'minItems' 'maxItems')
        t == 'object': add-canonical-bounds(result lo hi
          'minProperties' 'maxProperties')
        else: usage('size requires a string, list, or mapping type')
    else: result

defn add-canonical-bounds(result lo hi min-key max-key):
  result =: result + {min-key lo}
  if nil?(hi):
    then: result
    else: result + {max-key hi}

defn add-canonical-annotations(result value):
  result =:
    if contains?(value '.name'):
      then: result + {'$anchor' validate-schema-name(value.'.name')}
      else: result
  result =: map-put-if(result contains?(value '.init')
    'default' value.'.init')
  result =: map-put-if(result contains?(value '.title')
    'title' value.'.title')
  map-put-if:
    result contains?(value '.desc') 'description' value.'.desc'

defn add-null-schema(result nullable):
  if nullable:
    then:
      cond:
        string?(result.type): result + {'type' [result.type 'null']}
        sequential?(result.type):
          result + {'type' vec(result.type + 'null')}
        else: +{'anyOf' [result {'type' 'null'}]}
    else: result

defn initial-block-state()::
  result:: omap()
  item:
  props:: omap()
  required: []
  wildcard: false
  additional:

defn ysdc-block-step(state entry):
  result =: state.result
  key =: entry.0:S
  val =: entry.1
  case key:
    '.type':
      state.add-base-schema(val)
    '.like':
      result +=: +{'type' 'string'}
      result +=: +{'pattern' val:S}
      state +: +{'result' result}
    '.enum':
      state + {'result' (result + {'enum' val})}
    '.init':
      state + {'result' (result + {'default' val})}
    '.list': reject-list-directive()
    '.uniq':
      state + {'result' (result + {'uniqueItems' val})}
    '.title':
      state + {'result' (result + {'title' val})}
    '.Name':
      reject-title-directive: key
    '.desc':
      state + {'result' (result + {'description' val})}
    '.item':
      state + {'item' ysdc-value-to-schema(val)}
    '.size':
      state + {'result' add-size(result val)}
    '.range':
      state +:
        +{'result' (result + dissoc(range-to-schema(val) 'type'))}
    '.additionalProperties':
      reject-additional-properties: key
    else:
      cond:
        key == WILDCARD-KEY:
          state +::
            wildcard:: true
            additional:: ysdc-value-to-schema(val)
        legacy-directive?(key):
          reject-legacy-directive: key
        key =~ /^\./:
          state
        else:
          add-property-schema(state key val)

defn add-base-schema(state val):
  result =: state.result
  schema =: ysdc-scalar-to-schema(val)
  if result.type == 'array':
    then: state + {'item' schema}
    else: state + {'result' merge(result schema)}

defn add-size(result val):
  lo =: val.0
  hi =: val.1
  t =: result.type
  case t:
    'string':
      add-bounds: result lo hi 'minLength' 'maxLength'
    'array':
      add-bounds: result lo hi 'minItems' 'maxItems'
    'object':
      add-bounds: result lo hi 'minProperties' 'maxProperties'
    else:
      add-bounds: result lo hi 'minimum' 'maximum'

defn add-bounds(result lo hi min-key max-key):
  has-lo =: lo != '*'
  has-hi =: hi != '*'
  result:
    .map-put-if(has-lo min-key lo)
    .map-put-if(has-hi max-key hi)

defn ysdc-scalar-to-schema(value):
  annotated =: split-scalar-description(value)
  result =: ysdc-bare-scalar-to-schema(annotated.type)
  has-desc =: annotated.has?('desc')
  map-put-if: result has-desc 'description' annotated.desc

defn split-scalar-description(value):
  match =:
    when string?(value):
      re-matches: /^(.+?)\s+'(.*)'$/ value
  if match:
    then: +{'base' match.1, 'desc' match.2}
    else: +{'base' value}

defn ysdc-bare-scalar-to-schema(value):
  s =: value:S
  cond:
    value-list-scalar?(s):
      value-list-to-schema(s)
    json-schema-format-type?(s):
      +{'type' 'string', 'format' json-schema-format-name(s)}
    s == '+Str': +{'type' 'string'}
    s == '+Int': +{'type' 'integer'}
    s == '+Num': +{'type' 'number'}
    s == '+Float': +{'type' 'number'}
    s == '+Bool': +{'type' 'boolean'}
    s == '+Null': +{'type' 'null'}
    s == '+Map': +{'type' 'object'}
    s == '+Any': +{}
    s =~ /^\+[A-Za-z_][A-Za-z0-9_-]*$/:
      ref-schema(s)
    regex-literal-token?(s):
      +{'type' 'string', 'pattern' regex-pattern(s)}
    s =~ /^[^|]+\|[^|]+/:
      +{'type' 'string', 'enum' split(s /\|/)}
    ambiguous-exclusive-range?(s):
      reject-ambiguous-exclusive-range: s
    range-literal?(s):
      range-to-schema(s)
    else:
      +{'const' value}

defn value-list-scalar?(s):
  s =~ /^.+\[[^\]]*\]$/

defn value-list-to-schema(s):
  suffix =: s.replace(/^.*(\[[^\]]*\])$/ '$1')
  base =: s.replace(/\[[^\]]*\]$/)
  wrap-array-schema: ysdc-bare-scalar-to-schema(base) suffix

defn range-literal?(s):
  inclusive-range-literal?(s) ||
  lower-exclusive-range-literal?(s) ||
  upper-exclusive-range-literal?(s)

defn inclusive-range-literal?(s):
  pattern =:
    /^(?:-?[0-9]+(?:\.[0-9]+)?)?\.\.(?:-?[0-9]+(?:\.[0-9]+)?)?$/
  matched =: s =~ pattern
  valid =: matched && (s != '..')
  =>: valid

defn lower-exclusive-range-literal?(s):
  s =~ /^-?[0-9]+(?:\.[0-9]+)?\.\.\.$/

defn upper-exclusive-range-literal?(s):
  s =~ /^\.\.\.-?[0-9]+(?:\.[0-9]+)?$/

defn ambiguous-exclusive-range?(s):
  s =~ /^-?[0-9]+(?:\.[0-9]+)?\.\.\.-?[0-9]+(?:\.[0-9]+)?$/

defn reject-ambiguous-exclusive-range(value):
  usage: "ambiguous yamlschema range: $value; use .. with :xmin or :xmax"

defn regex-pattern(value):
  value:S
    .replace(/^\//)
    .replace(/\/$/)

defn anchored-pattern(pattern):
  str('^' pattern '$')

defn ref-schema(s):
  name =: s.replace(/^\+/)
  +{} +: +{'$ref' str('#/$defs/' name)}

defn range-to-schema(value):
  info =: range-info(value)
  range =: info.range
  lo =: range.0
  hi =: range.#.eq(2).when(range.1)
  t =: range-number-type(range)
  result =:: {type:: t}
  has-lo =: lo:nil?.!
  has-hi =: hi:nil?.!
  result =:
    if has-lo:
      then: result + {'minimum' lo}
      else: result
  result =:
    if has-hi:
      then: result + {'maximum' hi}
      else: result
  result =: map-put-if(result info.xmin 'exclusiveMinimum' true)
  map-put-if: result info.xmax 'exclusiveMaximum' true

defn scalar-number(s):
  ys::json/load: s

defn wrap-array-schema(item suffix):
  canonical-list-schema: item list-directives(suffix)

defn unsupported-json-schema-keywords():
  +[
    '$dynamicRef', '$dynamicAnchor', '$vocabulary', '$comment',
    'prefixItems', 'contains', 'patternProperties', 'dependentSchemas',
    'propertyNames', 'if', 'then', 'else',
    'unevaluatedItems', 'unevaluatedProperties',
    'multipleOf', 'exclusiveMaximum', 'exclusiveMinimum',
    'maxContains', 'minContains',
    'deprecated', 'readOnly', 'writeOnly', 'examples',
    'format', 'contentEncoding', 'contentMediaType', 'contentSchema']

defn unsupported-json-schema-keyword?(key):
  key:S.in?(unsupported-json-schema-keywords())

defn native-pattern-properties?(schema):
  value =: schema.patternProperties
  and:
    map?(value)
    every?(map? value:vals)

defn native-pattern-properties-keyword?(schema key):
  and:
    key == 'patternProperties'
    native-pattern-properties?(schema)

defn passthrough-directive?(key):
  text =: key:S
  (text =~ /^\./) &&:
    (unsupported-json-schema-keyword?(passthrough-keyword(text)) ||
     passthrough-keyword(text).eq('required'))

defn passthrough-keyword(directive):
  directive:S.replace(/^\./)

defn load-json-schema(text report=true):
  schema =: ys::yaml/load(text)
  validate-json-schema-document: schema
  validate-json-schema-dialect: schema
  schema =: discard-generated-comment(schema)
  when report:
    warn-unsupported-json-schema: schema
  =>: schema

defn warn-unsupported-json-schema(value path=''):
  when map?(value):
    each entry value:
      key child =: entry
      key =: key:S
      child-path =: json-pointer-child(path key)
      native-format =: (key == 'format') && native-json-format?(value)
      native-range =: native-exclusive-range-keyword?(value key)
      native-pattern =: native-pattern-properties-keyword?(value key)
      unsupported =:
        and:
          unsupported-json-schema-keyword?: key
          not: native-format
          not: native-range
          not: native-pattern
      when unsupported:
        warn-unsupported-json-schema-keyword: key child-path
      warn-json-schema-children: key child child-path

defn warn-json-schema-children(key value path):
  cond:
    single-schema-json-keyword?(key):
      warn-unsupported-json-schema: value path
    sequence-schema-json-keyword?(key) && sequential?(value):
      ignored =:
        map-indexed(\(warn-unsupported-json-schema(_2 "$path/$_1")) value):vec
    mapping-schema-json-keyword?(key) && map?(value):
      each entry value:
        name child =: entry
        warn-unsupported-json-schema:
          child json-pointer-child(path name:S)

defn single-schema-json-keyword?(key):
  key.in?([
    'additionalProperties', 'unevaluatedProperties', 'propertyNames',
    'items', 'contains', 'unevaluatedItems', 'not',
    'if', 'then', 'else', 'contentSchema'])

defn sequence-schema-json-keyword?(key):
  key.in?(['allOf', 'anyOf', 'oneOf', 'prefixItems'])

defn mapping-schema-json-keyword?(key):
  key.in?(['properties', 'patternProperties', 'dependentSchemas',
           '$defs', 'definitions'])

defn warn-yamlschema-passthrough(value path='' root=true):
  when map?(value):
    each entry value:
      key child =: entry
      key =: key:S
      if passthrough-directive?(key):
        then:
          keyword =: passthrough-keyword(key)
          child-path =: json-pointer-child(path keyword)
          when unsupported-json-schema-keyword?(keyword):
            warn-unsupported-json-schema-keyword: keyword child-path
          warn-json-schema-children: keyword child child-path
        else:
          warn-yamlschema-child: key child path root

defn warn-yamlschema-child(key value path root):
  cond:
    key == '.keys':
      when sequential?(value):
        warn-yamlschema-key-rules: value path
    key.in?(['.one', '.any', '.all']) && sequential?(value):
      keyword =: +{'.one' 'oneOf', '.any' 'anyOf', '.all' 'allOf'}.$key
      child-path =: json-pointer-child(path keyword)
      ignored =:
        map-indexed(
          \(warn-yamlschema-passthrough(_2 "$child-path/$_1" false))
          value):vec
    key.in?(['.item', '.not']):
      keyword =: key.eq('.item').if('items' 'not')
      warn-yamlschema-passthrough:
        value json-pointer-child(path keyword) false
    key =~ /^\./: nil
    else:
      child-path =: yamlschema-schema-child-path(path key root)
      warn-yamlschema-passthrough: value child-path false

defn warn-yamlschema-key-rules(rules path):
  many =: count(rules) > 1
  ignored =:
    map-indexed(
      \(warn-yamlschema-key-rule(_2 _1 path many false)) rules):vec

defn warn-yamlschema-key-rule(rule index path many float?):
  rule-path =:
    if many:
      then: json-pointer-child(json-pointer-child(path 'allOf') index)
      else: path
  alternatives =: rule.get('.any' [])
  branch-path =: json-pointer-child(rule-path 'anyOf')
  ignored =:
    map-indexed(
      \(warn-yamlschema-key-branch(_2 _1 branch-path float?))
      alternatives):vec

defn warn-yamlschema-key-branch(branch index path float?):
  when map?(branch):
    properties-path =:
      json-pointer-child(json-pointer-child(path index) 'properties')
    each entry branch:
      key value =: entry
      name =: key:S.replace(/\?$/)
      child-path =: json-pointer-child(properties-path name)
      if float?:
        then: warn-yamlschema-float-export(value child-path false)
        else: warn-yamlschema-passthrough(value child-path false)

defn warn-yamlschema-float-export(value path='' root=true):
  when map?(value):
    reference =: value.get('.type')
    warn-float-reference: reference path
    each entry value:
      key child =: entry
      key =: key:S
      warn-yamlschema-float-child: key child path root

defn warn-yamlschema-float-child(key value path root):
  cond:
    key == '.keys':
      when sequential?(value):
        ignored =:
          map-indexed(
            \(warn-yamlschema-key-rule(
              _2 _1 path (count(value) > 1) true))
            value):vec
    key.in?(['.one', '.any', '.all']) && sequential?(value):
      keyword =: +{'.one' 'oneOf', '.any' 'anyOf', '.all' 'allOf'}.$key
      child-path =: json-pointer-child(path keyword)
      ignored =:
        map-indexed(
          \(warn-yamlschema-float-export(
            _2 json-pointer-child(child-path _1) false))
          value):vec
    key.in?(['.item', '.not']):
      keyword =: key.eq('.item').if('items' 'not')
      warn-yamlschema-float-export:
        value json-pointer-child(path keyword) false
    key =~ /^\./: nil
    else:
      child-path =: yamlschema-schema-child-path(path key root)
      warn-yamlschema-float-export: value child-path false

defn warn-float-reference(reference path):
  when string?(reference):
    cond:
      reference == '+Float': warn-float-json-schema(path)
      reference == '+Float[]':
        warn-float-json-schema: json-pointer-child(path 'items')

defn warn-float-json-schema(path):
  location =: path.empty?.if('/' path)
  prefix =: "ysd: warning: +Float at $location exports as JSON Schema "
  err: "$prefix\"number\", which also accepts integers\n"

defn yamlschema-schema-child-path(path key root):
  cond:
    key == WILDCARD-KEY:
      json-pointer-child: path 'additionalProperties'
    pattern-property-key?(key):
      pattern =: pattern-property-name(key)
      json-pointer-child:
        json-pointer-child(path 'patternProperties') pattern
    root && key.starts?('+'):
      name =: key.replace(/^\+/)
      =>: json-pointer-child(json-pointer-child(path '$defs') name)
    else:
      name =: key.replace(/\?$/)
      =>: json-pointer-child(json-pointer-child(path 'properties') name)

defn warn-unsupported-json-schema-keyword(keyword path):
  err: "ysd: warning: unsupported JSON Schema keyword \"$keyword\" at $path\n"

defn json-pointer-child(path key):
  token =: key:S.replace(/~/ '~0').replace(/\// '~1')
  =>: "$path/$token"

defn convert(schema strict=false):
  doc =: build-doc(schema strict)
  text =: ys::yaml/dump(doc)
  text =: format-ysd-tight-scalars(text)
  text =: format-ysd-document(text)
  post-process: text

defn validate-json-schema-dialect(schema):
  when+ schema.'$schema':
    dialect =: _
    when supported-json-schema-dialect?(dialect).!:
      usage: "unsupported JSON Schema dialect: $dialect"

defn validate-json-schema-document(schema):
  when-not map?(schema):
    usage: "expected JSON Schema object, got $(T(schema))"

defn supported-json-schema-dialect?(dialect):
  case dialect:
    'https://json-schema.org/draft/2020-12/schema': true
    'https://json-schema.org/draft/2019-09/schema': true
    'http://json-schema.org/draft-07/schema#': true
    'https://json-schema.org/draft-07/schema': true
    'http://json-schema.org/draft-06/schema#': true
    'https://json-schema.org/draft-06/schema': true
    'http://json-schema.org/draft-04/schema#': true
    'https://json-schema.org/draft-04/schema': true
    else: false

defn draft4-json-schema?(schema):
  schema.'$schema'.in?([
    'http://json-schema.org/draft-04/schema#'
    'https://json-schema.org/draft-04/schema'])

# Build the top-level data structure for the whole document.
defn build-doc(schema strict=false):
  schema =: canonicalize-single-required-oneof(schema)
  defs =: schema.'$defs' ||
          schema.definitions ||
          omap()
  root-open =: json-unconstrained-open?(schema)
  result =: omap()
    .add-document-ysid(schema)
    .add-root-annotations(schema)
    .add-root-pattern-properties-passthrough(schema)
    .add-import-open-default(root-open strict)
    .add-root-map-size(schema)
    .add-defs-and-body(schema defs root-open strict)
    .add-root-one(schema strict)
    .add-root-key-rules(schema root-open strict)
  validate-schema-names: result

defn add-document-ysid(result schema):
  modern =: schema.has?('$id')
  legacy =: draft4-json-schema?(schema) && schema.has?('id')
  if modern || legacy:
    then:
      value =: modern.if(schema.'$id' schema.id)
      id =: canonical-document-id(value 'ysd' 'JSON Schema $id')
      ordered-put: result '.ysid' id
    else: result

defn add-root-annotations(result schema):
  result =: add-schema-name-directive(result schema)
  result:
    .map-put-if(schema.title.? '.title' schema.title)
    .map-put-if(schema.description.? '.desc' schema.description)

defn add-root-pattern-properties-passthrough(result schema):
  preserve =:
    contains?(schema 'patternProperties') &&
    native-pattern-properties?(schema).!
  if preserve:
    then:
      ordered-put:
        result '.patternProperties' schema.patternProperties
    else: result

defn add-import-open-default(result root-open strict=false):
  if root-open && strict.!:
    then: ordered-put(result '.open' true)
    else: result

defn add-root-map-size(result schema):
  if object-with-fields?(schema):
    then:
      result.add-size-directive(
        schema.minProperties schema.maxProperties)
    else: result

defn add-explicit-empty-root(result schema defs):
  if defs:seq && empty-closed-object-root?(schema):
    then: ordered-put(result '.root' omap())
    else: result

defn empty-closed-object-root?(schema):
  and:
    json-type(schema).eq('object')
    json-closed?(schema)
    object-with-fields?(schema).!

defn add-defs-and-body(result schema defs inherited-open strict=false):
  if defs-follow-body?(schema):
    result:
      .add-explicit-empty-root(schema defs)
      .add-body(schema inherited-open strict)
      .add-defs(defs inherited-open strict)
    result:
      .add-defs(defs inherited-open strict)
      .add-explicit-empty-root(schema defs)
      .add-body(schema inherited-open strict)

defn defs-follow-body?(schema):
  defs-key =: schema.'$defs'.if('$defs' 'definitions')
  body-keys =: set(qw(properties patternProperties additionalProperties))
  keys =: schema:keys
  keys:
    .take-while(\(_ != defs-key))
    .some(\(body-keys.has?(_)))

defn add-defs(result defs inherited-open strict=false):
  reduce \(add-def-step(_1 _2 inherited-open strict)): result defs

defn add-def-step(result entry inherited-open strict=false):
  name sub =: entry
  when name:S == 'Str':
    usage: 'JSON Schema definition name Str conflicts with the +Str wildcard'
  ordered-put: result "+$name" build-value(sub inherited-open strict)

defn add-body(result schema inherited-open strict=false):
  validate-schema-dependent-required: schema
  if object-with-fields?(schema):
    then:
      result =: add-properties(result schema inherited-open strict)
      result =: add-pattern-properties(result schema inherited-open strict)
      add-root-wildcard-entry: result schema inherited-open strict
    else:
      if json-type(schema).eq('object') && typed-map-base(schema):
        then: add-root-wildcard-entry(result schema inherited-open strict)
        else: result

defn add-root-one(result schema strict=false):
  if schema.oneOf.?:
    then:
      branches =: schema.oneOf.map(\(build-value(_ true strict))):vec
      ordered-put: result '.one' branches
    else: result

defn add-root-wildcard-entry(result schema inherited-open strict=false):
  if json-typed-additional?(schema):
    then: add-wildcard-entry(result schema inherited-open strict)
    else: result

defn add-properties(result schema inherited-open strict=false):
  props =: schema.properties || omap()
  required =: set(schema.required)
  dependent =: validate-dependent-required(schema props)
  reduce:
    \(add-property(_1 _2 required dependent inherited-open strict))
    result
    props

defn validate-schema-dependent-required(schema):
  when contains?(schema 'dependentRequired'):
    validate-dependent-required: schema (schema.properties || {})

defn add-property(result entry required dependent inherited-open strict=false):
  name sub =: entry
  when name:S == WILDCARD-KEY:
    usage: 'JSON Schema property name +Str is reserved for the wildcard'
  when pattern-property-key?(name):
    usage:
      "JSON Schema property name $name conflicts with regex key syntax"
  is-req =: required.has?(name)
  key =: key-for(name is-req)
  array? =: json-type(sub).eq('array') && array-as-suffix?(sub)
  value =:
    if array?:
      build-list-value(sub inherited-open false strict)
      build-value(sub inherited-open strict)
  value =:
    if contains?(dependent name):
      then: add-property-need(value dependent.$name)
      else: value
  ordered-put: result key value

defn add-pattern-properties(result schema inherited-open strict=false):
  if native-pattern-properties?(schema):
    then:
      reduce:
        \(add-pattern-property(_1 _2 inherited-open strict))
        result schema.patternProperties
    else: result

defn add-pattern-property(result entry inherited-open strict=false):
  pattern sub =: entry
  key =: pattern-property-key(pattern)
  ordered-put: result key build-value(sub inherited-open strict)

defn validate-dependent-required(schema props):
  value =: schema.dependentRequired
  if value:nil?:
    then: omap()
    else:
      when-not map?(value):
        usage: 'JSON Schema dependentRequired must be an object'
      reduce \(validate-dependent-required-entry(_1 _2 props)):
        omap() value

defn validate-dependent-required-entry(result entry props):
  trigger required =: entry
  when-not string?(trigger):
    usage: 'JSON Schema dependentRequired triggers must be strings'
  when-not contains?(props trigger):
    usage: "dependentRequired trigger has no property declaration: $trigger"
  names =: validate-need-value(required)
  ordered-put: result trigger names

defn add-property-need(value names):
  if string?(value) && compact-need-names?(names):
    then: "$value :need($(names.join(',')))"
    else:
      block =:
        if map?(value):
          then: value
          else: +{'.type' value}
      ordered-directives: block + {'.need' names}

defn compact-need-names?(names):
  names.every?(\(_ =~ /^[A-Za-z_$][A-Za-z0-9_.$\/-]*$/))

defn add-root-key-rules(result schema inherited-open strict=false):
  alternatives =: root-key-anyof(schema)
  supported =:
    and:
      sequential?(alternatives)
      count(alternatives) >= 2
      alternatives.every?(root-key-branch-schema?)
  if supported:
    then:
      branches =: alternatives.map(
        \(build-root-key-branch(_ inherited-open strict))):vec
      rule =: +{'.any' branches}
      rules =: +[rule]
      ordered-put: result '.keys' rules
    else: result

defn root-key-anyof(schema):
  cond:
    schema.anyOf.?: schema.anyOf
    singleton-anyof-allof?(schema): schema.allOf.0.anyOf

defn root-key-branch-schema?(schema):
  when-not map?(schema):
    =>: false
  when-not map?(schema.properties):
    =>: false
  when empty?(schema.properties):
    =>: false
  allowed =: \{'properties' 'required'}
  when-not key-set(schema).every?(\(allowed.has?(_))):
    =>: false
  required =: schema.get('required' [])
  and:
    sequential?(required)
    required.every?(\(schema.properties.has?(_)))

defn build-root-key-branch(schema inherited-open strict=false):
  required =: set(schema.get('required' []))
  reduce:
    \(build-root-key-branch-entry(
      _1 _2 required inherited-open strict))
    omap()
    schema.properties

defn build-root-key-branch-entry(result entry required open strict=false):
  name sub =: entry
  key =: key-for(name required.has?(name))
  value =: build-value(sub open strict)
  ordered-put: result key value

defn build-list-value(schema inherited-open solo=false strict=false):
  item =: array-item-schema(schema)
  item-scalar =: empty?(item).if('+Any' succinct-scalar(item))
  suffix =: list-suffix(schema solo)
  value =:
    if item-scalar:
      then: append-list-suffix(item-scalar suffix)
      else:
        item-value =: build-value(item inherited-open strict)
        list-value =: list-directives(suffix)
        merged =:
          merge-directives: item-value list-value 'array item type'
        canonicalize-type-reference: merged
  if schema.description.?:
    add-list-description: value schema.description
    else: value

defn add-list-description(value description):
  if string?(value) && plain-description-safe?(description):
    annotated-scalar: value description
    else:
      value =:
        if string?(value):
          then: +{'.type' value}
          else: value
      ordered-directives: value + {'.desc' description}

defn append-list-suffix(type suffix):
  tokens =: tight-tokens(type)
  tokens =: assoc(tokens 0 "$(tokens.0)$suffix")
  joins: tokens

# Return the value side of a property (or def), either a scalar in
# succinct form, or a nested map (object with properties / expanded
# directive block).
defn build-value(schema inherited-open=true strict=false):
  schema =: canonicalize-single-required-oneof(schema)
  info =: importable-solo-list-info(schema)
  if info:
    build-solo-list-value: schema info inherited-open strict
    build-ordinary-value: schema inherited-open strict

defn build-ordinary-value(schema inherited-open=true strict=false):
  validate-schema-dependent-required: schema
  scalar-schema =: schema-without-description(schema)
  scalar =: succinct-default-scalar(scalar-schema)
  description-scalar =: scalar || succinct-array-scalar(scalar-schema)
  cond:
    description-scalar && succinct-description?(schema):
      annotated-scalar: description-scalar schema.description
    description-scalar && not(schema-annotations?(schema)):
      description-scalar
    object-with-fields?(schema):
      build-properties-map(schema inherited-open strict)
    else: build-block-map(schema inherited-open strict)

defn build-solo-list-value(schema info inherited-open strict=false):
  value =: build-list-value(info.array inherited-open true strict)
  add-solo-list-annotations: value schema

defn add-solo-list-annotations(value schema):
  block? =:
    schema.has?('$anchor') ||
    schema.has?('default') ||
    schema.has?('title')
  if block?:
    then:
      result =: string?(value).if({'.type' value} value)
      anchor =:
        when schema.has?('$anchor'):
          validate-schema-name: schema.'$anchor'
      result =: map-put-if(result anchor.? '.name' anchor)
      result =: map-put-if(result schema.has?('default')
        '.init' schema.default)
      result =: map-put-if(result schema.has?('title')
        '.title' schema.title)
      result =: map-put-if(result schema.has?('description')
        '.desc' schema.description)
      ordered-directives: result
    else:
      if schema.has?('description'):
        add-list-description: value schema.description
        identity: value

defn schema-without-description(schema):
  if schema.has?('description'):
    then:
      dissoc: schema 'description'
    else: schema

defn succinct-default-scalar(schema):
  if contains?(schema 'default'):
    then:
      marked =: schema.has?('enum').when(
        compact-enum-default-scalar(schema))
      if marked:
        then: marked
        else:
          scalar =: succinct-scalar(dissoc(schema 'default'))
          token =: tight-default-token(schema.'default')
          when scalar && token.?:
            =>: "$scalar =$token"
    else: succinct-scalar(schema)

defn tight-default-token(value):
  cond:
    string?(value): tight-string-default-token(value)
    boolean?(value): value:S
    number?(value): value:S
    nil?(value): 'null'

defn tight-string-default-token(value):
  cond:
    tight-plain-default?(value): value
    tight-string-body?(value): "\"$(encode-tight-string(value))\""

defn tight-plain-default?(value):
  (value =~ /^[A-Za-z0-9_][A-Za-z0-9_.\/-]*$/) &&
  (parse-yaml-scalar(value) == value)

defn succinct-description?(schema):
  schema.has?('description') &&
  schema.has?('title').! &&
  plain-description-safe?(schema.description)

defn plain-description-safe?(description):
  tight-string-body?: description

defn annotated-scalar(scalar description):
  body =: encode-tight-string(description)
  =>: "$scalar \"$body\""

defn succinct-array-scalar(schema):
  is-array =: json-type(schema).eq('array')
  item-schema =: array-item-schema(schema)
  marked =:
    when contains?(schema 'default') && sequential?(item-schema.enum):
      compact-enum-default-scalar:
        item-schema.put('default' schema.'default')
  when is-array && (marked || array-as-suffix?(schema)):
    item =: marked || succinct-scalar(item-schema)
    when item:
      append-list-suffix: item list-suffix(schema)

defn build-properties-map(schema inherited-open strict=false):
  child-open =: imported-child-open(schema inherited-open)
  base =: schema-base-ref(schema)
  result =: map-put-if(omap() base.? '.type' base)
  result =: add-schema-name-directive(result schema)
  result =: add-external-ref-directive(result schema)
  result =: add-open-override(result schema inherited-open strict)
  result =: map-put-if(result nullable-json-schema?(schema) '.null' true)
  result =: map-put-if(result schema.description.? '.desc' schema.description)
  result =:
    result.add-size-directive(
      schema.minProperties schema.maxProperties)
  result =: add-properties(result schema child-open strict)
  result =: add-pattern-properties(result schema child-open strict)
  result =: add-wildcard-entry(result schema inherited-open strict)
  result =: add-imported-combinators(result schema child-open strict)
  result =: add-passthrough-directives(result schema)
  ordered-directives: result

defn add-imported-combinators(result schema inherited-open strict=false):
  result =: result.add-combinator-directive(
    schema 'oneOf' '.one' inherited-open strict)
  result =: result.add-combinator-directive(
    schema 'anyOf' '.any' inherited-open strict)
  result =:
    if singleton-ref-allof?(schema):
      then: result
      else:
        result.add-combinator-directive(
          schema 'allOf' '.all' inherited-open strict)
  if schema.not.?:
    then:
      ordered-put:
        result '.not' build-value(schema.not inherited-open strict)
    else: result

defn build-block-map(schema inherited-open=true strict=false):
  add-block: omap() schema inherited-open strict

# Add the directive entries for an expanded schema-block (.type, .size,
# .enum, .init, etc.) into the result map. Also walks nested items /
# properties when present.
defn add-block(result schema inherited-open=true strict=false):
  t =: json-type(schema)
  ts =: native-json-format-type(schema)
  ts ||=: type-sym(t)
  has-type =: t.? && (t != 'array') && (t != 'object')
  is-array =: t.eq('array')
  pure-map =: t.eq('object') && object-with-fields?(schema).!
  map-base =: pure-map.when(open-map-base(schema))
  map-base =: map-base.eq('+Map{+Any}').if(nil map-base)
  child-open =: imported-child-open(schema inherited-open)
  result =: add-schema-name-directive(result schema)
  result =: add-open-override(result schema inherited-open strict)
  result =: map-put-if(result map-base '.type' map-base)
  result =:
    if contains?(schema '$ref'):
      then:
        reference =: local-ref-sym(schema.'$ref')
        if reference:
          then: ordered-put(result '.type' reference)
          else: result
      else: result
  result =: map-put-if(result has-type '.type' ts)
  result =: map-put-if(result is-array '.type' '+Any[]')
  result =: add-external-ref-directive(result schema)
  result =: map-put-if(result nullable-json-schema?(schema) '.null' true)
  result =:
    if schema.has?('pattern'):
      then: merge-ordered-maps(result pattern-directive(schema.pattern))
      else: result
  result =:
    if schema.enum.?:
      then:
        result =:
          if result.has?('.type'):
            then: result
            else: ordered-put(result '.type' json-infer-base(schema.enum))
        ordered-put: result '.enum' enum-block-list(schema.enum)
      else: result
  result =:
    if schema.const.?:
      then:
        result =:
          if result.has?('.type'):
            then: result
            else: ordered-put(result '.type' json-base-for-value(schema.const))
        ordered-put: result '.const' literal-value(schema.const)
      else: result
  result =: map-put-if(result schema.uniqueItems '.uniq' true)
  result =:
    if contains?(schema 'default'):
      then: ordered-put(result '.init' literal-value(schema.'default'))
      else: result
  result =: map-put-if(result schema.title.? '.title' schema.title)
  result =: map-put-if(result schema.description.? '.desc' schema.description)
  result =: result.add-combinator-directive(
    schema 'oneOf' '.one' child-open strict)
  result =: result.add-combinator-directive(
    schema 'anyOf' '.any' child-open strict)
  result =: result.add-combinator-directive(
    schema 'allOf' '.all' child-open strict)
  result =:
    if schema.not.?:
      then:
        ordered-put: result '.not' build-value(schema.not child-open strict)
      else: result
  result =: result
    .add-numeric-range-directive(schema)
    .add-exclusive-range-directives(schema)
    .add-size-directive(schema.minLength schema.maxLength)
    .add-size-directive(schema.minItems schema.maxItems)
    .add-size-directive(schema.minProperties schema.maxProperties)
    .add-array-items(is-array schema child-open strict)
  result =:
    if t == 'object':
      then:
        if object-with-fields?(schema):
          then:
            result =: result.add-properties(schema child-open strict)
            result =: result.add-pattern-properties(schema child-open strict)
            add-wildcard-entry: result schema inherited-open strict
          else:
            map-base.if(result
              add-wildcard-entry(result schema inherited-open strict))
      else: result
  add-passthrough-directives: result schema

defn add-size-directive(result lo hi):
  if lo.? || hi.?:
    then: ordered-put(result '.size' size-scalar(lo hi))
    else: result

defn add-numeric-range-directive(result schema):
  has-lo =: schema.has?('minimum')
  has-hi =: schema.has?('maximum')
  if has-lo || has-hi:
    then:
      ordered-put:
        result '.range' range-token(schema.minimum schema.maximum)
    else: result

defn add-exclusive-range-directives(result schema):
  result =: map-put-if(
    result native-exclusive-minimum?(schema) '.xmin' true)
  map-put-if: result native-exclusive-maximum?(schema) '.xmax' true

defn native-exclusive-minimum?(schema):
  schema.has?('minimum') && (schema.exclusiveMinimum == true)

defn native-exclusive-maximum?(schema):
  schema.has?('maximum') && (schema.exclusiveMaximum == true)

defn native-exclusive-range-keyword?(schema key):
  cond:
    key == 'exclusiveMinimum': native-exclusive-minimum?(schema)
    key == 'exclusiveMaximum': native-exclusive-maximum?(schema)
    else: false

defn add-array-items(result is-array schema inherited-open strict=false):
  if is-array && schema.items.?:
    then:
      items =: schema.items
      item-scalar =: succinct-scalar(items)
      if item-scalar:
        then: ordered-put(result '.type' "$item-scalar[]")
        else:
          ordered-put:
            result '.item' build-block-map(items inherited-open strict)
    else: result

defn additional-properties-value(schema inherited-open strict=false):
  value =: schema.get('additionalProperties')
  if value == true:
    then: '+Any'
    else: build-value(value inherited-open strict)

defn typed-map-base(schema):
  value-type =: map-value-type-ref(schema)
  value-type: .when("+Map{$value-type}")

defn open-map-base(schema):
  when contains?(schema 'additionalProperties'):
    typed-map-base: schema

defn imported-child-open(schema inherited-open):
  close =: json-closed?(schema) && inherited-open
  close: .if(false inherited-open)

defn add-open-override(result schema inherited-open strict=false):
  if json-closed?(schema) && inherited-open && strict.!:
    then: ordered-put(result '.open' false)
    else: result

defn json-object-schema?(schema):
  cond:
    map?(schema).!: false
    json-type(schema) == 'object': true
    map?(schema.properties): true
    map?(schema.patternProperties): true
    else: contains?(schema 'additionalProperties')

defn json-unconstrained-open?(schema):
  cond:
    json-object-schema?(schema).!: false
    contains?(schema 'additionalProperties').!: true
    else:
      value =: schema.get('additionalProperties')
      cond:
        value == true: true
        map?(value): empty?(value)
        else: false

defn json-closed?(schema):
  cond:
    json-object-schema?(schema).!: false
    contains?(schema 'additionalProperties').!: false
    else: schema.get('additionalProperties') == false

defn json-typed-additional?(schema):
  cond:
    json-object-schema?(schema).!: false
    contains?(schema 'additionalProperties').!: false
    json-closed?(schema): false
    else: json-unconstrained-open?(schema).!

defn map-value-type-ref(schema):
  when contains?(schema 'additionalProperties'):
    value =: schema.get('additionalProperties')
    cond:
      value == true: '+Any'
      map?(value):
        cond:
          empty?(value): '+Any'
          only-ref?(value): local-ref-sym(value.'$ref')
          native-json-format-only?(value):
            native-json-format-type: value
          type-only?(value):
            when value.type != 'array':
              type-sym: value.type

defn add-wildcard-entry(result schema inherited-open strict=false):
  typed =: json-typed-additional?(schema)
  local-open =: json-unconstrained-open?(schema)
  pure-open =: local-open && object-with-fields?(schema).!
  open-any =:
    strict.! && local-open && (inherited-open.! || pure-open)
  if typed || open-any:
    then:
      ordered-put:
        result
        WILDCARD-KEY
        typed.if(
          additional-properties-value(schema inherited-open strict)
          '+Any')
    else: result

defn add-combinator-directive(result schema key directive open strict=false):
  if schema.has?(key):
    then:
      values =:
        schema.$key.map(\(build-value(_ open strict)))
      ordered-put: result directive vec(values)
    else: result

# Preserve unsupported JSON Schema keywords verbatim as dotted directives.
# Also preserve required-only schemas because they have no property keys on
# which yamlschema can encode requiredness.
# Their values remain opaque JSON Schema data until a native yamlschema
# representation is implemented.
defn add-passthrough-directives(result schema):
  result =:
    if schema.required.? && empty?(schema.properties):
      then: result + {'.required' schema.required}
      else: result
  reduce \(add-passthrough-directive-entry(_1 _2 schema)): result schema

defn add-passthrough-directive-entry(result entry schema):
  key =: entry.0:S
  native-format =: (key == 'format') && native-json-format?(schema)
  native-range =: native-exclusive-range-keyword?(schema key)
  native-pattern =: native-pattern-properties-keyword?(schema key)
  unsupported =:
    and:
      unsupported-json-schema-keyword?: key
      not: native-format
      not: native-range
      not: native-pattern
  if unsupported:
    then: ordered-put(result ".$key" entry.1)
    else: result

# --------------------------------------------------------------------
# Succinct-form helpers (unchanged from the original by-hand emitter).
# --------------------------------------------------------------------

defn succinct-scalar(schema):
  nullable =: nullable-json-schema?(schema)
  schema =: nullable.if(without-null-type(schema) schema)
  scalar =: succinct-nonnull-scalar(schema)
  when scalar:
    nullable.if("$scalar~" scalar)

defn succinct-nonnull-scalar(schema):
  cond:
    map?(schema).!!: nil
    empty?(schema): '+Any'
    native-json-format-only?(schema): native-json-format-type(schema)
    typed-map-only?(schema): typed-map-base(schema)
    only-singleton-ref-allof?(schema):
      reference-scalar(schema.allOf.0.'$ref')
    base-allof-only?(schema): compact-base-allof-scalar(schema)
    combinator-only?(schema): compact-combinator-scalar(schema)
    type-union-only?(schema): compact-type-union-scalar(schema)
    schema.has?('$ref'):
      only-ref?(schema).when(reference-scalar(schema.'$ref'))
    schema.has?('const'):
      only-const?(schema).when(compact-const-scalar(schema.const))
    schema.has?('enum'):
      only-enum?(schema).when(compact-enum-scalar(schema))
    string-constraints-only?(schema):
      string-constraints-scalar(schema)
    numeric-range-only?(schema):
      range-scalar(schema)
    type-only?(schema):
      type-only-scalar(schema)

defn type-only-scalar(schema):
  when schema.type != 'object':
    type-sym: schema.type

defn key-set(schema):
  schema:keys:set

defn typed-map-only?(schema):
  allowed =: set(qw(type additionalProperties))
  object-type =: schema.type:nil? || schema.type.eq('object')
  base =: typed-map-base(schema)
  valid =:
    and:
      schema.has?('additionalProperties')
      key-set(schema).every?(\(allowed.has?(_)))
      base.?
      base.eq('+Map{+Any}').!
  result =: object-type && valid
  =>: result

defn only-ref?(schema):
  key-set(schema) ==: \{'$ref'}

defn singleton-ref-allof?(schema):
  branches =: schema.allOf
  and:
    sequential?(branches)
    count(branches).eq(1)
    only-ref?(branches.0)

defn singleton-anyof-allof?(schema):
  branches =: schema.allOf
  and:
    sequential?(branches)
    count(branches).eq(1)
    map?(branches.0)
    key-set(branches.0).eq(\{'anyOf'})

defn only-singleton-ref-allof?(schema):
  and:
    singleton-ref-allof?(schema)
    key-set(schema).eq(\{'allOf'})

defn schema-base-reference(schema):
  cond:
    contains?(schema '$ref'): schema.'$ref'
    singleton-ref-allof?(schema): schema.allOf.0.'$ref'

defn schema-base-ref(schema):
  when has-schema-base-reference?(schema):
    local-ref-sym: schema-base-reference(schema)

defn has-schema-base-reference?(schema):
  contains?(schema '$ref') || singleton-ref-allof?(schema)

defn schema-type-ref(schema):
  typed =:
    if type-only?(schema):
      then: schema.type != 'array'
      else: false
  cond:
    empty?(schema): '+Any'
    only-ref?(schema): local-ref-sym(schema.'$ref')
    native-json-format-only?(schema): native-json-format-type(schema)
    typed: type-sym(schema.type)

defn combinator-only?(schema):
  keys =: key-set(schema)
  and:
    keys.#.eq(1)
    keys:first.in?(qw(oneOf anyOf allOf not))

defn compact-combinator-scalar(schema):
  keyword =: key-set(schema):first
  info =: +{'oneOf' ['One' 2], 'anyOf' ['Any' 2],
            'allOf' ['All' 2], 'not' ['Not' 1]}.$keyword
  values =:
    if keyword == 'not':
      compact-not-values(schema.not)
      schema.$keyword
  refs =: values.when(vec(values.map(schema-type-ref)))
  when refs:
    when refs.# >= info.1:
      when refs.every?(some?):
        =>: "+$(info.0)($(refs.join(',')))"

defn type-union-only?(schema):
  types =: schema.type
  and:
    type-only?: schema
    sequential?: types
    types.# >=: 2

defn compact-type-union-scalar(schema):
  refs =: vec(schema.type.map(union-type-ref))
  when refs.every?(some?):
    =>: "+Any($(refs.join(',')))"

defn union-type-ref(type):
  case type:
    'string': '+Str'
    'integer': '+Int'
    'number': '+Num'
    'boolean': '+Bool'
    'null': '+Null'
    else: nil

defn compact-not-values(schema):
  if map?(schema) && key-set(schema).eq(\{'anyOf'}):
    get: schema 'anyOf'
    else: +[schema]

defn base-allof-only?(schema):
  keys =: key-set(schema)
  base-key =:
    cond:
      keys.has?('$ref'): '$ref'
      keys.has?('type'): 'type'
  when base-key:
    when keys.# == 2:
      has?: keys 'allOf'

defn compact-base-allof-scalar(schema):
  base-schema =:
    if schema.has?('$ref'):
      then: +{'$ref' schema.'$ref'}
      else: +{'type' schema.type}
  base =: schema-type-ref(base-schema)
  refs =: vec(schema.allOf.map(schema-type-ref))
  when base:
    when refs.# >= 1:
      when refs.every?(some?):
        parts =: +[base] + refs
        =>: parts:joins

defn only-const?(schema):
  key-set(schema) ==: \{'const'}

defn compact-const-scalar(value):
  token =: compact-const-token(value)
  when token:
    base =: json-base-for-value(value)
    =>: "$base ==$token"

defn compact-const-token(value):
  cond:
    string?(value):
      cond:
        tight-plain-default?(value): value
        tight-string-body?(value): "\"$(encode-tight-string(value))\""
    boolean?(value): value:S
    number?(value): value:S
    nil?(value): 'null'

defn only-enum?(schema):
  (key-set(schema) == \{'enum'}) ||
  (key-set(schema) == \{'enum' 'type'})

defn type-only?(schema):
  type-ks =: +['type']:set
  eq: key-set(schema) type-ks

defn numeric-range-only?(schema):
  ks =: key-set(schema)
  t =: schema.type
  allowed =:
    set(qw(type minimum maximum exclusiveMinimum exclusiveMaximum))
  has-any-bound =: ks.has?('minimum') || ks.has?('maximum')
  is-num =: t.eq('integer') || t.eq('number')
  all-allowed =: ks.every?(\(allowed.has?(_)))
  xmin-ok =:
    ks.has?('exclusiveMinimum').! || native-exclusive-minimum?(schema)
  xmax-ok =:
    ks.has?('exclusiveMaximum').! || native-exclusive-maximum?(schema)
  valid =: all-allowed && is-num && has-any-bound && xmin-ok && xmax-ok
  =>: valid

defn string-constraints-only?(schema):
  (nil?(schema.type) || schema.type.eq('string')) &&
  (schema.type.eq('string') || schema.has?('pattern')) &&
  (schema.has?('pattern') || schema.minLength.? || schema.maxLength.?) &&
  key-set(schema).every?(
    \(_.in?(qw(type pattern minLength maxLength))))

defn string-constraints-scalar(schema):
  has-pattern =: schema.has?('pattern')
  token =: has-pattern.when(tight-pattern-token(schema.pattern))
  if has-pattern:
    when token:
      finish-string-constraints: schema ['+Str' token]
    finish-string-constraints: schema ['+Str']

defn finish-string-constraints(schema parts):
  size =:
    when schema.minLength.? || schema.maxLength.?:
      size-scalar: schema.minLength schema.maxLength
  parts =: size.if(parts.conj(size) parts)
  joins: parts

defn tight-pattern-token(pattern):
  directive =: pattern-directive(pattern)
  if directive.has?('.match'):
    tight-match-token: directive.'.match'
    tight-find-token: directive.'.find'

defn tight-match-token(pattern):
  when tight-string-body?(pattern):
    body =: encode-tight-string(pattern)
    =>: "=~\"$body\""

defn tight-find-token(pattern):
  cond:
    pattern !~ /[\s\/]/: "/$pattern/"
    tight-string-body?(pattern):
      body =: encode-tight-string(pattern)
      =>: "find:\"$body\""

defn tight-string-body?(value):
  colon-escape =: str(':' C(92) ' ')
  hash-escape =: str(' ' C(92) '#')
  string?(value) &&:
    (value !~ /[\r\n\t"]/) &&
    colon-escape.in?(value).! &&
    hash-escape.in?(value).!

defn encode-tight-string(value):
  colon-space =: str(':' ' ')
  space-hash =: str(' ' '#')
  colon-escape =: str(':' C(92) ' ')
  hash-escape =: str(' ' C(92) '#')
  value:
    .replace(colon-space colon-escape)
    .replace(space-hash hash-escape)

defn decode-tight-string(value):
  colon-space =: str(':' ' ')
  space-hash =: str(' ' '#')
  colon-escape =: str(':' C(92) ' ')
  hash-escape =: str(' ' C(92) '#')
  value:
    .replace(colon-escape colon-space)
    .replace(hash-escape space-hash)

defn pattern-directive(pattern):
  if anchored-pattern?(pattern):
    then: +{'.match' strip-pattern-anchors(pattern)}
    else: +{'.find' pattern}

defn anchored-pattern?(pattern):
  pattern.starts?('^') && pattern.ends?('$')

defn strip-pattern-anchors(pattern):
  pattern.replace(/^\^/).replace(/\$$/)

defn size-scalar(lo hi):
  cond:
    lo == hi: lo:S
    lo:nil?: "0-$hi"
    hi:nil?: "$lo+"
    else: "$lo-$hi"

defn object-with-fields?(schema):
  map?(schema) &&
  (schema.has?('properties') || schema.has?('patternProperties'))

defn native-json-format?(schema):
  format =: schema.format
  t =: schema.type
  string-type =:
    cond:
      t == 'string': true
      sequential?(t): vec(remove(\(_ == 'null') t)).eq(['string'])
      else: false
  and:
    string-type
    string?(format)
    JSON-SCHEMA-FORMATS.has?(format)

defn native-json-format-only?(schema):
  allowed =: set(qw(type format))
  and:
    native-json-format?(schema)
    key-set(schema).every?(\(allowed.has?(_)))

defn native-json-format-type(schema):
  when native-json-format?(schema):
    =>: "+JSON-Schema/$(schema.format)"

defn schema-annotations?(schema):
  schema.has?('description') ||
  schema.has?('title') ||
  schema.has?('$anchor')

defn add-schema-name-directive(result schema):
  if contains?(schema '$anchor'):
    then:
      name =: validate-schema-name(schema.'$anchor' 'JSON Schema $anchor')
      ordered-put: result '.name' name
    else: result

# True when the whole array can be expressed by a value-side list suffix.
defn array-as-suffix?(schema):
  array-suffix-keys?: schema

defn array-suffix-keys?(schema):
  every? _ key-set(schema):
    \(_.in?(qw(type items minItems maxItems uniqueItems description)))

defn array-item-schema(schema):
  schema.items || {}

defn key-for(name is-required):
  opt =: is-required.if('' '?')
  str: name opt

defn list-suffix(sub solo=false):
  mn =: sub.minItems
  mx =: sub.maxItems
  size =:
    cond:
      mn:nil? && mx:nil?: ''
      mn == mx: "$mn"
      mn:nil? && mx.?: "0-$mx"
      mn.? && mx:nil?: "${mn}+"
      else: "$mn-$mx"
  flags =: solo.if('$' '') + sub.uniqueItems.if('!' '')
  body =: "$flags$size"
  =>: "[$body]"

defn json-type(schema):
  t =: schema.type
  if sequential?(t):
    first: remove(\(_ == 'null') t)
    else: t

defn nullable-json-schema?(schema):
  sequential?(schema.type) && 'null'.in?(schema.type)

defn without-null-type(schema):
  types =: vec(remove(\(_ == 'null') schema.type))
  type =: types.#.eq(1).if(types.0 types)
  schema: .assoc('type' type)

defn type-sym(t):
  if t.?:
    case t:
      'string': '+Str'
      'integer': '+Int'
      'number': '+Num'
      'boolean': '+Bool'
      'null': '+Null'
      'object': '+Map'
      'array': '+Any'
      else: '+Any'
    else: '+Any'

defn local-ref-sym(ref):
  reference =: validate-external-reference(ref)
  match =:
    re-matches:
      /^#\/(?:\$defs|definitions)\/([a-z_][A-Za-z0-9_-]*)$/
      reference
  when match:
    =>: "+$(match.1)"

defn reference-scalar(ref):
  reference =: validate-external-reference(ref)
  local =: local-ref-sym(reference)
  if local:
    then: local
    else:
      compact =: reference:seq && (reference !~ /[\s\)]/)
      when compact:
        =>: "+Ref($reference)"

defn add-external-ref-directive(result schema):
  if has-schema-base-reference?(schema):
    then:
      reference =:
        validate-external-reference(schema-base-reference(schema))
      if local-ref-sym(reference):
        then: result
        else: ordered-put(result '.xref' reference)
    else: result

defn range-scalar(schema):
  token =: range-token(schema.minimum schema.maximum)
  xmin =: native-exclusive-minimum?(schema)
  xmax =: native-exclusive-maximum?(schema)
  lower-only =: schema.has?('minimum') && schema.has?('maximum').!
  upper-only =: schema.has?('minimum').! && schema.has?('maximum')
  shorthand =: (xmin && lower-only) || (xmax && upper-only)
  token =:
    cond:
      xmin && lower-only: token.replace(/\.\.$/ '...')
      xmax && upper-only: token.replace(/^\.\./ '...')
      else: token
  parts =: +[type-sym(schema.type) token]
  parts =: (xmin && shorthand.!).if(parts.conj(':xmin') parts)
  parts =: (xmax && shorthand.!).if(parts.conj(':xmax') parts)
  joins: parts

defn range-token(lo hi):
  lo-s =: lo:nil?.if('' lo)
  hi-s =: hi:nil?.if('' hi)
  =>: "${lo-s}..${hi-s}"

# Return a 2-vector for the value of a `.size` directive. Unbounded
# sides become the literal string "*"; yaml/dump quotes it as needed.
defn size-pair(lo hi):
  cond:
    lo.? && hi.?: +[lo hi]
    lo.?: +[lo]
    hi.?: +[0 hi]
    else: +[0]

defn regex-literal(pattern):
  =>: "/$pattern/"

defn compact-enum-scalar(schema):
  values =: schema.enum
  when values.every?(safe-compact-enum-value?):
    base =: schema.type.if(type-sym(schema.type) json-infer-base(values))
    when base != '+Any':
      members =: values.map(\(_:S)):vec.join(', ')
      =>: "$base [$members]"

defn compact-enum-default-scalar(schema):
  bare =: dissoc(schema 'default')
  default =: schema.'default'
  valid =:
    only-enum?(bare) &&
    default.in?(schema.enum) &&
    schema.enum.every?(safe-compact-enum-value?)
  when valid:
    base =:
      schema.type.if(type-sym(schema.type) json-infer-base(schema.enum))
    when base != '+Any':
      members =:
        schema.enum
          .map(\(enum-default-member(_ default)))
          .vec()
          .join(', ')
      =>: "$base [$members]"

defn enum-default-member(value default):
  token =: value:S
  value: .eq(default).if("=$token" token)

defn safe-compact-enum-value?(value):
  text =: value:S
  text:seq &&:
    (text == text:trim) &&
    (text =~ /^[A-Za-z0-9._+\-\s]+$/)

defn enum-block-list(values):
  vec: values

defn literal-value(v): v

# --------------------------------------------------------------------
# Post-processing the dumped YAML.
# --------------------------------------------------------------------

# Wrap generated .ysd tight scalars and `.desc` pairs without changing their
# folded YAML values. When a complete tight-scalar line exceeds 80 columns,
# the enum and description clauses each start on their own continuation line.
defn format-ysd-tight-scalars(text):
  lines =: reduce(format-ysd-tight-line [] text:lines)
  join "\n": lines

defn format-ysd-document(text):
  lines =: insert-blank-before-defs(text:lines)
  join "\n": +['# Converted from JSON Schema'].into(lines)

defn insert-blank-before-defs(lines):
  =>: reduce(insert-before-def-step [] lines)

defn insert-before-def-step(result line):
  is-def =: (line =~ /^\+/) && (line !~ /^\+Str:/)
  needs-separator =:
    if result:empty?:
      then: true
      else: result:last != ''
  should-insert =: is-def && needs-separator
  result :if should-insert .=: conj('')
  result: .conj(line)

defn format-ysd-tight-line(result line):
  formatted =: wrapped-ysd-tight-line(line)
  result: .into(formatted)

defn wrapped-ysd-tight-line(line):
  pattern =: re-pattern(str('^(.*' ':' ' )(.*)$'))
  match =: re-matches(pattern line)
  desc-pattern =: re-pattern(str('^([ ]*)\.desc' ':' ' (.*)$'))
  desc =: re-matches(desc-pattern line)
  cond:
    line.# <= 80: +[line]
    desc && wrappable-ysd-desc?(desc.2):
      ysd-desc-pair-lines: desc.1 desc.2
    match.!: +[line]
    match.1 =~ /^\s*\./: +[line]
    else:
      clauses =: ysd-tight-line-clauses(match.2)
      if clauses:
        then: ysd-tight-clause-lines(match.1 clauses)
        else: +[line]

defn wrappable-ysd-desc?(value):
  plain =: value !~ /^["|>]/
  single =: value.starts?("'") && value.ends?("'")
  plain ||: single

defn ysd-desc-pair-lines(indent value):
  tokens =: split-wrappable-spaces(value isolated-space?)
  prefix =: "$indent.desc$(C(58)) "
  state =: +{
    'lines' [], 'line' prefix,
    'continuation' "$indent  ", 'has-token' false}
  state =: reduce(append-ysd-desc-token state tokens)
  state.lines: .conj(state.line)

defn append-ysd-desc-token(state token):
  separator =: state.has-token.if(' ' '')
  candidate =: "$(state.line)$separator$token"
  if (candidate.# <= 80) || state.has-token.!:
    then: state + {'line' candidate, 'has-token' true}
    else: state + {
      'lines' state.lines.conj(state.line),
      'line' "$(state.continuation)$token", 'has-token' true}

defn ysd-tight-line-clauses(value):
  tokens =: tight-tokens(value)
  description =:
    when tokens.# >= 2:
      last =: tokens:last
      =>: tight-quoted?(last).when(last)
  enum =: first(tokens.filter(compact-enum-token?))
  when enum || description:
    head =: tokens
    head =: enum.if(remove-first-token(head enum) head)
    head =: description.if(remove-first-token(head description) head)
    when head:seq:
      =>: +{'head' head.join(' '), 'enum' enum,
            'description' description}

defn ysd-tight-clause-lines(prefix clauses):
  indent =: "$(line-indent(prefix))  "
  lines =: +["$prefix$(clauses.head)"]
  lines :if clauses.enum .=:
    into(ysd-enum-clause-lines(indent clauses.enum))
  lines :if clauses.description .=:
    into(ysd-description-clause-lines(indent clauses.description))
  =>: lines

defn ysd-enum-clause-lines(indent clause):
  body =: clause.replace(/^\[/).replace(/\]$/)
  members =: body.split(',').map(trim):vec
  count =: members.#
  tokens =:
    map-indexed(\(ysd-enum-member-token(_1 _2 count)) members):vec
  wrap-ysd-clause-tokens: indent '[' tokens

defn ysd-enum-member-token(index member count):
  if index == (count - 1):
    then: "$member]"
    else: "$member,"

defn ysd-description-clause-lines(indent clause):
  body =: clause.replace(/^./).replace(/.$/)
  words =:
    if body:empty?:
      then: +['']
      else: split-wrappable-spaces(body description-break?)
  count =: words.#
  tokens =:
    map-indexed(\(ysd-description-word-token(_1 _2 count)) words):vec
  wrap-ysd-clause-tokens: indent '"' tokens

defn split-wrappable-spaces(value break?):
  loop index 0, tokens [], token '':
    if index == value.#:
      then: tokens.conj(token)
      else:
        char =: value.$index
        if break?(value index):
          then: recur(index.++ tokens.conj(token) '')
          else: recur(index.++ tokens "$token$char")

defn isolated-space?(value index):
  space =: C(32)
  current-space =: value.$index == space
  previous-space =:
    (index > 0) && (value.nth(index.--) == space)
  next-space =:
    (index.++ < value.#) && (value.nth(index.++) == space)
  current-space &&: previous-space.! && next-space.!

defn description-break?(value index):
  colon =: C(58)
  slash =: C(92)
  hash =: C(35)
  escaped-colon =:
    (index >= 2) &&
      (value.nth(index - 2) == colon) &&
      (value.nth(index.--) == slash)
  escaped-hash =:
    ((index + 2) < value.#) &&
      (value.nth(index.++) == slash) &&
      (value.nth(index + 2) == hash)
  isolated-space?(value index) &&: escaped-colon.! && escaped-hash.!

defn ysd-description-word-token(index word count):
  if index == (count - 1):
    then: "$word\""
    else: word

defn wrap-ysd-clause-tokens(indent opening tokens):
  state =: +{'lines' [], 'line' "$indent$opening",
            'indent' indent, 'has-token' false}
  state =: reduce(append-ysd-clause-token state tokens)
  state.lines: .conj(state.line)

defn append-ysd-clause-token(state token):
  separator =: state.has-token.if(' ' '')
  candidate =: "$(state.line)$separator$token"
  if (candidate.# <= 80) || state.has-token.!:
    then: state + {'line' candidate, 'has-token' true}
    else: state + {'lines' state.lines.conj(state.line),
      'line' "$(state.indent)$token", 'has-token' true}

defn post-process(text format-flow=false):
  lines =: text:lines
  lines =: format-flow-sequences(lines true)
  lines =: format-flow.if(format-flow-sequences(lines) lines)
  lines =: insert-blank-after-defs(lines)
  join "\n": lines

# Rewrite selected block-style scalar directives as compact flow sequences.
# Buffer one candidate at a time so nested collection and multiline scalar
# members can be left exactly as yaml/dump emitted them.
defn format-flow-sequences(lines need-only=false):
  state =: reduce(\(format-flow-line(_1 _2 need-only))
                   initial-flow-format-state() lines)
  =>: finish-flow-candidate(state).result

defn initial-flow-format-state()::
  result: []
  indent:
  directive:
  items: []
  original: []

defn format-flow-line(state line need-only):
  if state.original:seq:
    then: continue-flow-candidate(state line need-only)
    else: start-flow-candidate(state line need-only)

defn start-flow-candidate(state line need-only):
  trimmed =: line:trim
  directive =: trimmed.ends?(':').if(trimmed:chop nil)
  match =: directive &&
    directive.in?(['.enum' '.need' '.range' '.size'])
  match =: (match && need-only && (directive != '.need')).if(nil match)
  if match:
    then: state + {
      'indent' line-indent(line), 'directive' directive,
      'items' [], 'original' [line]}
    else: state + {'result' state.result.conj(line)}

defn continue-flow-candidate(state line need-only):
  prefix =: "$(state.indent)- "
  indented-prefix =: "$(state.indent)  - "
  item-prefix =:
    if line.starts?(prefix):
      then: prefix
      else: line.starts?(indented-prefix).if(indented-prefix nil)
  if item-prefix:
    then: state + {
      'items' state.items.conj(join(drop(item-prefix.# line))),
      'original' state.original.conj(line)}
    else:
      if line-indent(line).# > state.indent.#:
        then:
          start-flow-candidate(flush-flow-original(state) line need-only)
        else:
          start-flow-candidate(finish-flow-candidate(state) line need-only)

defn line-indent(line):
  trimmed =: line:trim
  join: take(index(line trimmed) line)

defn flush-flow-original(state):
  reset-flow-candidate:
    state + {'result' state.result.into(state.original)}

defn finish-flow-candidate(state):
  cond:
    state.original:empty?: state
    inline-scalar-sequence?(state.items):
      reset-flow-candidate:
        state + {'result'
          state.result.into(flow-sequence-lines(
            state.indent state.directive
            state.items.map(flow-sequence-item)))}
    else: flush-flow-original(state)

defn reset-flow-candidate(state):
  =>: state + {
    'indent' nil, 'directive' nil, 'items' [], 'original' []}

defn inline-scalar-sequence?(items):
  =>: items:seq && items.every?(inline-yaml-scalar?)

defn inline-yaml-scalar?(text):
  quoted =: text.starts?("'") || text.starts?('"')
  if quoted:
    then: true
    else:
      structured =:
        text.starts?('[') || text.starts?('{') ||
        text.starts?('- ') || text.starts?('? ') ||
        text.starts?('|') || text.starts?('>') ||
        some?(index(text ':\ '))
      falsey?: structured

# A block-style plain scalar may contain flow collection punctuation. Quote
# those strings before moving them between `[` and `]`.
defn flow-sequence-item(text):
  unsafe =: text =~ /[\[\]\{\},:#]/
  quoted =: text.starts?("'") || text.starts?('"')
  if unsafe && quoted.!:
    then: single-quoted-yaml(text)
    else: text

defn single-quoted-yaml(value):
  escaped =: value.replace(/'/ "''")
  =>: "'$escaped'"

defn flow-sequence-lines(indent directive items):
  prefix =: "$indent$directive: ["
  continuation =: "$indent  "
  count =: items.#
  tokens =:
    map-indexed(\(flow-sequence-token(_1 _2 count)) items):vec
  state =: +{'lines' [], 'line' prefix,
    'continuation' continuation, 'has-item' false}
  state =: reduce(append-flow-sequence-token state tokens)
  state.lines: .conj(state.line)

defn flow-sequence-token(index item count):
  if index == (count - 1):
    then: "$item]"
    else: "$item,"

defn append-flow-sequence-token(state token):
  separator =: state.has-item.if(' ' '')
  candidate =: "$(state.line)$separator$token"
  if (candidate.# <= 80) || state.has-item.!:
    then: state + {'line' candidate, 'has-item' true}
    else: state + {'lines' state.lines.conj(state.line),
      'line' "$(state.continuation)$token", 'has-item' true}

# Insert one blank line between the trailing `+...` $defs entries and
# the first body entry, if any $defs were emitted.
defn insert-blank-after-defs(lines):
  first: reduce(insert-blank-step initial-insert-state() lines)

defn initial-insert-state()::
- []
- false
- false

defn insert-blank-step(state line):
  result saw-plus inserted =: state
  saw-plus ||=: line =~ /^\+/
  is-body =: line =~ /^[A-Za-z]/
  should-insert =: saw-plus && not(inserted) && is-body
  result :if should-insert .=: conj('')
  result =: result.conj(line)
  inserted =: inserted || should-insert
  vector: result saw-plus inserted
