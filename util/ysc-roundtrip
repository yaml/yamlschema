#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: util/ysc-roundtrip SCHEMA.json" >&2
  exit 2
fi

input=$1
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

before=$tmpdir/before.json
after=$tmpdir/after.json
ysd_yaml=$tmpdir/out.ysd.yaml
schema_json=$tmpdir/out.schema.json
canon='
  def normalize:
    if type == "object" then
      (
        with_entries(.value |= normalize)
        | if has("definitions") then
            . + {"$defs": ((."$defs" // {}) + .definitions)}
            | del(.definitions)
          else
            .
          end
        | if has("$ref") and (."$ref" | type == "string") then
            . + {"$ref": (."$ref" | sub("^#/definitions/"; "#/$defs/"))}
          else
            .
          end
      )
    elif type == "array" then
      map(normalize)
    else
      .
    end;
  def ordered:
    if type == "object" then
      (
        (if has("$id") then {"$id": (."$id" | ordered)} else {} end) +
        (if has("$schema") then {"$schema": (."$schema" | ordered)} else {} end) +
        (to_entries
          | map(select(.key != "$id" and .key != "$schema"))
          | sort_by(.key)
          | map({key: .key, value: (.value | ordered)})
          | from_entries)
      )
    elif type == "array" then
      map(ordered)
    else
      .
    end;
  normalize | ordered
'

jq "$canon" "$input" > "$before"

bin/ysc "$input" -t ysd.yaml > "$ysd_yaml"
bin/ysc "$ysd_yaml" -t schema.json > "$schema_json"
jq "$canon" "$schema_json" > "$after"

if cmp -s "$before" "$after"; then
  echo OK
else
  diff -u --label before --label after "$before" "$after"
fi
